{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node *)",
      "Bash(npx vitest *)",
      "Bash(npx astro *)"
    ],
    "deny": [
      "Bash(wrangler *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-dev-server.sh"
          }
        ]
      }
    ]
  }
}
