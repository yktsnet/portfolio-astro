{
        "$schema": "node_modules/wrangler/config-schema.json",
        "name": "ykts-astro",
        "main": "@astrojs/cloudflare/entrypoints/server",
        "compatibility_date": "2026-02-22",
        "compatibility_flags": [
                "nodejs_compat"
        ],
        "routes": [
                {
                        "pattern": "ykts.net",
                        "custom_domain": true
                }
        ],
        "assets": {
                "directory": "dist",
                "binding": "ASSETS"
        },
        "observability": {
                "enabled": true
        },
        "kv_namespaces": [
                {
                        "binding": "SESSION",
                        "id": "a1fd815828144dcea2f420e960be567b",
                        "remote": true
                }
        ]
}
