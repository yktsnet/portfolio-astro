---
import { getLucideIcon } from '../lib/lucide';

interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-4 w-4' } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={getLucideIcon(name)}
/>
