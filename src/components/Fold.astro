---
// スマホでは見出しだけ出して本文を畳む組。開くのは囲む [data-fold-group] の FoldToggle で、
// 項目ごとには開かせない（global.css の [data-fold-group]）。md 以上では開いたままにする
interface Props {
  as?: 'h3' | 'p';
  class?: string;
  // 見出しがスマホで中身を示すためだけのもので、md 以上では要らないとき
  mobileHeadOnly?: boolean;
}
const { as: Tag = 'h3', class: className, mobileHeadOnly = false } = Astro.props;
---
<div class={className}>
  {Astro.slots.has('head') && <Tag class:list={['block w-full text-left', mobileHeadOnly && 'md:hidden']}><slot name="head" /></Tag>}
  <div class="fold-body"><slot /></div>
</div>
