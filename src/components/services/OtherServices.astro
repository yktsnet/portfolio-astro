---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import type { Service } from '../../data/services';
import type { MultilingualText } from '../../lib/i18n';

type ExtraLink = {
  href: string;
  kicker: string;
  title: MultilingualText;
};

interface Props {
  others: Service[];
  extra?: ExtraLink;
}
const { others, extra } = Astro.props;
const other = others[0];
---
<nav
  aria-label="Service navigation"
  class="mt-20 flex flex-wrap items-center gap-x-8 gap-y-4 border-t border-zinc-200 pt-10 sm:mt-24 sm:justify-end sm:pt-12 dark:border-poi-border/60"
>
  {extra && (
    <a
      href={extra.href}
      class="group inline-flex items-center gap-2 font-mono type-caption text-zinc-700 transition-colors duration-200 hover:text-poi-accent dark:text-poi-text dark:hover:text-poi-accent"
    >
      <span class="text-poi-accent">{extra.kicker}</span>
      <span class="text-poi-muted">—</span>
      <span class="font-sans type-body font-medium text-zinc-900 transition-colors duration-200 group-hover:text-poi-accent dark:text-poi-focus dark:group-hover:text-poi-accent">
        <T text={extra.title} />
      </span>
      <LucideIcon name="arrow-right" class="h-3.5 w-3.5 text-poi-accent transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
  )}
  {other && (
    <a
      href={`/services/${other.slug}/`}
      class="group inline-flex items-center gap-2 font-mono type-caption text-zinc-700 transition-colors duration-200 hover:text-poi-accent dark:text-poi-text dark:hover:text-poi-accent"
    >
      <span class="text-poi-accent">{other.no}</span>
      <span class="text-poi-muted">—</span>
      <span class="font-sans type-body font-medium text-zinc-900 transition-colors duration-200 group-hover:text-poi-accent dark:text-poi-focus dark:group-hover:text-poi-accent">
        <T text={other.title} />
      </span>
      <LucideIcon name="arrow-right" class="h-3.5 w-3.5 text-poi-accent transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
  )}
</nav>
