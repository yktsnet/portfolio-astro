---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import SectionHead from './SectionHead.astro';
import type { Service } from '../../data/services';

interface Props {
  others: Service[];
}
const { others } = Astro.props;
---
<section class="mt-20 border-t border-zinc-200 pt-12 sm:mt-24 sm:pt-14 dark:border-poi-border/60">
  <SectionHead size="heading" kicker="Other services" title={{ ja: 'ほかのサービス', en: 'Other services' }} />
  <div class="mt-5 grid gap-4 sm:mt-6 md:grid-cols-2">
    {others.map((o: Service) => (
      <a href={`/services/${o.slug}/`} class="group flex flex-col justify-between ui-card p-6 transition-colors hover:border-poi-accent/50 dark:hover:border-poi-accent/50">
        <div>
          <p class="flex items-center gap-2 font-mono type-label text-poi-accent">
            <LucideIcon name={o.icon} class="h-3.5 w-3.5" />
            <span>{o.no}</span>
            <span class="tracking-widest text-poi-muted">{o.kicker}</span>
          </p>
          <p class="mt-2 type-subheading font-semibold text-zinc-900 transition-colors group-hover:text-poi-accent dark:text-poi-focus">
            <T text={o.title} />
          </p>
          <p class="mt-2 type-caption leading-6 text-zinc-600 dark:text-poi-muted">
            <T text={o.summary} />
          </p>
        </div>
        <span class="mt-5 inline-flex items-center gap-1.5 font-mono type-caption text-poi-accent">
          <span class="lang-ja">詳しく見る</span><span class="lang-en">Learn more</span>
          <LucideIcon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
        </span>
      </a>
    ))}
  </div>
</section>
