---
import T from '../T.astro';
import type { Step } from '../../types';


interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---
<ol class="mt-6 grid gap-8 md:grid-cols-3">
  {steps.map((st) => (
    <li class="border-t-2 border-poi-accent/60 pt-5">
      <p class="font-mono type-caption text-poi-accent">{st.no}</p>
      <h3 class="mt-2 type-subheading font-semibold text-zinc-900 dark:text-poi-focus"><T text={st.title} /></h3>
      <p class="mt-2 type-small leading-7 text-zinc-600 dark:text-poi-muted"><T text={st.done} /></p>
    </li>
  ))}
</ol>
