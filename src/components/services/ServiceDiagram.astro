---
import DiagramOperations from './DiagramOperations.astro';
import DiagramAiDevelopment from './DiagramAiDevelopment.astro';
import DiagramEducation from './DiagramEducation.astro';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
---
{slug === 'operations' && <DiagramOperations />}
{slug === 'ai-development' && <DiagramAiDevelopment />}
{slug === 'education' && <DiagramEducation />}
