---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import SectionHead from './SectionHead.astro';
import type { Fit } from '../../types';

interface Props {
  fits: Fit[];
  misfits: Fit[];
}
const { fits, misfits } = Astro.props;
---
<section id="fit" class="mt-20 scroll-mt-32 sm:mt-24">
  <SectionHead size="heading" kicker="Fit" title={{ ja: '合う現場・合わない現場', en: 'Where it fits' }} />
  {/* 読むだけの一覧なので箱に入れず、上の線の色で合う・合わないを分ける */}
  <div class="mt-5 grid gap-10 sm:mt-6 md:grid-cols-2 md:gap-8">
    <div class="border-t-2 border-poi-accent/60 pt-5">
      <p class="type-body font-semibold text-poi-accent"><T text={{ ja: '合う現場', en: 'Fits' }} /></p>
      <ul class="mt-3 space-y-2.5">
        {fits.map((f) => (
          <li class="flex gap-2.5 type-small leading-6 text-zinc-700 dark:text-poi-text">
            <LucideIcon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-poi-accent" />
            <span>
              <T text={f.text} />
              {f.reason && <span class="text-zinc-500 dark:text-poi-muted">（<T text={f.reason} />）</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="border-t-2 border-zinc-300 pt-5 dark:border-poi-border">
      <p class="type-body font-semibold text-zinc-500 dark:text-poi-muted"><T text={{ ja: '合わない現場', en: 'Does not fit' }} /></p>
      <ul class="mt-3 space-y-2.5">
        {misfits.map((m) => (
          <li class="flex gap-2.5 type-small leading-6 text-zinc-700 dark:text-poi-muted">
            <LucideIcon name="x" class="mt-1 h-3.5 w-3.5 shrink-0 text-zinc-400 dark:text-poi-muted" />
            <span>
              <T text={m.text} />
              {m.reason && <span class="text-zinc-500 dark:text-poi-muted">（<T text={m.reason} />）</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
