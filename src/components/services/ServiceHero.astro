---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
const hasDiagram = Astro.slots.has('diagram');
---
<section id="overview" class="scroll-mt-32">
  <a href="/#services" class="inline-flex items-center gap-1.5 font-mono type-caption text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-poi-muted dark:hover:text-poi-focus">
    <span aria-hidden="true">←</span> Services
  </a>
  {/* 図を渡されたページでは、説明の横に置いて概念を先に見せる */}
  <div class:list={['mt-8 sm:mt-10', hasDiagram && 'md:grid md:grid-cols-2 md:items-center md:gap-12']}>
    <div>
      <p class="flex items-center gap-2 font-mono type-caption tracking-widest text-poi-accent">
        <LucideIcon name={s.icon} />
        <span>{s.no}</span>
        <span class="text-zinc-500 dark:text-poi-muted">— {s.kicker}</span>
      </p>
      <h1 class="mt-3 max-w-3xl type-display font-semibold leading-normal tracking-tight text-zinc-900 dark:text-poi-focus">
        <T text={s.title} />
      </h1>
      <p class="mt-4 max-w-2xl type-lead leading-7 text-zinc-600 sm:leading-8 dark:text-poi-muted">
        <T text={s.summary} />
      </p>
    </div>
    {hasDiagram && (
      <div class="mt-8 flex justify-center rounded-xl border ui-subpanel p-5 sm:p-6 md:mt-0">
        <div class="w-full max-w-md"><slot name="diagram" /></div>
      </div>
    )}
  </div>
</section>
