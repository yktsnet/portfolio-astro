---
import DgText from './DgText.astro';
---
<svg class="dg h-auto w-full" viewBox="0 0 440 310" role="img" aria-label="キットを配り、成果物が揃い、評価し、研修で育てる循環を、共通の評価基準がつなぐ図">
  <defs>
    <marker id="dg-ai-mk" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="dg-mk" d="M0 1L9 5L0 9z" /></marker>
  </defs>

  {/* 中央から4方向への接続線（破線、背面に配置） */}
  <line class="dg-dash" x1="220" y1="74" x2="220" y2="108" />
  <line class="dg-dash" x1="220" y1="202" x2="220" y2="236" />
  <line class="dg-dash" x1="152" y1="155" x2="170" y2="155" />
  <line class="dg-dash" x1="270" y1="155" x2="288" y2="155" />

  {/* 外周の循環矢印（背面に点線を敷かず、実線アークのみを4本配置） */}
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M292 58 A 112 112 0 0 1 350 124" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M350 186 A 112 112 0 0 1 292 252" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M148 252 A 112 112 0 0 1 90 186" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M90 124 A 112 112 0 0 1 148 58" />

  {/* 4つのステップ（ニュートラル） */}
  <rect class="dg-box" x="152" y="28" width="136" height="46" rx="23" />
  <DgText x={220} y={56} ja="キットを配る" en="Distribute kit" />

  <rect class="dg-box" x="288" y="132" width="136" height="46" rx="23" />
  <DgText x={356} y={160} ja="成果物が揃う" en="Uniform output" />

  <rect class="dg-box" x="152" y="236" width="136" height="46" rx="23" />
  <DgText x={220} y={264} ja="評価する" en="Evaluate" />

  <rect class="dg-box" x="16" y="132" width="136" height="46" rx="23" />
  <DgText x={84} y={160} ja="研修で育てる" en="Train" />

  {/* 中央: 共通の評価基準（ここだけアクセント色） */}
  <circle class="dg-accbox" cx="220" cy="155" r="48" />
  <DgText x={220} y={150} ja="共通の" en="Shared" class="dg-acctext" />
  <DgText x={220} y={170} ja="評価基準" en="criteria" class="dg-acctext" />
</svg>
