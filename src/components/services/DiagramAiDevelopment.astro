---
import DgText from './DgText.astro';
---
{/* 言いたいのは「開発キットでそろった成果物を評価が読み、評価で決まった軸に合わせてキットから配る」循環。研修はこの外にあるので入れない */}
<svg class="dg h-auto w-full" viewBox="0 0 440 334" role="img" aria-label="開発キットを配ると成果物と利用状況がそろい、それを評価が読み、評価で次に伸ばす軸が決まり、その軸に合わせて開発キットから配る循環の図">
  <defs>
    <marker id="dg-ai-mk" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="dg-mk" d="M0 1L9 5L0 9z" /></marker>
  </defs>

  {/* 外周の循環矢印 */}
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M299 59 A 100 100 0 0 1 359 122" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M359 216 A 100 100 0 0 1 299 273" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M141 273 A 100 100 0 0 1 81 203" />
  <path class="dg-line" marker-end="url(#dg-ai-mk)" d="M81 129 A 100 100 0 0 1 141 59" />

  {/* 上: 開発キット（標準化） */}
  <DgText x={220} y={18} ja="標準化" en="Standardize" class="dg-small" />
  <rect class="dg-box" x="145" y="26" width="150" height="66" rx="8" />
  <g class="dg-line" transform="translate(209, 33) scale(0.9)">
    <path d="m7.5 4.27 9 5.15" /><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5" /><path d="M12 22V12" />
  </g>
  <DgText x={220} y={78} ja="開発キット" en="Dev kit" />

  {/* 右: キットを回すと出てくるもの */}
  <rect class="dg-box" x="284" y="126" width="150" height="86" rx="8" />
  <g class="dg-line" transform="translate(348, 134) scale(0.9)">
    <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" />
  </g>
  <DgText x={359} y={178} ja="そろった成果物" en="Aligned output" />
  <DgText x={359} y={198} ja="と利用状況" en="and usage" class="dg-small" />

  {/* 下: 評価（可視化。ここだけアクセント色） */}
  <rect class="dg-accbox" x="145" y="240" width="150" height="66" rx="8" />
  <g class="dg-acc" transform="translate(209, 247) scale(0.9)">
    <path d="m16 11 2 2 4-4" /><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />
  </g>
  <DgText x={220} y={292} ja="評価" en="Evaluation" class="dg-acctext" />
  <DgText x={220} y={326} ja="可視化" en="Make visible" class="dg-small" />

  {/* 左: 評価で決まり、次にキットから配るものを選ぶ */}
  <rect class="dg-box" x="6" y="133" width="150" height="66" rx="8" />
  <g class="dg-line" transform="translate(70, 140) scale(0.9)">
    <circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />
  </g>
  <DgText x={81} y={185} ja="次に伸ばす軸" en="Next axis" />
</svg>
