---
import T from '../T.astro';
import type { MultilingualText } from '../../lib/i18n';

interface Props {
  kicker: string;
  title: MultilingualText;
  lead?: MultilingualText;
  size?: 'display' | 'heading';
}
const { kicker, title, lead, size = 'display' } = Astro.props;
---
<div class="max-w-3xl">
  <p class="font-mono type-caption tracking-widest uppercase text-poi-muted">{kicker}</p>
  <h2 class:list={[
    "mt-2 font-semibold leading-relaxed tracking-tight text-zinc-900 dark:text-poi-focus sm:whitespace-pre-line",
    size === 'heading' ? 'type-heading' : 'type-display',
  ]}>
    <T text={title} />
  </h2>
  {lead && (
    <p class:list={[
      "max-w-2xl leading-7 text-zinc-600 dark:text-poi-muted",
      size === 'heading' ? 'mt-3 type-body' : 'mt-5 type-lead sm:leading-8',
    ]}>
      <T text={lead} />
    </p>
  )}
</div>
