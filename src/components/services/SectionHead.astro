---
import T from '../T.astro';
import type { MultilingualText } from '../../lib/i18n';

interface Props {
  kicker: string;
  title: MultilingualText;
  lead?: MultilingualText;
}
const { kicker, title, lead } = Astro.props;
---
<div class="max-w-3xl">
  <p class="font-mono text-xs tracking-widest uppercase text-poi-muted">{kicker}</p>
  <h2 class="mt-2 text-xl sm:text-2xl font-semibold leading-relaxed tracking-tight text-zinc-900 dark:text-poi-focus sm:whitespace-pre-line">
    <T text={title} />
  </h2>
  {lead && (
    <p class="mt-5 max-w-2xl text-sm leading-7 text-zinc-600 dark:text-poi-muted">
      <T text={lead} />
    </p>
  )}
</div>
