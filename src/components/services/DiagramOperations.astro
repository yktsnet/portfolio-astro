---
import DgText from './DgText.astro';
---
<svg class="dg h-auto w-full" viewBox="0 0 440 300" role="img" aria-label="現場が触るExcel・紙・ICカードの入力から、後付けの自動化がPDF・検索・集計へつなぐ図">
  <defs>
    <marker id="dg-op-mk" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="dg-mk" d="M0 1L9 5L0 9z" /></marker>
  </defs>
  <DgText x={68} y={24} ja="現場が触るもの" en="On the floor" class="dg-small" />
  <DgText x={372} y={24} ja="自動で出るもの" en="Produced" class="dg-small" />

  {/* 左列: 現場が触るもの（ニュートラル） */}
  <rect class="dg-box" x="20" y="42" width="96" height="54" rx="6" />
  <g class="dg-line" transform="translate(59, 51) scale(0.75)">
    <rect width="18" height="18" x="3" y="3" rx="2" /><path d="M12 3v18" /><path d="M3 9h18" /><path d="M3 15h18" />
  </g>
  <DgText x={68} y={86} ja="Excel帳票" en="Excel" class="dg-small" />

  <rect class="dg-box" x="20" y="124" width="96" height="54" rx="6" />
  <g class="dg-line" transform="translate(59, 133) scale(0.75)">
    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M16 13H8" /><path d="M16 17H8" />
  </g>
  <DgText x={68} y={168} ja="紙の書類" en="Paper" class="dg-small" />

  <rect class="dg-box" x="20" y="206" width="96" height="54" rx="6" />
  <g class="dg-line" transform="translate(59, 215) scale(0.75)">
    <path d="M16 10h2" /><path d="M16 14h2" /><path d="M6.17 15a3 3 0 0 1 5.66 0" /><circle cx="9" cy="11" r="2" /><rect x="2" y="5" width="20" height="14" rx="2" />
  </g>
  <DgText x={68} y={250} ja="ICカード" en="IC card" class="dg-small" />

  {/* 中央: 後付けの自動化（ここだけアクセント色） */}
  <rect class="dg-accbox" x="166" y="72" width="108" height="158" rx="10" stroke-dasharray="5 4" />
  <DgText x={220} y={138} ja="後付けの" en="Added" class="dg-acctext" />
  <DgText x={220} y={160} ja="自動化" en="automation" class="dg-acctext" />
  <g class="dg-acc" transform="translate(210, 178) scale(0.85)">
    <circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
  </g>

  {/* 接続矢印（すべてニュートラル） */}
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M118 69C142 69 142 110 164 110" />
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M118 151H164" />
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M118 233C142 233 142 192 164 192" />

  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M276 110C300 110 300 69 322 69" />
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M276 151H322" />
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M276 192C300 192 300 233 322 233" />

  {/* 右列: 自動で出るもの（ニュートラル） */}
  <rect class="dg-box" x="324" y="45" width="96" height="48" rx="6" />
  <DgText x={372} y={74} ja="PDF化" en="PDF" />
  <rect class="dg-box" x="324" y="127" width="96" height="48" rx="6" />
  <DgText x={372} y={156} ja="全文検索" en="Search" />
  <rect class="dg-box" x="324" y="209" width="96" height="48" rx="6" />
  <DgText x={372} y={238} ja="勤怠集計" en="Tally" />
</svg>
