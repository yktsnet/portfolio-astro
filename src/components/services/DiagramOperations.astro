---
import DgText from './DgText.astro';
---
{/* 言いたいのは「上の段（現場の入力）は左右で同じ、下の段（転記と集計）だけが入れ替わる」こと */}
<svg class="dg h-auto w-full" viewBox="0 0 440 300" role="img" aria-label="導入の前後で、現場のExcel・紙・ICカードの入力は変わらず、手作業の転記と集計だけが裏側の自動処理に置き換わる図">
  <defs>
    <marker id="dg-op-mk" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="dg-mk" d="M0 1L9 5L0 9z" /></marker>
  </defs>

  <DgText x={105} y={22} ja="これまで" en="Before" class="dg-small" />
  <DgText x={335} y={22} ja="導入後" en="After" class="dg-small" />

  {/* 上の段: 現場の入力。左右で同じ形にして、変わらないことを見せる */}
  {[20, 250].map((x) => (
    <g>
      <rect class="dg-box" x={x} y="36" width="170" height="88" rx="8" />
      <g class="dg-line" transform={`translate(${x + 30}, 52) scale(0.9)`}>
        <rect width="18" height="18" x="3" y="3" rx="2" /><path d="M12 3v18" /><path d="M3 9h18" /><path d="M3 15h18" />
      </g>
      <g class="dg-line" transform={`translate(${x + 75}, 52) scale(0.9)`}>
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /><path d="M16 13H8" /><path d="M16 17H8" />
      </g>
      <g class="dg-line" transform={`translate(${x + 120}, 52) scale(0.9)`}>
        <path d="M16 10h2" /><path d="M16 14h2" /><path d="M6.17 15a3 3 0 0 1 5.66 0" /><circle cx="9" cy="11" r="2" /><rect x="2" y="5" width="20" height="14" rx="2" />
      </g>
      <DgText x={x + 85} y={98} ja="Excel・紙・ICカード" en="Excel, paper, IC card" />
      <DgText x={x + 85} y={114} ja="現場の入力" en="How staff enter data" class="dg-small" />
    </g>
  ))}

  {/* 上の段のあいだ: 前後で変わらないことを、矢印に添えた言葉で示す */}
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M194 80H246" />
  <DgText x={220} y={100} ja="そのまま" en="same" class="dg-small" />

  {/* 下の段・左: 人の手作業（ニュートラル） */}
  <rect class="dg-box" x="20" y="174" width="170" height="96" rx="8" stroke-dasharray="4 4" />
  <g class="dg-line" transform="translate(94, 186) scale(0.9)">
    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
  </g>
  <DgText x={105} y={230} ja="手で転記・集計" en="Copied and tallied by hand" />
  <DgText x={105} y={250} ja="月末と繁忙期に集中する" en="Piles up at month end" class="dg-small" />

  {/* 下の段・右: 裏側の自動処理（ここだけアクセント色） */}
  <rect class="dg-accbox" x="250" y="174" width="170" height="96" rx="8" />
  <g class="dg-acc" transform="translate(324, 186) scale(0.9)">
    <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
  </g>
  <DgText x={335} y={230} ja="裏側で自動" en="Automated behind it" class="dg-acctext" />
  <DgText x={335} y={250} ja="PDF・検索・給与の集計" en="PDFs, search, payroll tally" class="dg-small" />

  {/* 下の段のあいだ: 置き換わることを矢印で示す */}
  <path class="dg-line" marker-end="url(#dg-op-mk)" d="M194 222H246" />
</svg>
