  <DgText x={358} y={66} ja="入口を増やす" en="new enrollment path" class="dg-small" />
  <rect class="dg-accbox" x="12" y="222" width="140" height="52" rx="8" />
  <DgText x={82} y={244} ja="出席管理" en="Attendance" class="dg-acctext" />
  <DgText x={82} y={262} ja="NFC カード" en="NFC cards" class="dg-small" />
  <rect class="dg-accbox" x="288" y="222" width="140" height="52" rx="8" />
  <DgText x={358} y={244} ja="教材のデータ化" en="Exam data" class="dg-acctext" />
  <DgText x={358} y={262} ja="採点・分析" en="grading, analysis" class="dg-small" />

  <path class="dg-acc" marker-end="url(#dg-ed-mk)" d="M154 64C186 64 196 92 200 112" />
  <path class="dg-acc" marker-end="url(#dg-ed-mk)" d="M286 64C254 64 244 92 240 112" />
  <path class="dg-acc" marker-end="url(#dg-ed-mk)" d="M154 240C164 240 166 196 170 190" />
  <path class="dg-acc" marker-end="url(#dg-ed-mk)" d="M286 240C276 240 274 196 270 190" />
</svg>
