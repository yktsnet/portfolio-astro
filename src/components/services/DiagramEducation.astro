---
import DgText from './DgText.astro';
---
<svg class="dg h-auto w-full" viewBox="0 0 440 300" role="img" aria-label="プログラミング教室の導入・NFC出席管理・模試や教材のデータ化の3つが学習塾の事業を支える図">
  <defs>
    <marker id="dg-ed-mk" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="dg-mk" d="M0 1L9 5L0 9z" /></marker>
  </defs>

  {/* 左列: 3つの提供内容（ニュートラル、1行ずつ大きく明快に） */}
  <rect class="dg-box" x="18" y="42" width="196" height="52" rx="8" />
  <DgText x={116} y={73} ja="プログラミング教室の導入" en="Add programming" />

  <rect class="dg-box" x="18" y="124" width="196" height="52" rx="8" />
  <DgText x={116} y={155} ja="NFCカードの出席管理" en="NFC attendance" />

  <rect class="dg-box" x="18" y="206" width="196" height="52" rx="8" />
  <DgText x={116} y={237} ja="模試・教材のデータ化" en="Exam & material data" />

  {/* 接続矢印（ニュートラル） */}
  <path class="dg-line" marker-end="url(#dg-ed-mk)" d="M216 68C252 68 256 116 286 116" />
  <path class="dg-line" marker-end="url(#dg-ed-mk)" d="M216 150H286" />
  <path class="dg-line" marker-end="url(#dg-ed-mk)" d="M216 232C252 232 256 184 286 184" />

  {/* 右: 学習塾・教室の事業（ここだけアクセント色＋Lucideのgraduation-capアイコン） */}
  <rect class="dg-accbox" x="290" y="72" width="132" height="156" rx="10" stroke-dasharray="5 4" />
  <g class="dg-acc" transform="translate(342, 108) scale(1.15)">
    <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
    <path d="M22 10v6" />
    <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
  </g>
  <DgText x={356} y={164} ja="学習塾・教室" en="Tutoring school" class="dg-acctext" />
  <DgText x={356} y={186} ja="募集・継続・運営" en="enrollment & ops" class="dg-small" />
</svg>
