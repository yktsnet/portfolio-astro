---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
  reverse?: boolean;
}
const { service: s, reverse = false } = Astro.props;
---
{/* スマホでは図を先に出し、何の話かを見てから文章を読めるようにする。
    md 以上はカード全体がリンク。スマホではカードが1画面を超えて画面全体がリンクになるので、ボタンだけをリンクにする */}
<article class="group relative grid overflow-hidden ui-card transition-colors duration-200 md:hover:border-poi-accent/50 dark:md:hover:border-poi-accent/50 md:grid-cols-2">
  <div class:list={["flex flex-col justify-between p-5 sm:p-9 lg:p-10", reverse && "md:order-2"]}>
    <div>
      <p class="flex items-center gap-2 font-mono type-label text-poi-accent">
        <LucideIcon name={s.icon} />
        <span>{s.no}</span>
        <span class="tracking-widest text-zinc-500 dark:text-poi-muted">{s.kicker}</span>
      </p>
      <h3 class="mt-3 type-heading font-semibold text-zinc-900 transition-colors md:group-hover:text-poi-accent dark:text-poi-focus">
        <T text={s.title} />
      </h3>
      <p class="mt-3.5 type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={s.summary} /></p>

      {/* スマホでは提供物の名前だけ出す。補足は詳細ページの各カードが詳しく述べている */}
      <ul class="mt-5 space-y-2 border-t border-zinc-200 pt-4 md:mt-6 md:space-y-3 md:pt-5 dark:border-poi-border/60">
        {s.offerings.map((o) => (
          <li class="flex gap-2.5 type-body text-zinc-800 dark:text-poi-focus">
            <LucideIcon name={o.icon} class="mt-1 h-4 w-4 shrink-0 text-poi-accent" />
            <span>
              <T text={o.title} />
              <span class="mt-0.5 hidden type-caption leading-6 text-zinc-500 md:block dark:text-poi-muted"><T text={o.short} /></span>
            </span>
          </li>
        ))}
      </ul>
      {s.proof && (
        <p class="mt-5 flex gap-2 rounded-lg bg-zinc-100/80 px-3.5 py-2.5 type-caption leading-6 text-zinc-700 dark:bg-poi-panel/40 dark:text-poi-text">
          <LucideIcon name="trending-up" class="mt-1 h-3.5 w-3.5 shrink-0 text-poi-accent" />
          <T text={s.proof} />
        </p>
      )}
    </div>

    <div class="mt-5 md:mt-8">
      <a
        href={`/services/${s.slug}/`}
        class="inline-flex items-center gap-1.5 rounded-md border border-poi-accent/35 bg-poi-accent/5 px-3 py-1.5 font-mono type-caption text-poi-accent md:after:absolute md:after:inset-0 md:after:content-[''] focus-visible:underline outline-hidden"
      >
        <span class="lang-ja">詳しく見る</span><span class="lang-en">Learn more</span>
        <span class="sr-only"><T text={s.title} /></span>
        <LucideIcon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
  <div class:list={[
    "order-first flex items-center justify-center border-b ui-subpanel px-5 py-4 sm:p-8 lg:p-10 md:border-b-0",
    reverse ? "md:order-1 md:border-r" : "md:order-last md:border-l",
  ]}>
    <div class="w-full max-w-md">
      <ServiceDiagram slug={s.slug} />
    </div>
  </div>
</article>
