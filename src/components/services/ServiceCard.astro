---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import ServiceDiagram from './ServiceDiagram.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
---
<article class="group grid overflow-hidden rounded-lg border border-zinc-200 bg-white transition-colors hover:border-zinc-300 dark:border-poi-border/70 dark:bg-poi-panel/15 dark:hover:border-poi-border md:grid-cols-2">
  <div class="flex flex-col justify-between p-7 sm:p-9">
    <div>
      <p class="flex items-center gap-2 font-mono text-[11px] text-poi-accent">
        <LucideIcon name={s.icon} />
        <span>{s.no}</span>
        <span class="tracking-widest text-poi-muted">{s.kicker}</span>
      </p>
      <h3 class="mt-2.5 text-base sm:text-lg font-semibold text-zinc-900 dark:text-poi-focus">
        <a href={`/services/${s.slug}/`} class="hover:text-poi-accent transition-colors">
          <T text={s.title} />
        </a>
      </h3>
      <p class="mt-3 text-[13px] leading-7 text-zinc-600 dark:text-poi-muted"><T text={s.summary} /></p>

      <ul class="mt-5 space-y-2 border-t border-zinc-200 pt-4 dark:border-poi-border/60">
        {s.offerings.map((o) => (
          <li class="flex items-center gap-2.5 text-xs text-zinc-700 dark:text-poi-text">
            <LucideIcon name={o.icon} class="h-3.5 w-3.5 shrink-0 text-poi-accent" />
            <T text={o.title} />
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-6 pt-2">
      <a href={`/services/${s.slug}/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-poi-accent hover:underline underline-offset-4">
        <span class="lang-ja">詳しく見る</span><span class="lang-en">Learn more</span>
        <LucideIcon name="arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
  <div class="flex items-center justify-center border-t border-zinc-200 bg-zinc-100/60 p-6 sm:p-8 dark:border-poi-border/70 dark:bg-poi-panel/35 md:border-t-0 md:border-l">
    <div class="w-full max-w-sm">
      <ServiceDiagram slug={s.slug} />
    </div>
  </div>
</article>
