---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import BeforeAfter from './BeforeAfter.astro';
import Fold from '../Fold.astro';
import type { Offering } from '../../data/services';
import type { OfferingDetail } from '../../types';

// カードの最下段（必要なもの・リンク）はページごとに違うので slot で受ける
interface Props {
  offering: Offering;
  detail: OfferingDetail;
}
const { offering: o, detail: d } = Astro.props;
---
<article class="ui-card ui-card-hover flex flex-col p-6 sm:p-8">
  <h3 class="flex items-center gap-2.5 type-subheading font-semibold text-zinc-900 dark:text-poi-focus">
    <LucideIcon name={o.icon} class="h-5 w-5 text-poi-accent" />
    <T text={o.title} />
  </h3>
  <p class="mt-3 type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={d.line} /></p>

  {/* スマホでは1枚が1画面を超えるので、説明の下は見出しだけ出して畳む */}
  <Fold as="p" mobileHeadOnly class="mt-6 border-t border-zinc-200 pt-5 dark:border-poi-border/60">
    <span slot="head" class="type-caption font-semibold text-zinc-700 dark:text-poi-text">
      <T text={{ ja: 'これまで → 導入後', en: 'Before → After' }} />
    </span>
    <BeforeAfter
      bare
      beforeLabel={{ ja: 'これまで', en: 'Before' }}
      afterLabel={{ ja: '導入後', en: 'After' }}
      before={d.before}
      after={d.after}
    />
  </Fold>

  <Fold as="p" class="mt-6 border-t border-zinc-200 pt-5 dark:border-poi-border/60">
    <span slot="head" class="ui-kicker"><T text={{ ja: '作り方の工夫', en: 'How it is built' }} /></span>
    <ul class="mt-3 space-y-3">
      {d.decisions.map((dc) => (
        <li class="type-small leading-6">
          <span class="font-semibold text-zinc-900 dark:text-poi-focus"><T text={dc.title} /></span>
          <span class="mt-0.5 block text-zinc-700 dark:text-poi-muted"><T text={dc.body} /></span>
        </li>
      ))}
    </ul>
  </Fold>

  <div class="mt-auto pt-6">
    <slot />
  </div>
</article>
