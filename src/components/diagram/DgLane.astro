---
import { getLucideIcon } from '../../lib/lucide';
import { textWidth } from '../../lib/svg-text';

// レーン見出し（アイコン・担当名・補足）。補足は担当名の右に並べ、
// maxX までに収まらない言語だけ担当名の下の行へ送る
interface Props {
  x: number;
  y: number;
  maxX: number;
  icon: string;
  ja: string;
  en?: string;
  subJa: string;
  subEn?: string;
}
const { x, y, maxX, icon, ja, en, subJa, subEn } = Astro.props;

const place = (title: string, sub: string) => {
  const subX = x + textWidth(title, 13) + 12;
  const text = `— ${sub}`;
  return subX + textWidth(text, 11.5) <= maxX ? { x: subX, y, text } : { x, y: y + 17, text: sub };
};
// en を渡さないときは日本語だけを出す（md 未満でしか出さない図）
const rows = en === undefined || subEn === undefined
  ? [{ title: ja, sub: place(ja, subJa), cls: undefined }]
  : [{ title: ja, sub: place(ja, subJa), cls: 'lang-ja' }, { title: en, sub: place(en, subEn), cls: 'lang-en' }];
---
<svg class="dg-acc" x={x - 22} y={y - 13} width="16" height="16" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon(icon)} />
{rows.map((r) => (
  <>
    <text class:list={['dg-acctext', r.cls]} x={x} y={y}>{r.title}</text>
    <text class:list={['dg-small', r.cls]} x={r.sub.x} y={r.sub.y}>{r.sub.text}</text>
  </>
))}
