---
import FoldToggle from './FoldToggle.astro';
import { getBrandIcon } from '../lib/brand-icons';
import type { MultilingualText } from '../lib/i18n';

type TimelineEntry = { year: string; label: MultilingualText };
type LocationGroup = { location: string; items: TimelineEntry[] };
type StackItem = { name: string; brand: string | null };

interface Props {
  // トップでは2つを別の列に置くので、片方ずつ出す
  part: 'coverage' | 'timeline';
}
const { part } = Astro.props;
type CoverageRow = { area: string; items: StackItem[] };

// 抽象表現なので代表技術を手選びする
const coverage: CoverageRow[] = [
  {
    area: "Frontend",
    items: [
      { name: "React", brand: "react" },
      { name: "Vue", brand: "vue" },
      { name: "TypeScript", brand: "typescript" },
    ],
  },
  {
    area: "Backend",
    items: [
      { name: "C# (.NET)", brand: "csharp" },
      { name: "Python", brand: "python" },
      { name: "Go", brand: "go" },
    ],
  },
  {
    area: "Data / AI",
    items: [
      { name: "PostgreSQL", brand: "postgresql" },
      { name: "LangGraph", brand: "langgraph" },
      { name: "RAG", brand: null },
      { name: "Text-to-SQL", brand: null },
    ],
  },
  {
    area: "Infra / SRE",
    items: [
      { name: "NixOS", brand: "nixos" },
      { name: "Terraform", brand: "terraform" },
      { name: "Cloudflare", brand: "cloudflare" },
      { name: "AWS", brand: null },
    ],
  },
  {
    area: "IoT",
    items: [
      { name: "Raspberry Pi", brand: "raspberry-pi" },
      { name: "Espressif", brand: "espressif" },
    ],
  },
];

const timeline: LocationGroup[] = [
  {
    location: "Management",
    items: [
      { year: "2013", label: { ja: "学習塾 開業", en: "Founded Tutoring School" } },
      { year: "2019", label: { ja: "合同会社 設立", en: "Established LLC" } },
      { year: "2024", label: { ja: "合同会社 清算", en: "Liquidated LLC" } },
      { year: "2025", label: { ja: "学習塾 閉業", en: "Closed Tutoring School" } },
    ],
  },
  {
    location: "Engineering",
    items: [
      { year: "2025", label: { ja: "個人開発 / 外部CTO", en: "Solo Dev / External CTO" } },
      { year: "2026〜", label: { ja: "受託開発企業 / 個人受託・OSS", en: "Contract Dev Firm / Freelance & OSS" } },
    ],
  },
];
---

{/* 技術の範囲と経歴の年表。スマホでは畳んだ2行が上下に続くので、罫線は coverage が上、timeline が上下を引く。
    中身が1つだけなので、見出しの行をそのまま開閉のボタンにする */}
{part === 'coverage' && (
  <div data-fold-group class="border-t border-zinc-200 py-3.5 md:border-t-0 md:py-0 dark:border-poi-border/60">
    <FoldToggle variant="band">
      <span class="font-mono type-caption font-normal tracking-widest uppercase text-zinc-500 dark:text-poi-muted">COVERAGE</span>
      <span class="ml-2.5 type-small font-normal text-zinc-700 dark:text-poi-text">技術の範囲</span>
    </FoldToggle>
    <p class="hidden font-mono type-caption tracking-widest uppercase text-zinc-500 md:block dark:text-poi-muted">COVERAGE</p>
    <div class="fold-body">

    {/* ビジネス層: 5領域と並列にせず、上から翻訳して落とす縦の関係で見せる（Issue 39） */}
    <div class="mt-4 rounded-xl border border-zinc-200 dark:border-poi-border/70 bg-zinc-50/60 dark:bg-white/2 px-4 py-3.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <span class="font-mono type-small font-medium text-zinc-800 dark:text-poi-focus/90">Business</span>
      <span class="type-caption text-zinc-500 dark:text-poi-muted lang-ja">会計・原価から手を付ける順番を決める</span>
      <span class="type-caption text-zinc-500 dark:text-poi-muted lang-en">Setting priorities from accounting and cost structure</span>
    </div>

    <div class="flex justify-center pt-1.5 pb-2.5" aria-hidden="true">
      <span class="type-body text-zinc-400 dark:text-poi-muted">&darr;</span>
    </div>

    {/* この外枠とラベルが核。外すとただのスキル表に退行する（Issue 39） */}
    <div class="relative rounded-xl border border-zinc-300 dark:border-poi-border px-5 pt-4 pb-3 mt-1.5">
      <p class="absolute -top-2.5 left-4 px-2 bg-zinc-50 dark:bg-poi-base type-label tracking-wide text-zinc-500 dark:text-poi-muted">
        <span class="lang-ja">1人で設計・実装・運用</span>
        <span class="lang-en">Solo Design, Dev &amp; Ops</span>
      </p>
      <table class="w-full mt-1 type-small">
        <tbody>
          {coverage.map(({ area, items }) => (
            <tr class="border-t first:border-t-0 border-zinc-200 dark:border-poi-border/50">
              <td class="py-2.5 pr-4 w-[32%] whitespace-nowrap align-middle font-mono font-medium text-zinc-800 dark:text-poi-focus/90">{area}</td>
              <td class="py-2 align-middle">
                <div class="flex flex-wrap gap-1.5">
                  {items.map(item => {
                    const icon = item.brand ? getBrandIcon(item.brand) : null;
                    return (
                      <span class="group inline-flex items-center gap-1.5 px-2 py-0.5 rounded-sm bg-zinc-100/70 dark:bg-poi-panel/15 border border-zinc-200/50 dark:border-poi-border/20 type-caption font-mono text-zinc-600 dark:text-poi-muted transition-all duration-200 hover:bg-zinc-100 dark:hover:bg-poi-panel/30 hover:text-zinc-900 dark:hover:text-poi-focus select-none">
                        {icon && (
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="11" height="11" viewBox="0 0 24 24"
                            fill="currentColor"
                            class="brand-icon transition-all duration-200"
                            style={`--brand-hex: #${icon.hex}`}
                            set:html={`<path d="${icon.path}" />`}
                          />
                        )}
                        <span>{item.name}</span>
                      </span>
                    );
                  })}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </div>
  </div>
)}

{part === 'timeline' && (
  <div data-fold-group class="border-y border-zinc-200 py-3.5 md:border-y-0 md:py-0 dark:border-poi-border/60">
    <FoldToggle variant="band">
      <span class="font-mono type-caption font-normal tracking-widest uppercase text-zinc-500 dark:text-poi-muted">TIMELINE</span>
      <span class="ml-2.5 type-small font-normal text-zinc-700 dark:text-poi-text">経歴</span>
    </FoldToggle>
    <p class="hidden font-mono type-caption tracking-widest uppercase text-zinc-500 md:block dark:text-poi-muted">TIMELINE</p>
    <div class="fold-body mt-4 space-y-5 pb-2 md:pb-0">
      {timeline.map(({ location, items }) => (
        <div>
          <p class="font-mono type-caption text-poi-accent mb-2.5">@{location}</p>
          <div>
            {items.map(({ year, label }, idx) => (
              <div class="flex items-stretch">
                {/* レール: 縦線とドットを同じセル中央に置き、常に整列させる */}
                <div class="relative w-4 shrink-0" aria-hidden="true">
                  {idx < items.length - 1 && (
                    <span class="absolute left-1/2 top-2 bottom-0 -translate-x-1/2 w-px bg-zinc-200 dark:bg-poi-border/70"></span>
                  )}
                  <span class="absolute left-1/2 top-2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-zinc-400 dark:bg-poi-accent ring-2 ring-white dark:ring-poi-base"></span>
                </div>
                <div class:list={["pl-4 flex-1 flex items-baseline gap-4 type-small", idx < items.length - 1 ? "pb-3.5" : "pb-0"]}>
                  <span class="font-mono type-caption text-zinc-500 w-11 shrink-0 tabular-nums">{year}</span>
                  <span class="text-zinc-600 dark:text-poi-muted lang-ja">{label.ja}</span>
                  <span class="text-zinc-600 dark:text-poi-muted lang-en">{label.en}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .brand-icon {
    color: currentColor;
  }
  .group:hover .brand-icon {
    color: var(--brand-hex) !important;
    filter: drop-shadow(0 0 4px var(--brand-hex));
  }
</style>
