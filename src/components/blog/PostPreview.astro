---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";
import { getLucideIcon } from "../../lib/lucide";
import { getPostVisualMeta } from "../../data/works";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  post: CollectionEntry<"post">;
  withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
const visual = getPostVisualMeta(post.id, post.data.icon ?? "code");
const postUrl = `/posts/${post.id}/`;
const svgContent = getLucideIcon(visual.icon);
---

<FormattedDate class="min-w-[120px] font-semibold text-zinc-500 dark:text-poi-muted/70" date={post.data.publishDate} />
<Tag>
  {post.data.draft && <span class="text-red-500">(Draft) </span>}
  <a class="cactus-link inline-flex items-center gap-1.5" href={postUrl}>
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style={`color:${visual.color};opacity:0.8`} set:html={svgContent} aria-hidden="true" />
    {post.data.title}
  </a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
