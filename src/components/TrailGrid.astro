---
interface Props {
  /** band はページの上下に置く帯、divider は節の境の罫線の代わりに置く細い帯。違うのは高さと固定のマスの数だけ */
  variant?: 'band' | 'divider';
  class?: string;
}
const { variant = 'band', class: className } = Astro.props;
---
{/* 10px 角の方眼の上で、マウスが通ったマスに色を付けてすぐ消す。md 未満ではマウスが無いので、色のマスをいくつか固定で置く */}
<trail-grid
  aria-hidden="true"
  data-variant={variant}
  class:list={["trail-grid relative block", variant === 'band' ? 'h-13.5' : 'h-5', className]}
></trail-grid>

<script>
  const SVG = 'http://www.w3.org/2000/svg';
  const COLORS = ['var(--trail-teal)', 'var(--trail-pink)', 'var(--trail-blue)', 'var(--trail-lime)', 'rgb(var(--color-accent))'];
  const GRAYS = ['var(--trail-gray-1)', 'var(--trail-gray-2)', 'var(--trail-gray-2)', 'var(--trail-gray-3)'];
  // 色を残すのは新しい側からこのマス数まで。それより古いマスは灰色に変える
  const HEAD = 3;
  // 同時に残すマスの上限。超えたら古いものから消す
  const MAX_PIXELS = 48;
  // md 未満で固定で置くマスの数（色・灰色）。細い境は帯より少なくする
  const STATIC = { band: [3, 4], divider: [1, 2] } as const;
  const wide = window.matchMedia('(min-width: 48rem)');

  // 読み込みのたびに変わる種。帯の種類と合わせて並びを決める
  const LOAD_SEED = Math.floor(Math.random() * 2 ** 32);
  function seeded(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = Math.imul(a ^ (a >>> 15), a | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function hash(text: string) {
    let h = 2166136261;
    for (const c of text) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
    return h >>> 0;
  }

  class TrailGrid extends HTMLElement {
    #svg = document.createElementNS(SVG, 'svg');
    #layer = document.createElementNS(SVG, 'g');
    #cols = 0;
    #rows = 0;
    #cell = 0;
    #last = -1;
    #lit = new Map<number, SVGRectElement>();
    #visible = false;
    #cleanup: (() => void)[] = [];

    connectedCallback() {
      this.#svg.classList.add('trail-grid-svg');
      this.append(this.#svg);
      const ro = new ResizeObserver(([e]) => this.#layout(e.contentRect.width, e.contentRect.height));
      ro.observe(this);
      const relayout = () => { this.#cols = 0; this.#layout(this.clientWidth, this.clientHeight); };
      wide.addEventListener('change', relayout);
      this.#cleanup.push(() => ro.disconnect(), () => wide.removeEventListener('change', relayout));

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hover = window.matchMedia('(hover: hover)').matches;
      if (reduced || !hover) return;
      // 画面に入っているあいだだけマウスを追う
      const io = new IntersectionObserver(([e]) => { this.#visible = e.isIntersecting; });
      io.observe(this);
      const onMove = (e: PointerEvent) => this.#onMove(e);
      window.addEventListener('pointermove', onMove, { passive: true });
      this.#cleanup.push(() => io.disconnect(), () => window.removeEventListener('pointermove', onMove));
    }

    disconnectedCallback() {
      this.#cleanup.forEach((f) => f());
      this.#cleanup = [];
    }

    #layout(w: number, h: number) {
      // 幅を 10px 前後で割り切れる列の数にして、端に半端なマスを出さない
      const cols = Math.ceil(w / 10);
      const cell = cols ? w / cols : 0;
      // 行の数は四捨五入にして、指定した高さから大きくはみ出さないようにする
      const rows = cell ? Math.max(1, Math.round(h / cell)) : 0;
      if (cols === this.#cols && rows === this.#rows && cell === this.#cell) return;
      this.#cols = cols;
      this.#rows = rows;
      this.#cell = cell;
      this.#lit.clear();
      const id = `trail-grid-${Math.random().toString(36).slice(2)}`;
      this.#svg.setAttribute('viewBox', `0 0 ${cols} ${rows}`);
      this.#svg.setAttribute('width', String(w));
      this.#svg.setAttribute('height', String(rows * cell));
      // 線は pattern で繰り返すと型の端で太さの半分が切れ、外枠だけ太く見える。すべて1本ずつ引いて太さをそろえる
      // 線をマスの境目の真ん中に置くと2つの画素にまたがってにじむので、境目の内側へ太さの半分だけ寄せる
      const half = 0.0235;
      const at = (k: number, last: number) => (k === last ? k - half : k + half);
      let lines = '';
      for (let x = 0; x <= cols; x++) lines += `M ${at(x, cols)} 0 V ${rows} `;
      for (let y = 0; y <= rows; y++) lines += `M 0 ${at(y, rows)} H ${cols} `;
      // 左右の端だけを背景に溶かす。溶かすのは方眼の線だけで、色のマスには掛けない
      this.#svg.innerHTML =
        `<defs><linearGradient id="${id}-h" x1="0" y1="0" x2="1" y2="0">` +
        `<stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="0.12" stop-color="#fff" />` +
        `<stop offset="0.88" stop-color="#fff" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>` +
        `<mask id="${id}-mh"><rect y="-1" width="${cols}" height="${rows + 2}" fill="url(#${id}-h)" /></mask></defs>` +
        `<path class="trail-grid-line" mask="url(#${id}-mh)" d="${lines}" />`;
      this.#layer = document.createElementNS(SVG, 'g');
      this.#svg.append(this.#layer);
      if (!wide.matches) this.#paintStatic();
    }

    #paintStatic() {
      // 同じページの中では、境どうし・上下の帯どうしで同じ並びにして、目が散らないようにする
      const r = seeded(hash(`${LOAD_SEED}#${this.dataset.variant}`));
      // 左右の端は溶けて見えにくいので避ける
      const [colors, grays] = STATIC[this.dataset.variant === 'divider' ? 'divider' : 'band'];
      const used = new Set<number>();
      const place = (fill: string) => {
        for (let tries = 0; tries < 20; tries++) {
          const x = Math.floor(this.#cols * (0.15 + r() * 0.7));
          const y = Math.floor(r() * this.#rows);
          const i = y * this.#cols + x;
          if (used.has(i)) continue;
          used.add(i);
          this.#layer.append(this.#rect(x, y, fill));
          return;
        }
      };
      for (let k = 0; k < colors; k++) place(COLORS[Math.floor(r() * COLORS.length)]);
      for (let k = 0; k < grays; k++) place(GRAYS[Math.floor(r() * GRAYS.length)]);
    }

    #rect(x: number, y: number, fill: string) {
      const rect = document.createElementNS(SVG, 'rect');
      rect.setAttribute('x', String(x));
      rect.setAttribute('y', String(y));
      rect.setAttribute('width', '1');
      rect.setAttribute('height', '1');
      rect.setAttribute('class', 'trail-grid-pixel');
      rect.style.fill = fill;
      return rect;
    }

    #onMove(e: PointerEvent) {
      if (!this.#visible || !wide.matches || e.pointerType === 'touch' || !this.#cell) return;
      const r = this.getBoundingClientRect();
      const x = Math.floor((e.clientX - r.left) / this.#cell);
      const y = Math.floor((e.clientY - r.top) / this.#cell);
      if (x < 0 || x >= this.#cols || y < 0 || y >= this.#rows) { this.#last = -1; return; }
      const index = y * this.#cols + x;
      if (index === this.#last || this.#lit.has(index)) return;
      this.#last = index;
      this.#paint(index, x, y);
    }

    #paint(index: number, x: number, y: number) {
      const rect = this.#rect(x, y, COLORS[Math.floor(Math.random() * COLORS.length)]);
      this.#layer.append(rect);
      this.#lit.set(index, rect);

      for (const el of [...this.#lit.values()].slice(0, -HEAD)) {
        if (el.dataset.gray) continue;
        el.dataset.gray = '1';
        el.style.fill = GRAYS[Math.floor(Math.random() * GRAYS.length)];
      }
      if (this.#lit.size > MAX_PIXELS) {
        const [oldest, el] = this.#lit.entries().next().value!;
        el.remove();
        this.#lit.delete(oldest);
      }
      // 置いてから 100〜200ms で縮み始め、その 100ms 後に消す
      const life = 100 + Math.random() * 100;
      window.setTimeout(() => rect.classList.add('is-exiting'), life);
      window.setTimeout(() => {
        rect.remove();
        if (this.#lit.get(index) === rect) this.#lit.delete(index);
      }, life + 100);
    }
  }

  if (!customElements.get('trail-grid')) customElements.define('trail-grid', TrailGrid);
</script>
