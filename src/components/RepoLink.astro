---
import LucideIcon from './LucideIcon.astro';
import { getBrandIcon } from '../lib/brand-icons';

interface Props {
  label: string;
  href: string;
  icon?: string;
}
const { label, href, icon = 'github' } = Astro.props;
const brand = getBrandIcon(icon);
const iconClass = 'h-3.5 w-3.5 shrink-0 opacity-70 transition-opacity duration-200 group-hover:opacity-100';
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="group inline-flex items-center gap-1.5 font-mono type-caption text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-poi-muted dark:hover:text-poi-focus"
>
  {brand ? (
    <svg class={iconClass} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={brand.path} /></svg>
  ) : (
    <LucideIcon name={icon} class={iconClass} />
  )}
  {label}
  <LucideIcon name="external-link" class="h-3 w-3 shrink-0 opacity-70 transition-opacity duration-200 group-hover:opacity-100" />
</a>
