---
import LucideIcon from './LucideIcon.astro';
import type { Repo } from '../data/services';

interface Props {
  repo: Repo;
}
const { repo } = Astro.props;
---
<a
  href={repo.href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1.5 rounded border border-zinc-200 dark:border-poi-border px-2 py-0.5 font-mono text-[11px] text-zinc-600 dark:text-poi-muted transition-colors hover:border-poi-accent hover:text-poi-accent"
>
  <LucideIcon name="github" class="h-3.5 w-3.5" />
  {repo.name}
  <LucideIcon name="external-link" class="h-3 w-3 opacity-60" />
</a>
