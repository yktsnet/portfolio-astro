---
import LucideIcon from './LucideIcon.astro';

interface Props {
  label: string;
  href: string;
  icon?: string;
}
const { label, href, icon = 'github' } = Astro.props;
---
<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="inline-flex items-center gap-1.5 font-mono type-caption text-zinc-500 transition-colors hover:text-poi-accent dark:text-poi-muted"
>
  <LucideIcon name={icon} class="h-3.5 w-3.5 shrink-0 opacity-70" />
  {label}
  <LucideIcon name="external-link" class="h-3 w-3 shrink-0" />
</a>
