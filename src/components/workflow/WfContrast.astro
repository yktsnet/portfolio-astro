---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import type { MultilingualText } from '../../lib/i18n';

interface Props {
  title: MultilingualText;
  body: MultilingualText;
  fix: MultilingualText;
}
const { title, body, fix } = Astro.props;
---
{/* 節の仕組みが防ぐ AI 開発のアンチパターン。破線の枠で、上の実線のカードとは別の補足だと分かるようにする。
    起きることだけを書くと読み手が対策を探すことになるので、矢印の1行でこの節の対策を添える */}
<aside class="mt-4 rounded-xl border border-dashed border-zinc-300 px-5 py-4 sm:px-6 dark:border-poi-border">
  <p class="ui-kicker flex items-center gap-1.5">
    <LucideIcon name="x" class="h-3 w-3" />
    <span>Anti-pattern</span>
  </p>
  <h3 class="mt-1.5 type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={title} /></h3>
  <p class="mt-1 max-w-3xl type-small leading-6 text-zinc-700 dark:text-poi-muted"><T text={body} /></p>
  <p class="mt-2 flex max-w-3xl gap-2 type-small leading-6 text-zinc-900 dark:text-poi-focus">
    <LucideIcon name="arrow-right" class="mt-1 h-3.5 w-3.5 shrink-0 text-poi-accent" />
    <span><T text={fix} /></span>
  </p>
</aside>
