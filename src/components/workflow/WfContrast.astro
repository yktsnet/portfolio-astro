---
import T from '../T.astro';
import LucideIcon from '../LucideIcon.astro';
import Fold from '../Fold.astro';
import type { MultilingualText } from '../../lib/i18n';

interface Props {
  title: MultilingualText;
  body: MultilingualText;
  fix: MultilingualText;
}
const { title, body, fix } = Astro.props;
---
{/* 節の仕組みが防ぐ AI 開発のアンチパターン。破線の枠で、上の実線のカードとは別の補足だと分かるようにする */}
<aside class="mt-4 rounded-xl border border-dashed border-zinc-300 p-5 sm:p-6 dark:border-poi-border">
  <Fold>
    <Fragment slot="head">
      <span class="ui-kicker flex items-center gap-1.5 font-normal">
        <LucideIcon name="x" class="h-3 w-3" />
        <span>Anti-pattern</span>
      </span>
      <span class="mt-2 block type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={title} /></span>
    </Fragment>
    <p class="mt-2 max-w-3xl type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={body} /></p>
    <p class="mt-3 flex gap-2 border-t border-zinc-200 pt-3 type-small leading-6 text-zinc-700 dark:border-poi-border/60 dark:text-poi-text">
      <LucideIcon name="arrow-right" class="mt-1 h-3.5 w-3.5 shrink-0 text-poi-accent" />
      <span><T text={fix} /></span>
    </p>
  </Fold>
</aside>
