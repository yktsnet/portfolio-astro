---
import N from '../diagram/DgNode.astro';
import Lane from '../diagram/DgLane.astro';
import DgText from '../diagram/DgText.astro';

interface Props {
  kind: 'overview' | 'spec' | 'verify';
  label: string;
}
const { kind, label } = Astro.props;

const mk = `wf-mk-${kind}`;
const mkAcc = `wf-mk-acc-${kind}`;
const end = `url(#${mk})`;
const endAcc = `url(#${mkAcc})`;

const viewBox = {
  overview: '0 0 820 420',
  spec: '0 0 820 376',
  verify: '0 0 820 368',
}[kind];

// スマホ用の縦組み。横組みを縮めると文字が読めず、横にスクロールさせると全体が一度に見えない
// 担当の並び（左に顧客理解、右に実装）は横組みと同じにし、流れだけを上から下にする。箱が狭いので文は短くしている。md 未満は日本語だけで出すので、英語は持たない
const spMk = `${mk}-sp`;
const spMkAcc = `${mkAcc}-sp`;
const spEnd = `url(#${spMk})`;
const spEndAcc = `url(#${spMkAcc})`;
const spViewBox = {
  overview: '0 0 348 410',
  spec: '0 0 348 496',
  verify: '0 0 348 486',
}[kind];
---
<svg
  class="dg -mx-3 block h-auto w-[calc(100%+1.5rem)] max-w-none sm:mx-auto sm:w-full sm:max-w-[348px] md:hidden"
  viewBox={spViewBox}
  role="img"
  aria-label={label}
>
  <defs>
    <marker id={spMk} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path class="dg-mk" d="M0 1L9 5L0 9z" />
    </marker>
    <marker id={spMkAcc} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path fill="rgb(var(--color-accent))" d="M0 1L9 5L0 9z" />
    </marker>
  </defs>

  {kind === 'overview' && (
    <>
      {/* 担当をまたぐ3本は、あいだが狭く言葉を添えられない。線の種類を入る先の箱の見た目と揃え、
          何が届くかは入る先の箱の2行目に書く。2行目はそこにだけ置き、ほかの箱は1行にして詰めない */}
      <rect class="dg-box" x="2" y="6" width="150" height="398" rx="12" style="fill: none" />
      <Lane x={32} y={30} maxX={144} icon="user-check" ja="顧客理解担当" subJa="現場と試作から決める" />
      <rect class="dg-box" x="196" y="6" width="150" height="398" rx="12" style="fill: none" />
      <Lane x={226} y={30} maxX={338} icon="user-round-pen" ja="実装担当" subJa="約束を切って作り検証" />

      <N x={10} y={78} w={134} h={46} ja="利用者の現場" />
      <path class="dg-line" marker-end={spEnd} d="M77 124 V160" />
      <N x={10} y={162} w={134} h={54} ja="試作を触り決める" subJa="PRの動く試作で" kind="human" />
      <path class="dg-line" marker-end={spEnd} d="M77 216 V252" />
      <N x={10} y={254} w={134} h={46} ja="要件の正本・FB" />
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M77 300 V336" />
      <N x={10} y={338} w={134} h={54} ja="問いの Issue" subJa="仮置きの点を渡す" kind="dashed" />

      <N x={204} y={74} w={134} h={54} ja="起票（AC・保証）" subJa="決めた要件・FBから" kind="impl" />
      <path class="dg-line" marker-end={spEnd} d="M271 128 V164" />
      <N x={204} y={166} w={134} h={46} ja="実装セッション" />
      <path class="dg-line" marker-end={spEnd} d="M271 212 V248" />
      <N x={204} y={250} w={134} h={54} ja="確認者・使い心地" subJa="作った者は判定しない" kind="agent" />
      <path class="dg-line" marker-end={spEnd} d="M271 304 V340" />
      <N x={204} y={342} w={134} h={46} ja="PR・マージ" kind="impl" />

      <path class="dg-line" marker-end={spEnd} d="M144 277 H160 V96 H202" />
      <path class="dg-acc wf-strong" marker-end={spEndAcc} d="M204 372 H174 V182 H146" />
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M204 196 H188 V352 H146" />
    </>
  )}

  {kind === 'spec' && (
    <>
      {/* 色は人が決める最後の更新と、そこへ入る試作の線だけに付ける。狭い幅で色の箱が並ぶと、どこが要か分からなくなる */}
      {/* 先に動く実装担当を1段上げ、問いが右から左へ渡る所を同じ高さに並べる。
          最後の更新は両方の段から入るので、横幅いっぱいの箱にして矢印をまっすぐ落とす */}
      <N x={74} y={6} w={200} h={54} ja="未確定を含む要件" subJa="回答待ちで止めない" />
      <path class="dg-line" marker-end={spEnd} d="M248 60 V90" />
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M100 60 V176" />

      <rect class="dg-box" x="190" y="92" width="156" height="218" rx="12" style="fill: none" />
      <Lane x={220} y={116} maxX={338} icon="user-round-pen" ja="実装担当" subJa="止めずに試作" />
      <N x={198} y={150} w={140} h={54} ja="仮置きで先に実装" subJa="仮置き一覧へ分離" />
      <path class="dg-line" marker-end={spEnd} d="M268 204 V240" />
      <N x={198} y={242} w={140} h={54} ja="問いの Issue 起票" subJa="出典と仮案を添付" />

      <rect class="dg-box" x="2" y="178" width="156" height="224" rx="12" stroke-dasharray="4 4" style="fill: none" />
      <Lane x={32} y={202} maxX={150} icon="user-check" ja="顧客理解担当" subJa="並行して照会・回収" />
      <N x={10} y={242} w={140} h={54} ja="依頼主へ照会" subJa="/qa-send" />
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M80 296 V332" />
      <N x={10} y={334} w={140} h={54} ja="回答を1か所に回収" subJa="/qa-collect" />

      {/* 問いを渡す */}
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M198 269 H152" />

      {/* 合流: 回答と試作の反応で、正本と実装を更新する */}
      <path class="dg-line" marker-end={spEnd} d="M80 388 V434" />
      <DgText x={88} y={422} ja="回答を反映" class="dg-small" anchor="start" />
      <path class="dg-acc wf-strong" marker-end={spEndAcc} d="M268 296 V434" />
      <DgText x={260} y={352} ja="試作で" class="dg-acctext" anchor="end" />
      <DgText x={260} y={369} ja="暗黙知が出る" class="dg-acctext" anchor="end" />
      <N x={40} y={436} w={268} h={54} ja="正本と実装を更新" subJa="/client-next · 違えば直す" kind="human" />
    </>
  )}

  {kind === 'verify' && (
    <>
      <N x={74} y={6} w={200} h={58} ja="Issue で約束を承認" subJa="/issue-draft" kind="impl" />
      <path class="dg-line" marker-end={spEnd} d="M174 64 V100" />
      <DgText x={184} y={87} ja="Issue だけ渡す" class="dg-small" anchor="start" />
      <N x={74} y={102} w={200} h={58} ja="1セッション通し実装" subJa="/issue-work · 3本並行" />

      {/* 実装から2つの検証へ分かれ、どちらも PR へ集まる */}
      <path class="dg-line" marker-end={spEnd} d="M140 160 V182 H97 V206" />
      <path class="dg-line" marker-end={spEnd} d="M208 160 V182 H259 V206" />
      <N x={22} y={208} w={150} h={58} ja="操作役 → 使い心地" subJa="screen-operator" kind="impl" />
      <N x={184} y={208} w={150} h={58} ja="別文脈の確認者" subJa="issue-verifier" kind="agent" />
      <path class="dg-line" marker-end={spEnd} d="M97 266 V290 H140 V312" />
      <path class="dg-line" marker-end={spEnd} d="M259 266 V290 H208 V312" />
      <DgText x={174} y={294} ja="合否と証拠" class="dg-small" />
      <N x={74} y={314} w={200} h={58} ja="証拠付き PR" subJa="外れた点だけ確認" kind="impl" />

      {/* 手戻りを仕組みへ戻し、次の実装に反映する */}
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M174 372 V424" />
      <DgText x={184} y={394} ja="手戻りを集計" class="dg-small" anchor="start" />
      <DgText x={184} y={410} ja="/rework-review" class="dg-small" anchor="start" />
      <N x={74} y={426} w={200} h={54} ja="Skill・Hook を更新" subJa="再発を手順と機械で防ぐ" kind="dashed" />
      <path class="dg-line wf-dashed" marker-end={spEnd} d="M74 453 H10 V131 H72" />
    </>
  )}
</svg>

{/* md 以上の横組み。幅が足りない間は横にスクロールさせる */}
<div class="-mx-6 hidden overflow-x-auto px-6 sm:-mx-8 sm:px-8 md:block">
<svg
  class="dg mx-auto block h-auto w-full min-w-[680px] max-w-[820px]"
  viewBox={viewBox}
  role="img"
  aria-label={label}
>
  <defs>
    <marker id={mk} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path class="dg-mk" d="M0 1L9 5L0 9z" />
    </marker>
    <marker id={mkAcc} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path fill="rgb(var(--color-accent))" d="M0 1L9 5L0 9z" />
    </marker>
  </defs>

  {kind === 'overview' && (
    <>
      {/* 左レーン外枠: 顧客理解担当（枠内テキスト見出し） */}
      <rect class="dg-box" x="14" y="14" width="320" height="392" rx="12" style="fill: none" />
      <Lane x={64} y={42} maxX={320} icon="user-check" ja="顧客理解担当" en="Customer Understanding" subJa="現場と試作から決める" subEn="Decides what to build" />

      {/* 右レーン外枠: 実装担当（枠内テキスト見出し） */}
      <rect class="dg-box" x="486" y="14" width="320" height="392" rx="12" style="fill: none" />
      <Lane x={536} y={42} maxX={792} icon="user-round-pen" ja="実装担当" en="Implementation" subJa="約束を切って作り検証" subEn="Builds & verifies" />

      {/* 左レーンのノード（4段） */}
      <N x={64} y={82} w={220} h={44} ja="利用者の現場" en="User's workplace" />
      <path class="dg-line" marker-end={end} d="M174 126 V154" />
      <DgText x={184} y={144} ja="観察・聞き取り" en="Observe" class="dg-small" anchor="start" />

      <N x={54} y={156} w={240} h={58} ja="試作を触り、要件を決める" en="Touch prototype & decide" subJa="社内・利用者レビュー" subEn="Internal & user review" kind="human" />
      <path class="dg-line" marker-end={end} d="M174 214 V242" />
      <N x={64} y={244} w={220} h={46} ja="要件の正本・FB" en="Canonical spec & FB" />

      <path class="dg-line wf-dashed" marker-end={end} d="M174 290 V322" />
      <N x={54} y={324} w={240} h={58} ja="問いの Issue・依頼主" en="Question Issues & client" subJa="了承と回答を回収" subEn="Collect answers" kind="dashed" />

      {/* 右レーンのノード（4段） */}
      <N x={526} y={80} w={240} h={58} ja="起票（AC・保証）" en="Draft ACs & guarantees" subJa="完了条件と壊さない約束" subEn="Done criteria & invariants" kind="impl" />
      <path class="dg-line" marker-end={end} d="M646 138 V162" />

      <N x={526} y={164} w={240} h={58} ja="実装セッション（3本並行）" en="Build sessions (3 parallel)" subJa="worktree ごとに分離" subEn="Isolated per worktree" />
      <path class="dg-line" marker-end={end} d="M646 222 V246" />

      <N x={526} y={248} w={240} h={58} ja="別文脈の確認者・使い心地" en="Verifier & UX check" subJa="作った者は判定しない" subEn="Builder never judges" kind="agent" />
      <path class="dg-line" marker-end={end} d="M646 306 V330" />

      <N x={526} y={332} w={240} h={50} ja="PR・マージ" en="PR & merge" kind="impl" />

      {/* レーン間の接続 1（上段）: 要件の正本・FB → 起票 */}
      <path class="dg-line" marker-end={end} d="M284 267 H352 V109 H524" />
      <DgText x={436} y={96} ja="決めた要件・FB" en="Requirements & FB" class="dg-small" />

      {/* レーン間の接続 2（中段）: main ==> 顧客理解担当（動く試作を見せる） */}
      <path class="dg-acc wf-strong" marker-end={endAcc} d="M526 357 H410 V185 H296" />
      <DgText x={410} y={171} ja="動く試作" en="Working prototype" class="dg-acctext" />

      {/* レーン間の接続 3（下段）: 実装セッション -.-> 問いの Issue（答えを待たずに仮置き） */}
      <path class="dg-line wf-dashed" marker-end={end} d="M526 193 H468 V370 H296" />
      <DgText x={410} y={392} ja="仮置きで進め、問いを渡す" en="Build on assumptions" class="dg-small" />
    </>
  )}

  {kind === 'spec' && (
    <>
      {/* 起点 */}
      <N x={14} y={154} w={164} h={64} ja="未確定を含む要件" en="Open requirements" subJa="回答待ちで止めない" subEn="Do not block on Q&A" />

      {/* 上段レーン枠: 顧客理解担当（上流の主役なので上に置く） */}
      <rect class="dg-box" x="218" y="16" width="420" height="142" rx="12" stroke-dasharray="4 4" style="fill: none" />
      <Lane x={258} y={43} maxX={624} icon="user-check" ja="顧客理解担当" en="Customer Understanding" subJa="並行して照会・回収" subEn="Parallel Q&A" />

      {/* 下段レーン枠: 実装担当 */}
      <rect class="dg-box" x="218" y="206" width="420" height="142" rx="12" style="fill: none" />
      <Lane x={258} y={233} maxX={624} icon="user-round-pen" ja="実装担当" en="Implementation" subJa="止めずに試作" subEn="Prototype first" />

      {/* 起点からの分岐 */}
      <path class="dg-line wf-dashed" marker-end={end} d="M178 172 H198 V98 H236" />
      <path class="dg-line" marker-end={end} d="M178 200 H198 V288 H236" />

      {/* 上段ノード（顧客理解担当がスキルを打つ） */}
      <N x={238} y={66} w={174} h={64} ja="依頼主へ照会" en="Send questions" subJa="/qa-send" subEn="/qa-send" kind="human" />
      <path class="dg-line wf-dashed" marker-end={end} d="M412 98 H442" />
      <N x={444} y={66} w={174} h={64} ja="回答を1か所に回収" en="Collect answers" subJa="/qa-collect" subEn="/qa-collect" kind="human" />

      {/* 下段ノード（実装担当） */}
      <N x={238} y={256} w={174} h={64} ja="仮置きで先に実装" en="Build on assumptions" subJa="仮置き一覧へ分離" subEn="Assumption list" />
      <path class="dg-line" marker-end={end} d="M412 288 H442" />
      <N x={444} y={256} w={174} h={64} ja="問いの Issue 起票" en="Open Question Issue" subJa="出典と仮案を添付" subEn="With source & default" />

      {/* 下から上への「問いの引き渡し」 */}
      <path class="dg-line wf-dashed" marker-end={end} d="M531 256 V160" />
      <DgText x={542} y={186} ja="問いを渡す" en="Hand off" class="dg-small" anchor="start" />

      {/* 合流: 試作レビューと正本・実装の更新 */}
      <path class="dg-line" marker-end={end} d="M618 98 H652 V168 H672" />
      <DgText x={724} y={76} ja="回答を反映 · /client-next" en="Apply · /client-next" class="dg-small" />

      <path class="dg-acc wf-strong" marker-end={endAcc} d="M618 288 H652 V204 H672" />
      <DgText x={724} y={312} ja="試作で暗黙知が出る" en="Tacit needs surface" class="dg-acctext" />

      <N x={674} y={150} w={132} h={72} ja="正本と実装を更新" en="Update spec" subJa="違えば直しのIssue" subEn="Fix if different" kind="human" />
    </>
  )}

  {kind === 'verify' && (
    <>
      {/* 1. 約束の承認 */}
      <N x={14} y={110} w={176} h={68} ja="Issue で約束を承認" en="Approve promises" subJa="/issue-draft" subEn="/issue-draft" kind="impl" />
      <path class="dg-line" marker-end={end} d="M190 144 H238" />
      <DgText x={214} y={92} ja="Issue だけ渡す" en="Fresh context" class="dg-small" />

      {/* 2. 1セッション通し実装 */}
      <N x={240} y={110} w={172} h={68} ja="1セッション通し実装" en="Single-session build" subJa="/issue-work · 3本並行" subEn="/issue-work ×3" />

      {/* 3. 三つの検証（上：操作役→使い心地、下：確認者） */}
      <path class="dg-line" marker-end={end} d="M412 130 H432 V64 H450" />
      <path class="dg-line" marker-end={end} d="M412 158 H432 V226 H450" />

      <N x={452} y={32} w={174} h={64} ja="画面操作役 → 使い心地" en="UX check" subJa="screen-operator" subEn="screen-operator" kind="impl" />
      <N x={452} y={194} w={174} h={64} ja="別文脈の確認者" en="Isolated Verifier" subJa="issue-verifier" subEn="issue-verifier" kind="agent" />

      {/* 4. PRとマージ */}
      <path class="dg-line" marker-end={end} d="M626 64 H646 V130 H664" />
      <path class="dg-line" marker-end={end} d="M626 226 H646 V158 H664" />
      <DgText x={636} y={276} ja="合否と証拠" en="Pass/fail & evidence" class="dg-small" />

      <N x={666} y={110} w={140} h={68} ja="証拠付き PR" en="Evidence PR" subJa="外れた点だけ確認" subEn="Check failures" kind="impl" />

      {/* 下段の還流ループ: 手戻りを仕組みへ戻す */}
      <path class="dg-line wf-dashed" marker-end={end} d="M736 178 V324 H520" />
      <DgText x={636} y={348} ja="手戻りを集計 · /rework-review" en="Collect rework · /rework-review" class="dg-small" />
      <N x={314} y={296} w={204} h={54} ja="Skill・Hook を更新" en="Update Skills & Hooks" subJa="再発を手順と機械で防ぐ" subEn="Prevent repeat failures" kind="dashed" />
      <path class="dg-line wf-dashed" marker-end={end} d="M314 324 H284 V180" />
    </>
  )}
</svg>
</div>
