---
import N from './WfNode.astro';
import DgText from '../services/DgText.astro';
import { getLucideIcon } from '../../lib/lucide';

interface Props {
  kind: 'overview' | 'spec' | 'verify';
  label: string;
}
const { kind, label } = Astro.props;

const mk = `wf-mk-${kind}`;
const mkAcc = `wf-mk-acc-${kind}`;
const end = `url(#${mk})`;
const endAcc = `url(#${mkAcc})`;

const viewBox = {
  overview: '0 0 820 420',
  spec: '0 0 820 376',
  verify: '0 0 820 368',
}[kind];
---
<svg
  class="dg mx-auto block h-auto w-full max-w-[820px]"
  viewBox={viewBox}
  role="img"
  aria-label={label}
>
  <defs>
    <marker id={mk} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path class="dg-mk" d="M0 1L9 5L0 9z" />
    </marker>
    <marker id={mkAcc} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path fill="rgb(var(--color-accent))" d="M0 1L9 5L0 9z" />
    </marker>
  </defs>

  {kind === 'overview' && (
    <>
      {/* 左レーン外枠: 顧客理解担当（枠内テキスト見出し） */}
      <rect class="dg-box" x="14" y="14" width="320" height="392" rx="12" style="fill: none" />
      <svg class="dg-acc" x="42" y="29" width="16" height="16" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon('user-check')} />
      <DgText x={64} y={42} ja="顧客理解担当" en="Customer Understanding" class="dg-acctext" anchor="start" />
      <DgText x={64} y={59} ja="現場と試作から要件を決める" en="Decides what to build" class="dg-small" anchor="start" />

      {/* 右レーン外枠: 実装担当（枠内テキスト見出し） */}
      <rect class="dg-box" x="486" y="14" width="320" height="392" rx="12" style="fill: none" />
      <svg class="dg-acc" x="514" y="29" width="16" height="16" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon('user-round-pen')} />
      <DgText x={536} y={42} ja="実装担当" en="Implementation" class="dg-acctext" anchor="start" />
      <DgText x={536} y={59} ja="約束を切って作り、別文脈で検証" en="Builds & verifies" class="dg-small" anchor="start" />

      {/* 左レーンのノード（4段） */}
      <N x={64} y={82} w={220} h={44} ja="利用者の現場" en="User's workplace" kind="term" />
      <path class="dg-line" marker-end={end} d="M174 126 V154" />
      <DgText x={184} y={144} ja="観察・聞き取り" en="Observe" class="dg-small" anchor="start" />

      <N x={54} y={156} w={240} h={58} ja="試作を触り、要件を決める" en="Touch prototype & decide" subJa="社内・利用者レビュー" subEn="Internal & user review" kind="human" />
      <path class="dg-line" marker-end={end} d="M174 214 V242" />
      <N x={64} y={244} w={220} h={46} ja="要件の正本・FB" en="Canonical spec & FB" />

      <path class="dg-line wf-dashed" marker-end={end} d="M174 290 V322" />
      <N x={54} y={324} w={240} h={58} ja="問いの Issue・依頼主" en="Question Issues & client" subJa="了承と回答を回収" subEn="Collect answers" kind="dashed" />

      {/* 右レーンのノード（4段） */}
      <N x={526} y={80} w={240} h={58} ja="起票（AC・保証）" en="Draft Issue (AC & Guarantees)" subJa="完了条件と壊さない約束" subEn="Done criteria & invariants" kind="human" />
      <path class="dg-line" marker-end={end} d="M646 138 V162" />

      <N x={526} y={164} w={240} h={58} ja="実装セッション（3本並行）" en="Build sessions (3 parallel)" subJa="worktree ごとに分離" subEn="Isolated per worktree" />
      <path class="dg-line" marker-end={end} d="M646 222 V246" />

      <N x={526} y={248} w={240} h={58} ja="別文脈の確認者・使い心地" en="Verifier & UX check" subJa="作った者は判定しない" subEn="Builder never judges" kind="agent" />
      <path class="dg-line" marker-end={end} d="M646 306 V330" />

      <N x={526} y={332} w={240} h={50} ja="PR・マージ" en="PR & merge" kind="human" />

      {/* レーン間の接続 1（上段）: 要件の正本・FB → 起票 */}
      <path class="dg-line" marker-end={end} d="M284 267 H352 V109 H524" />
      <DgText x={436} y={96} ja="決めた要件・FB" en="Requirements & FB" class="dg-small" />

      {/* レーン間の接続 2（中段）: main ==> 顧客理解担当（動く試作を見せる） */}
      <path class="dg-acc wf-strong" marker-end={endAcc} d="M526 357 H410 V185 H296" />
      <DgText x={410} y={171} ja="動く試作" en="Working prototype" class="dg-acctext" />

      {/* レーン間の接続 3（下段）: 実装セッション -.-> 問いの Issue（答えを待たずに仮置き） */}
      <path class="dg-line wf-dashed" marker-end={end} d="M526 193 H468 V370 H296" />
      <DgText x={410} y={392} ja="仮置きで進め、問いを渡す" en="Build on assumptions" class="dg-small" />
    </>
  )}

  {kind === 'spec' && (
    <>
      {/* 起点 */}
      <N x={14} y={154} w={164} h={64} ja="未確定を含む要件" en="Open requirements" subJa="回答待ちで止めない" subEn="Do not block on Q&A" kind="term" />

      {/* 上段レーン枠: 実装担当 */}
      <rect class="dg-box" x="218" y="16" width="420" height="142" rx="12" style="fill: none" />
      <svg class="dg-acc" x="236" y="31" width="15" height="15" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon('user-round-pen')} />
      <DgText x={258} y={43} ja="実装担当（止めずに試作）" en="Implementation (Prototype first)" class="dg-acctext" anchor="start" />

      {/* 下段レーン枠: 顧客理解担当 */}
      <rect class="dg-box" x="218" y="206" width="420" height="142" rx="12" stroke-dasharray="4 4" style="fill: none" />
      <svg class="dg-acc" x="236" y="221" width="15" height="15" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon('user-check')} />
      <DgText x={258} y={233} ja="顧客理解担当（並行して照会・回収）" en="Customer Understanding (Parallel Q&A)" class="dg-acctext" anchor="start" />

      {/* 起点からの分岐 */}
      <path class="dg-line" marker-end={end} d="M178 172 H198 V98 H236" />
      <path class="dg-line wf-dashed" marker-end={end} d="M178 200 H198 V288 H236" />

      {/* 上段ノード（実装担当） */}
      <N x={238} y={66} w={174} h={64} ja="① 仮置きで先に実装" en="① Build on assumptions" subJa="仮置き一覧へ分離" subEn="Track in assumption list" />
      <path class="dg-line" marker-end={end} d="M412 98 H442" />
      <N x={444} y={66} w={174} h={64} ja="② 問いの Issue 起票" en="② Open Question Issue" subJa="出典と仮案を添付" subEn="With source & default" />

      {/* 上から下への「問いの引き渡し」 */}
      <path class="dg-line wf-dashed" marker-end={end} d="M531 130 V204" />
      <DgText x={542} y={178} ja="問いを渡す" en="Hand off" class="dg-small" anchor="start" />

      {/* 下段ノード（顧客理解担当がスキルを打つ） */}
      <N x={238} y={256} w={174} h={64} ja="③ 依頼主へ照会" en="③ Send questions" subJa="/qa-send" subEn="/qa-send" kind="human" />
      <path class="dg-line wf-dashed" marker-end={end} d="M412 288 H442" />
      <N x={444} y={256} w={174} h={64} ja="④ 回答を1か所に回収" en="④ Collect answers" subJa="/qa-collect" subEn="/qa-collect" kind="human" />

      {/* 合流: 試作レビューと正本・実装の更新 */}
      <path class="dg-acc wf-strong" marker-end={endAcc} d="M618 98 H652 V168 H672" />
      <DgText x={724} y={76} ja="試作で暗黙知が出る" en="Tacit needs surface" class="dg-acctext" />

      <path class="dg-line" marker-end={end} d="M618 288 H652 V204 H672" />
      <DgText x={724} y={310} ja="回答を反映 (/client-next)" en="Apply (/client-next)" class="dg-small" />

      <N x={674} y={150} w={132} h={72} ja="正本と実装を更新" en="Update spec & code" subJa="違えば直しのIssue" subEn="Fix Issue if different" kind="human" />
    </>
  )}

  {kind === 'verify' && (
    <>
      {/* 1. 約束の承認 */}
      <N x={14} y={110} w={176} h={68} ja="① Issue で約束を承認" en="① Approve contracts" subJa="/issue-draft" subEn="/issue-draft" kind="human" />
      <path class="dg-line" marker-end={end} d="M190 144 H238" />
      <DgText x={214} y={92} ja="Issue だけ渡す" en="Fresh context" class="dg-small" />

      {/* 2. 1セッション通し実装 */}
      <N x={240} y={110} w={172} h={68} ja="② 1セッション通し実装" en="② Single-session build" subJa="/issue-work (3本並行)" subEn="/issue-work (3 parallel)" />

      {/* 3. 三つの検証（上：操作役→使い心地、下：確認者） */}
      <path class="dg-line" marker-end={end} d="M412 130 H432 V64 H450" />
      <path class="dg-line" marker-end={end} d="M412 158 H432 V226 H450" />

      <N x={452} y={32} w={174} h={64} ja="画面操作役 → 使い心地" en="Screen op → UX check" subJa="screen-operator" subEn="screen-operator" kind="human" />
      <N x={452} y={194} w={174} h={64} ja="③ 確認者（Verifier）" en="③ Verifier" subJa="issue-verifier (別文脈)" subEn="issue-verifier (isolated)" kind="agent" />

      {/* 4. PRとマージ */}
      <path class="dg-line" marker-end={end} d="M626 64 H646 V130 H664" />
      <path class="dg-line" marker-end={end} d="M626 226 H646 V158 H664" />
      <DgText x={636} y={276} ja="合否と証拠" en="Pass/fail & evidence" class="dg-small" />

      <N x={666} y={110} w={140} h={68} ja="④ 証拠付き PR" en="④ Evidence PR" subJa="外れた点だけ確認" subEn="Review failures only" kind="human" />

      {/* 下段の還流ループ: 手戻りを仕組みへ戻す */}
      <path class="dg-line wf-dashed" marker-end={end} d="M736 178 V324 H520" />
      <DgText x={636} y={348} ja="手戻りを集計 (/rework-review)" en="Collect rework (/rework-review)" class="dg-small" />
      <N x={314} y={296} w={204} h={54} ja="Skill・Hook を更新" en="Update Skills & Hooks" subJa="再発を手順と機械で防ぐ" subEn="Prevent repeat failures" kind="dashed" />
      <path class="dg-line wf-dashed" marker-end={end} d="M314 324 H284 V180" />
    </>
  )}
</svg>
