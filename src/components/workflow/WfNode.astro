---
import DgText from '../services/DgText.astro';
import { getLucideIcon } from '../../lib/lucide';
import { textWidth } from '../../lib/svg-text';

// box: 通常の工程や成果物、human: 顧客理解担当（人）が判断する所、
// impl: 実装担当（人）が判断する所、agent: 文脈を切った別エージェント、
// dashed: 仮置きや未確定の経路
type Kind = 'box' | 'human' | 'impl' | 'agent' | 'dashed';

interface Props {
  x: number;
  y: number;
  w: number;
  h?: number;
  ja: string;
  en?: string;
  subJa?: string;
  subEn?: string;
  kind?: Kind;
}
const { x, y, w, h = 48, ja, en = ja, subJa, subEn = subJa, kind = 'box' } = Astro.props;

const isHuman = kind === 'human' || kind === 'impl';
const icon =
  kind === 'human'
    ? 'user-check'
    : kind === 'impl'
      ? 'user-round-pen'
      : kind === 'agent'
        ? 'bot'
        : null;
const iconSize = 15;
const gap = 6;

const jaW = textWidth(ja, 13);
const enW = textWidth(en, 13);
const leftJa = x + (w - (icon ? iconSize + gap + jaW : jaW)) / 2;
const leftEn = x + (w - (icon ? iconSize + gap + enW : enW)) / 2;
const cxJa = icon ? leftJa + iconSize + gap + jaW / 2 : x + w / 2;
const cxEn = icon ? leftEn + iconSize + gap + enW / 2 : x + w / 2;
const mainY = subJa ? y + h / 2 - 5 : y + h / 2 + 4.5;
const subY = y + h / 2 + 16;

const rectClass = isHuman
  ? 'dg-accbox'
  : kind === 'dashed'
    ? 'dg-box wf-goto'
    : 'dg-box';
const textClass = isHuman
  ? 'dg-acctext'
  : kind === 'dashed'
    ? 'dg-muted-text'
    : 'dg-text';
const rx = 8;
---
<g class="wf-node">
  <rect class={rectClass} x={x} y={y} width={w} height={h} rx={rx} />
  {icon && (
    <>
      <svg
        class:list={[isHuman ? 'dg-acc' : 'dg-line', 'lang-ja']}
        x={leftJa}
        y={mainY - 12}
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        style="stroke-width: 2"
        set:html={getLucideIcon(icon)}
      />
      <svg
        class:list={[isHuman ? 'dg-acc' : 'dg-line', 'lang-en']}
        x={leftEn}
        y={mainY - 12}
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        style="stroke-width: 2"
        set:html={getLucideIcon(icon)}
      />
    </>
  )}
  <text class:list={[textClass, 'lang-ja']} x={cxJa} y={mainY} text-anchor="middle">{ja}</text>
  <text class:list={[textClass, 'lang-en']} x={cxEn} y={mainY} text-anchor="middle">{en}</text>
  {subJa && <DgText x={x + w / 2} y={subY} ja={subJa} en={subEn ?? subJa} class="dg-small" />}
</g>
