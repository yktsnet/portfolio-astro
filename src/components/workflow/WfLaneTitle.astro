---
import { getLucideIcon } from '../../lib/lucide';
import { textWidth } from '../../lib/svg-text';

// レーン見出し（アイコン・担当名・補足）。補足は担当名の右に並べ、
// maxX までに収まらない言語だけ担当名の下の行へ送る
interface Props {
  x: number;
  y: number;
  maxX: number;
  icon: string;
  ja: string;
  en: string;
  subJa: string;
  subEn: string;
}
const { x, y, maxX, icon, ja, en, subJa, subEn } = Astro.props;

const place = (title: string, sub: string) => {
  const subX = x + textWidth(title, 13) + 12;
  const text = `— ${sub}`;
  return subX + textWidth(text, 11.5) <= maxX ? { x: subX, y, text } : { x, y: y + 17, text: sub };
};
const subs = { ja: place(ja, subJa), en: place(en, subEn) };
---
<svg class="dg-acc" x={x - 22} y={y - 13} width="16" height="16" viewBox="0 0 24 24" style="stroke-width: 2" set:html={getLucideIcon(icon)} />
<text class="dg-acctext lang-ja" x={x} y={y}>{ja}</text>
<text class="dg-acctext lang-en" x={x} y={y}>{en}</text>
<text class="dg-small lang-ja" x={subs.ja.x} y={subs.ja.y}>{subs.ja.text}</text>
<text class="dg-small lang-en" x={subs.en.x} y={subs.en.y}>{subs.en.text}</text>
