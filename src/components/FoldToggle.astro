---
// スマホで、囲む [data-fold-group] の中の .fold-body をまとめて開閉するボタン。md 以上では出さないので、文言は日本語だけで書く
import LucideIcon from './LucideIcon.astro';

interface Props {
  // box: 枠付きのボタン、band: カードの中の帯（罫線と余白は呼ぶ側で足す）
  variant?: 'box' | 'band';
  class?: string;
}
const { variant = 'box', class: className } = Astro.props;
// slot が無ければ、開閉で言葉を入れ替える既定の文言を出す
const hasLabel = Astro.slots.has('default');
---
<button
  type="button"
  data-fold-toggle
  aria-expanded="false"
  class:list={[
    'group relative z-10 flex w-full items-center justify-between gap-3 text-left type-caption font-semibold text-zinc-700 md:hidden dark:text-poi-text',
    variant === 'box' && 'rounded-lg border border-zinc-200 px-4 py-2.5 dark:border-poi-border/60',
    className,
  ]}
>
  {hasLabel ? (
    <span class="min-w-0 flex-1"><slot /></span>
  ) : (
    <span>
      <span class="group-aria-expanded:hidden">説明を開く</span>
      <span class="hidden group-aria-expanded:inline">説明を閉じる</span>
    </span>
  )}
  <LucideIcon name="chevron-down" class="h-4 w-4 shrink-0 text-zinc-400 transition-transform duration-200 group-aria-expanded:rotate-180 dark:text-poi-muted" />
</button>

<script>
  // ボタンが開く中身より下にあると、開閉のままではブラウザ次第で中身が画面の上へ外れるか、ボタンが指の下から逃げる。
  // 開いて最初の中身が画面より上にあればそこへ移り、閉じたらボタンを押した位置に戻す。
  // スクロールアンカリングの有無に左右されないよう、開閉の後の配置から絶対位置を出して scrollTo する
  const headerBottom = () => document.getElementById('main-header')?.getBoundingClientRect().bottom ?? 0;
  const GAP = 12;

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-fold-toggle]')) {
    btn.addEventListener('click', () => {
      const group = btn.closest('[data-fold-group]')!;
      const btnTopBefore = btn.getBoundingClientRect().top;
      const open = group.toggleAttribute('data-open');
      btn.setAttribute('aria-expanded', String(open));

      if (open) {
        // Fold の見出しごと見せるため、.fold-body ではなくそれを包む Fold の要素を基準にする
        const first = group.querySelector('.fold-body')?.parentElement;
        if (!first) return;
        const top = first.getBoundingClientRect().top;
        const viewTop = headerBottom() + GAP;
        // ボタンより下で開く組（Career など）は、そのままで中身が見える
        if (top >= viewTop) return;
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: window.scrollY + top - viewTop, behavior: smooth ? 'smooth' : 'auto' });
      } else {
        window.scrollTo({ top: window.scrollY + btn.getBoundingClientRect().top - btnTopBefore, behavior: 'auto' });
      }
    });
  }
</script>
