---
---
<lang-toggle>
  <button
    type="button"
    class="relative flex h-8 px-2 items-center justify-center rounded-md font-mono type-caption text-zinc-700 transition-colors hover:text-poi-accent dark:text-poi-text dark:hover:text-poi-accent select-none"
    aria-label="Toggle language"
  >
    <span class="lang-label-ja font-semibold text-poi-accent">JA</span>
    <span class="mx-1 text-zinc-300 dark:text-poi-border">/</span>
    <span class="lang-label-en text-zinc-400 dark:text-poi-muted/50 hover:text-zinc-700 dark:hover:text-poi-text">EN</span>
  </button>
</lang-toggle>

<script>
  class LangToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector<HTMLButtonElement>("button");

      if (button) {
        const setActive = (label: Element | null, active: boolean) => {
          for (const c of ["font-semibold", "text-poi-accent"]) label?.classList.toggle(c, active);
          for (const c of ["text-zinc-400", "dark:text-poi-muted/50"]) label?.classList.toggle(c, !active);
        };
        const updateUI = (lang: string) => {
          setActive(this.querySelector(".lang-label-ja"), lang !== "en");
          setActive(this.querySelector(".lang-label-en"), lang === "en");
        };

        const currentLang = document.documentElement.dataset.lang || "ja";
        updateUI(currentLang);

        button.addEventListener("click", () => {
          const newLang = document.documentElement.dataset.lang === "en" ? "ja" : "en";
          document.documentElement.dataset.lang = newLang;
          localStorage.setItem("portfolio_lang", newLang);
          updateUI(newLang);
        });
      }
    }
  }

  if (!customElements.get("lang-toggle")) {
    customElements.define("lang-toggle", LangToggle);
  }
</script>
