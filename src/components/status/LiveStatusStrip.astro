---
// トップ（Works）1画面目に置く2行のライブメトリクス帯。
// 「動いている証拠」を先頭に薄く出しつつ、詳説（InfrastructureBlueprint）へ誘導する。
// 数値は SV6StatusChart.astro と同じ /api/sv6-status をクライアント側 fetch で取得する。
---

<div
  id="live-status-strip"
  class="mt-6 rounded-lg border border-zinc-200 dark:border-poi-border/60 bg-zinc-50/40 dark:bg-poi-panel/10 px-4 py-2.5 font-mono text-xs"
>
  {/* 1行目: ステータス */}
  <div class="flex items-center gap-1.5 text-zinc-700 dark:text-poi-focus">
    <span class="h-2 w-2 rounded-full bg-poi-accent animate-pulse"></span>
    Shared Host&nbsp;&mdash;&nbsp;Online
  </div>

  {/* 2行目: メトリクス（常時表示、値はfetch後に更新） + Detailsリンク */}
  <div class="flex items-center justify-between gap-4 mt-1.5 text-zinc-500 dark:text-poi-muted">
    <div class="flex items-center gap-4">
      <span>
        <span class="lang-ja">稼働</span>
        <span class="lang-en">Uptime</span>
        <span id="live-status-uptime" class="text-zinc-900 dark:text-poi-focus font-semibold ml-1">&mdash;</span>
      </span>
      <span>
        CPU <span id="live-status-cpu" class="text-zinc-900 dark:text-poi-focus font-semibold">&mdash;</span>
      </span>
      <span>
        <span class="lang-ja">メモリ</span>
        <span class="lang-en">Mem</span>
        <span id="live-status-mem" class="text-zinc-900 dark:text-poi-focus font-semibold ml-1">&mdash;</span>
      </span>
    </div>
    <a
      href="#infrastructure"
      class="inline-flex items-center gap-1 text-light-accent dark:text-poi-accent hover:underline underline-offset-2 shrink-0"
    >
      Details &darr;
    </a>
  </div>
</div>

<script>
  import type { SV6StatusPayload } from "../../lib/sv6-status";
  import { latestLoadPercent, latestAvailablePercent, uptimeDays } from "../../lib/sv6-status";

  let cachedData: SV6StatusPayload | null = null;

  function updateMetrics() {
    if (!cachedData) return;
    const days = uptimeDays(cachedData);
    const cpu = Math.round(latestLoadPercent(cachedData));
    const mem = Math.round(100 - latestAvailablePercent(cachedData));

    const uptimeEl = document.getElementById("live-status-uptime");
    const cpuEl = document.getElementById("live-status-cpu");
    const memEl = document.getElementById("live-status-mem");

    const isEn = document.documentElement.dataset.lang === "en";
    if (uptimeEl) uptimeEl.textContent = isEn ? `${days}d` : `${days}日`;
    if (cpuEl) cpuEl.textContent = `${cpu}%`;
    if (memEl) memEl.textContent = `${mem}%`;
  }

  const observer = new MutationObserver((mutations) => {
    for (const m of mutations) {
      if (m.attributeName === "data-lang") {
        updateMetrics();
      }
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["data-lang"] });

  async function loadAndRender() {
    try {
      const res = await fetch("/api/sv6-status");
      if (!res.ok) throw new Error(`api ${res.status}`);
      const data = (await res.json()) as SV6StatusPayload;
      cachedData = data;
      updateMetrics();
    } catch {
      // 取得失敗・開発サーバー時（KV未接続）はダッシュ表示のまま。
      // 帯は #infrastructure へのアンカーとしてのみ機能させる。
    }
  }

  document.addEventListener("DOMContentLoaded", loadAndRender);
</script>
