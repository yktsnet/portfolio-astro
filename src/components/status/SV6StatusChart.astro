---
// SV6（自宅サーバー・複数プロダクト同居ホスト）の稼働実態を示すライブメトリクス。
// HostingArchitecture.astro のトグルから開かれたタイミングで /api/sv6-status を
// 遅延フェッチし、統計カード + SVGチャート（ハートビート + Load%/Available%の折れ線 + 凡例）を描画する。
---

<div id="sv6-chart-root">
  <!-- 統計カード3枚（JSで描画、データ到着まで空） -->
  <div id="sv6-stat-cards"></div>

  <div
    id="sv6-chart-display"
    class="rounded-xl border border-zinc-200 dark:border-poi-border bg-white dark:bg-poi-panel px-4 py-5 sm:px-6"
  >
    <div class="h-[160px] flex items-center justify-center">
      <span class="font-mono text-xs text-zinc-400 dark:text-poi-muted/40">読み込み中…</span>
    </div>
  </div>

  <!-- フッター（スペック + 更新日時） -->
  <p id="sv6-footer-line" class="mt-3 font-mono text-[11px] text-zinc-400 dark:text-poi-muted/60">
    Intel Core i5-8365U (4C/8T) ・ 8コア ・ 8GB RAM
  </p>
  <p id="sv6-footer-updated" class="mt-1 font-mono text-[10px] text-zinc-400 dark:text-poi-muted/40"></p>
</div>

<script>
  import type { SV6StatusPayload } from "../../lib/sv6-status";
  import {
    loadPercentSeries,
    availablePercentSeries,
    uptimeDays,
  } from "../../lib/sv6-status";

  const NS = "http://www.w3.org/2000/svg";
  const isDark = () => document.documentElement.classList.contains("dark");

  const C = () =>
    isDark()
      ? {
          heartbeat: "#5de4c7",
          load: "#5de4c7",
          available: "#89ddff",
          grid: "#ffffff10",
          axis: "#ffffff55",
        }
      : {
          heartbeat: "#d0679d",
          load: "#d0679d",
          available: "#818cf8",
          grid: "#00000010",
          axis: "#00000066",
        };

  function el(tag: string, attrs: Record<string, string | number> = {}) {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    return e;
  }
  function txt(content: string, attrs: Record<string, string | number> = {}) {
    const e = el("text", {
      fill: C().axis,
      "font-size": 11,
      "font-family": '"Fira Code", "IBM Plex Mono", monospace',
      ...attrs,
    });
    e.textContent = content;
    return e;
  }

  /* ── 統計カード3枚 ── */
  function renderStatCards(data: SV6StatusPayload) {
    const cardsEl = document.getElementById("sv6-stat-cards");
    if (!cardsEl) return;

    const days = uptimeDays(data);
    const loadSeries = loadPercentSeries(data);
    const availSeries = availablePercentSeries(data);
    const maxLoad = loadSeries.length ? Math.max(...loadSeries) : 0;
    const minAvail = availSeries.length ? Math.min(...availSeries) : 0;
    const loadCeil = Math.max(5, Math.ceil(maxLoad / 5) * 5);
    const availFloor = Math.min(90, Math.floor(minAvail / 10) * 10);
    const usageCeil = 100 - availFloor;

    const cards = [
      { value: `${days}日`, label: "連続稼働" },
      { value: `<${loadCeil}%`, label: "CPU負荷上限" },
      { value: `<${usageCeil}%`, label: "メモリ使用上限" },
    ];

    cardsEl.className = "grid grid-cols-3 divide-x divide-zinc-200/60 dark:divide-poi-border/40 mb-4";
    cardsEl.innerHTML = cards
      .map(
        (c) => `
        <div class="text-center py-2.5">
          <div class="font-mono text-base sm:text-lg font-bold text-light-accent dark:text-poi-accent leading-none">${c.value}</div>
          <div class="font-mono text-[10px] text-zinc-400 dark:text-poi-muted/50 mt-1.5">${c.label}</div>
        </div>`
      )
      .join("");
  }

  /* ── SVGチャート（Heartbeat圧縮 + 折れ線 + 凡例） ── */
  function buildChart(data: SV6StatusPayload): SVGElement {
    const W = 600, H = 190, PL = 44, PR = 12, PT = 28, PB = 28;
    const cW = W - PL - PR, cH = H - PT - PB;
    const svg = el("svg", { viewBox: `0 0 ${W} ${H}`, width: "100%" }) as unknown as SVGElement;

    // --- Heartbeat（ラベルとドットを1行に圧縮） ---
    const heartbeats = data.heartbeats ?? [];
    const n = heartbeats.length;
    const dotY = 12;

    svg.appendChild(txt("HEARTBEAT", { x: PL, y: dotY + 3, "font-size": 9, opacity: 0.5 }));
    if (n > 0) {
      const dotStartX = PL + 76;
      const dotEndX = PL + cW;
      const dotSpan = dotEndX - dotStartX;
      heartbeats.forEach((_t, i) => {
        const x = n === 1 ? dotStartX + dotSpan / 2 : dotStartX + (i / (n - 1)) * dotSpan;
        svg.appendChild(el("circle", { cx: x, cy: dotY, r: 2.5, fill: C().heartbeat, opacity: 0.85 }));
      });
    }

    // --- 0-100% 共有軸のグリッド ---
    [0, 0.5, 1].forEach((r) => {
      const y = PT + r * cH;
      svg.appendChild(el("line", { x1: PL, x2: PL + cW, y1: y, y2: y, stroke: C().grid }));
      svg.appendChild(txt(`${Math.round(100 * (1 - r))}%`, { x: PL - 6, y: y + 4, "text-anchor": "end" }));
    });

    // --- 折れ線 ---
    const loadSeries = loadPercentSeries(data);
    const memUsageSeries = availablePercentSeries(data).map((v) => 100 - v);

    function pointsFor(series: number[]): string {
      const len = series.length;
      if (!len) return "";
      return series
        .map((v, i) => {
          const x = len === 1 ? PL + cW / 2 : PL + (i / (len - 1)) * cW;
          const y = PT + cH * (1 - v / 100);
          return `${x},${y}`;
        })
        .join(" ");
    }

    if (memUsageSeries.length) {
      svg.appendChild(
        el("polyline", { points: pointsFor(memUsageSeries), fill: "none", stroke: C().available, "stroke-width": 2 })
      );
    }
    if (loadSeries.length) {
      svg.appendChild(
        el("polyline", { points: pointsFor(loadSeries), fill: "none", stroke: C().load, "stroke-width": 2 })
      );
    }
    if (!loadSeries.length && !memUsageSeries.length) {
      svg.appendChild(txt("no metrics data", { x: PL, y: PT + cH / 2 }));
    }

    // --- 凡例（チャート下部） ---
    const legendY = H - 8;
    svg.appendChild(el("line", { x1: PL, x2: PL + 16, y1: legendY, y2: legendY, stroke: C().load, "stroke-width": 2 }));
    svg.appendChild(txt("CPU Load%", { x: PL + 20, y: legendY + 3.5, "font-size": 9, opacity: 0.7 }));
    const legendX2 = PL + 116;
    svg.appendChild(el("line", { x1: legendX2, x2: legendX2 + 16, y1: legendY, y2: legendY, stroke: C().available, "stroke-width": 2 }));
    svg.appendChild(txt("Memory Usage%", { x: legendX2 + 20, y: legendY + 3.5, "font-size": 9, opacity: 0.7 }));

    return svg;
  }

  /* ── フッター（スペック行 + 更新日時行） ── */
  function renderFooter(data: SV6StatusPayload) {
    const line = document.getElementById("sv6-footer-line");
    if (line) {
      const swap = (data.swap_used_percent ?? 0).toFixed(1);
      const containers = data.containers_running ?? "—";
      line.textContent = `i5-8365U (4C/8T) ・ 8コア ・ 8GB RAM ・ Swap ${swap}% ・ コンテナ${containers}個稼働中`;
    }
    const updated = document.getElementById("sv6-footer-updated");
    if (updated && data.updated_at) {
      const d = new Date(data.updated_at);
      const jst = d.toLocaleString("ja-JP", {
        year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", hour12: false,
        timeZone: "Asia/Tokyo",
      });
      updated.textContent = `最終更新: ${jst} JST`;
    }
  }

  /* ── 描画エントリ ── */
  function render(data: SV6StatusPayload) {
    renderStatCards(data);
    const display = document.getElementById("sv6-chart-display");
    if (display) {
      display.innerHTML = "";
      display.appendChild(buildChart(data));
    }
    renderFooter(data);
  }

  function renderFallback() {
    const display = document.getElementById("sv6-chart-display");
    if (display) {
      display.innerHTML = `
        <div class="h-[160px] flex flex-col items-center justify-center gap-2">
          <span class="font-mono text-xs text-zinc-400 dark:text-poi-muted/60">データを取得できませんでした</span>
        </div>`;
    }
  }

  let loaded = false;
  let loading = false;

  async function loadAndRender() {
    if (loaded || loading) return;
    loading = true;
    try {
      const res = await fetch("/api/sv6-status");
      if (!res.ok) throw new Error(`api ${res.status}`);
      const data = (await res.json()) as SV6StatusPayload;
      render(data);
      loaded = true;
    } catch {
      renderFallback();
    } finally {
      loading = false;
    }
  }

  function init() {
    // HostingArchitecture.astro 側のトグルが初めて開かれたタイミングでフェッチする
    const panel = document.getElementById("sv6-status-panel");
    if (panel) {
      panel.addEventListener("sv6-status:open", loadAndRender, { once: true });
    }
  }

  document.addEventListener("DOMContentLoaded", init);
</script>
