---
import { works } from '../data/works';
import { getLucideIcon } from '../lib/lucide';

/** 証拠として引くもの。works.ts に無いものは icon / href を直接持つ */
type Cite = { name: string; icon?: string; href?: string };

type Slide = {
  step: 1 | 2 | 3;
  ja: string;
  en: string;
  bodyJa: string;
  bodyEn: string;
  icon: string;
  cites: Cite[];
};

const slides: Slide[] = [
  {
    step: 1,
    ja: '事業の数字から直すべきものを決め、',
    en: "Find what's worth fixing in the numbers,",
    bodyJa:
      '勤怠を自動化してほしい、という依頼から始まってはいない。マンション管理事業者にコンサルとして入り、まず会計を見た。人件費が6割で、その中身を追うと、勤務時間の申告に詐称が出てきた。勤怠は自己申告、給与計算は毎回手書きで、突き合わせる手段がないので、起きていても気づけない。人件費を議論する土台が無いということなので、正確な記録が最初の一手になった。声の大きさではなく、原価の構造から順番を決めている。',
    bodyEn:
      "This did not start with a request to automate attendance. I came into a property management company as a consultant and looked at the books first. Labor was 60%, and following it down, hours were being misreported. Attendance was self-reported and payroll was worked out by hand, with nothing to check the reports against, so it could go on unnoticed. There was no ground to discuss labor cost on, and accurate records became the first move. The order is set by the cost structure, not by who complains loudest.",
    icon: 'id-card',
    cites: [{ name: 'NFC Attendance Kit' }],
  },
  {
    step: 2,
    ja: '現場のやり方を変えずに作り、',
    en: 'build it without changing how people already work,',
    bodyJa:
      '現場は Excel の帳票で回っていた。入居契約書を従業員が毎回コピーして書き換えていて、春の入退去シーズンに負荷が集中していた。狙いは繰り返している転記をなくすことなので、フォームに氏名や部屋番号を入れれば同じ帳票が埋まり、PDF まで出る経路を作った。そのうえで、共有フォルダの Excel を開いて保存する従来の経路も残した。様式もファイル形式も変えておらず、保存した時点で PDF になる。どちらから出た書類も同じ一覧から探せる。使われ続けるかどうかは、覚え直しを強いたかどうかで決まる。',
    bodyEn:
      'The office ran on Excel forms. Staff copied and rewrote the same tenancy paperwork every time, and the load piled up in the spring move-in season. The point was to remove that repeated transcription, so I built a route where filling in a name and a room number fills the same form and produces the PDF. Alongside it, the old route stayed: open the Excel file in the shared folder and save it. The layout and the file format are untouched, and the PDF appears the moment it is saved. Documents from either route are searchable in one list. Whether a system keeps being used comes down to whether anyone was made to relearn their work.',
    icon: 'user-pen',
    cites: [{ name: 'Excel Kanri' }],
  },
  {
    step: 3,
    ja: '人が回せる形にして渡して残す。',
    en: 'and hand it over so the team can keep it running on their own.',
    bodyJa:
      'ここだけ相手が個人ではなくチームと会社になる。自分の開発は型を決めて標準化していて、同じものを組織にも入れられる。ただし全部は配らない。型にするのは、人の判断を落とさせない、セッションを越えて残す、担当者が替わっても揃う、この三つに当たるものだけで、その場で頼めば足りることは型にしない。相手の規模に合わせて粒度を落とし、最低限だけを整えて渡す。1コマンドで取り込める単位にしてあるので、導入そのものに時間を使わせない。',
    bodyEn:
      'Here the counterpart is a team and a company rather than one person. My own development is standardized around a set of forms, and the same set goes into an organization. Not all of it, though. Something becomes a standard only when it keeps a human decision from being skipped, has to survive across sessions, or has to come out the same when the person changes; anything I can ask for on the spot stays out. I scale it to the size of the team and hand over the minimum that works, packaged as units a repository pulls in with one command, so nobody spends time on the rollout itself.',
    icon: 'package-open',
    cites: [
      { name: 'dotfiles-public', icon: 'package-open', href: 'https://github.com/yktsnet/dotfiles-public' },
      { name: 'sdlc-kit', icon: 'package-open', href: 'https://github.com/yktsnet/sdlc-kit' },
    ],
  },
];

const resolved = slides.map(slide => ({
  ...slide,
  iconPath: getLucideIcon(slide.icon),
  cites: slide.cites.map(cite => {
    const work = works.find(w => w.title === cite.name);
    return {
      name: cite.name,
      iconPath: getLucideIcon(work?.icon ?? cite.icon ?? slide.icon),
      href: work?.links[0]?.href ?? cite.href,
    };
  }),
}));
---

<div class="space-y-6 sm:space-y-8">
  {resolved.map(slide => (
    <section class="work-step-slide relative rounded-xl border border-zinc-300 dark:border-poi-border bg-transparent p-6 sm:p-8">
      <div class="flex items-center gap-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18" height="18" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" stroke-linejoin="round"
          class="shrink-0 text-poi-accent"
          aria-hidden="true"
          set:html={slide.iconPath}
        />
        <span class="font-mono text-xs tabular-nums text-poi-accent/70 select-none">
          {String(slide.step).padStart(2, '0')}
        </span>
      </div>

      <h2 class="mt-5 text-lg sm:text-xl font-semibold leading-snug tracking-tight text-zinc-900 dark:text-poi-focus">
        <span class="lang-ja">{slide.ja}</span>
        <span class="lang-en">{slide.en}</span>
      </h2>

      <p class="mt-4 font-sans text-sm leading-7 text-zinc-600 dark:text-poi-focus/90 text-justify">
        <span class="lang-ja">{slide.bodyJa}</span>
        <span class="lang-en">{slide.bodyEn}</span>
      </p>

      {/* 証拠は末尾の1行にまとめる。リンクの有無で行の形を変えない */}
      <div class="mt-6 pt-4 border-t border-zinc-200/70 dark:border-poi-border/60 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-zinc-500 dark:text-poi-muted">
        {slide.cites.map(cite => (
          <span class="inline-flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="13" height="13" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"
              class="shrink-0 text-zinc-400 dark:text-poi-muted/60"
              aria-hidden="true"
              set:html={cite.iconPath}
            />
            {cite.href ? (
              <a
                class="inline-flex items-center gap-1 hover:text-poi-accent transition-colors outline-hidden focus-visible:underline"
                href={cite.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>{cite.name}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="11" height="11" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round"
                  class="shrink-0"
                  aria-hidden="true"
                  set:html={getLucideIcon('external-link')}
                />
              </a>
            ) : (
              <span>{cite.name}</span>
            )}
          </span>
        ))}
      </div>
    </section>
  ))}
</div>
