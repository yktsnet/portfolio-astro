---
import '@fontsource/fira-code';
import "../styles/global.css";
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TrailGrid from '../components/TrailGrid.astro';
import { siteConfig } from '../site.config';
import type { SectionLink } from '../types';

interface Props {
  title?: string;
  description?: string;
  sections?: SectionLink[];
}

const {
  title = "Home",
  description = siteConfig.description,
  sections,
} = Astro.props;

const fullTitle = `${title} • ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageURL = new URL("/images/og-default.png", siteConfig.url).toString();
---
<html lang={siteConfig.lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={siteConfig.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 12a1 1 0 0 1-10 0a1 1 0 0 0-10 0' stroke='%235de4c7'/><path d='M7 20.7a1 1 0 1 1 5-8.7a1 1 0 1 0 5-8.6' stroke='%23d482ab'/><path d='M7 3.3a1 1 0 1 1 5 8.6a1 1 0 1 0 5 8.6' stroke='%2389ddff'/><circle cx='12' cy='12' r='2.5' fill='%23cdffb8'/></svg>" type="image/svg+xml" />
    <script is:inline>
      // ストレージを禁じたブラウザでは localStorage が例外を投げ、このスクリプトごと止まる
      const stored = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
      const theme = stored('theme')
        ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme !== 'light');
      // md 未満では言語を切り替えさせず日本語だけで出す。スマホでしか出さない図やボタンは日本語だけで書く
      const wideLang = window.matchMedia('(min-width: 48rem)');
      const applyLang = () => {
        document.documentElement.dataset.lang = wideLang.matches && stored('portfolio_lang') === 'en' ? 'en' : 'ja';
      };
      applyLang();
      wideLang.addEventListener('change', applyLang);
    </script>
    <style is:inline>
      .site-logo-icon {
        width: 2rem;
        height: 3.25rem;
      }
    </style>
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-poi-base dark:text-poi-focus mx-auto flex min-h-screen max-w-5xl flex-col px-5 pt-4 font-sans type-body font-normal antialiased sm:px-8 sm:pt-6 transition-colors duration-300">
    <SiteHeader currentPath={Astro.url.pathname} sections={sections} />
    <main id="main" class="flex-1">
      <TrailGrid class="mb-10" />
      <slot />
      <TrailGrid class="mt-20" />
    </main>
    <SiteFooter />
  </body>
</html>
