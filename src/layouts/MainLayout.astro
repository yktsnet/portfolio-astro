---
import '@fontsource/fira-code';
import "../styles/global.css";
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteConfig } from '../site.config';
import type { SectionLink } from '../types';

interface Props {
  title?: string;
  description?: string;
  showChat?: boolean;
  sections?: SectionLink[];
}

const {
  title = "Home",
  description = siteConfig.description,
  showChat = true,
  sections,
} = Astro.props;

const fullTitle = `${title} • ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageURL = new URL("/images/og-default.png", siteConfig.url).toString();
---
<html lang={siteConfig.lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={siteConfig.ogLocale} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={siteConfig.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'><path d='M22 12a1 1 0 0 1-10 0a1 1 0 0 0-10 0' stroke='%235de4c7'/><path d='M7 20.7a1 1 0 1 1 5-8.7a1 1 0 1 0 5-8.6' stroke='%23d482ab'/><path d='M7 3.3a1 1 0 1 1 5 8.6a1 1 0 1 0 5 8.6' stroke='%2389ddff'/><circle cx='12' cy='12' r='2.5' fill='%23cdffb8'/></svg>" type="image/svg+xml" />
    <script is:inline>
      const theme = localStorage.getItem('theme')
        ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme !== 'light');
      document.documentElement.dataset.lang = localStorage.getItem('portfolio_lang') === 'en' ? 'en' : 'ja';
    </script>
    <style is:inline>
      .site-logo-icon {
        width: 2rem;
        height: 3.25rem;
      }
    </style>
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-poi-base dark:text-poi-focus mx-auto flex min-h-screen max-w-5xl flex-col px-5 pt-4 font-sans type-body font-normal antialiased sm:px-8 sm:pt-6 transition-colors duration-300">
    <SiteHeader currentPath={Astro.url.pathname} sections={sections} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    {showChat && (
      <folio-agent-widget endpoint="/api/chat" policy-href="/data-policy/">
        <span slot="subheading">
          <span class="lang-ja">このサイトと、制作の経緯を書いた<a href="https://zenn.dev/yktsnet" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Zenn</a>（技術記事の投稿サイト）の記事、サイトで紹介している<a href="https://github.com/yktsnet" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">GitHub</a>のリポジトリの説明をもとにAIが答えます</span>
          <span class="lang-en">AI answers from this site, my articles on <a href="https://zenn.dev/yktsnet" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Zenn</a> (a tech blogging platform) about how each project was built, and the READMEs of the <a href="https://github.com/yktsnet" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">GitHub</a> repos featured here</span>
        </span>
      </folio-agent-widget>
    )}
    <script>
      import { defineFolioAgentWidget } from '@folio-agent/widget';
      defineFolioAgentWidget();
    </script>
  </body>
</html>
