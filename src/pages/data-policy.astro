---
import MainLayout from '../layouts/MainLayout.astro';
import T from '../components/T.astro';
import { DEFAULT_RATE_LIMIT_CONFIG } from '@folio-agent/handler';

// 回数は api.ts が使う既定値から出し、実際の制限と文言をずらさない
const { shortWindowMinutes, shortWindowMax, longWindowHours, longWindowMax } = DEFAULT_RATE_LIMIT_CONFIG;

const sections = [
  {
    title: { ja: 'レート制限', en: 'Rate Limits' },
    body: {
      ja: `IP アドレス単位で、${shortWindowMinutes}分あたり${shortWindowMax}回・${longWindowHours}時間あたり${longWindowMax}回までのレート制限を行っています。上限に達した場合はその旨をお伝えし、お急ぎのご相談は Contact ページへの問い合わせをご案内します。`,
      en: `Rate limiting is enforced per IP address (${shortWindowMax} questions per ${shortWindowMinutes} minutes, up to ${longWindowMax} per ${longWindowHours} hours). If the limit is reached, please use the Contact page for urgent inquiries.`,
    },
  },
  {
    title: { ja: 'ログの記録', en: 'Logging' },
    body: {
      ja: '入力内容と生成した応答は、質問傾向の把握や応答品質の改善を目的としてログに記録します。IP アドレスと入力内容は個人に関連しうる情報として扱います。',
      en: 'User inputs and generated responses are logged to understand query trends and improve quality. IP addresses and input content are treated as information that may be linked to individuals.',
    },
  },
  {
    title: { ja: '回答生成について', en: 'Response Generation' },
    body: {
      ja: '回答の生成には Gemini API の無料枠を利用しています。無料枠の性質上、入力いただいた内容がモデルの学習に利用される可能性があります。回答は本サイトに公開されている情報の範囲内で生成しており、公開情報以外の回答は行いません。',
      en: 'Responses are generated using the free tier of the Gemini API. Due to the nature of the free tier, submitted input may be used for model training. Answers are restricted to public information published on this site.',
    },
  },
] as const;
---
<MainLayout title="Data Usage Policy" description="受付チャットボットが扱う入力・応答データの取り扱いについて">
  <h1 class="mb-6 type-display font-semibold text-zinc-900 dark:text-poi-focus">
    <T text={{ ja: '利用データの扱い', en: 'Data Usage Policy' }} />
  </h1>

  <p class="type-body leading-7 text-zinc-600 dark:text-poi-muted">
    <T text={{
      ja: 'このサイトの受付チャットボットの利用にあたり、入力内容の扱いについて以下の3点を明記します。',
      en: 'Regarding the assistant chatbot on this site, the handling of input data is outlined below.',
    }} />
  </p>

  {sections.map((s) => (
    <section class="mt-10">
      <h2 class="mb-4 type-subheading font-semibold text-zinc-900 dark:text-poi-focus">
        <T text={s.title} />
      </h2>
      <p class="type-body leading-7 text-zinc-600 dark:text-poi-muted">
        <T text={s.body} />
      </p>
    </section>
  ))}

  <p class="mt-10 type-body leading-7 text-zinc-600 dark:text-poi-muted">
    <span class="lang-ja">
      ご不明な点や個別のご相談は
      <a href="/contact/" class="cactus-link text-light-accent dark:text-poi-accent">Contact ページ</a>
      からご連絡ください。
    </span>
    <span class="lang-en">
      For questions or inquiries, please visit the
      <a href="/contact/" class="cactus-link text-light-accent dark:text-poi-accent">Contact page</a>.
    </span>
  </p>
</MainLayout>
