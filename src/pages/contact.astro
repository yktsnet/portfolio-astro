---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Contact" description="お問い合わせ・各種リンク">
  <h1 class="mb-6 text-xl font-semibold text-zinc-900 dark:text-poi-focus">Contact</h1>

  <p class="font-sans text-sm leading-7 text-zinc-600 dark:text-poi-muted lang-ja">
    お仕事のご相談・ご依頼はフォームからご連絡ください。
    初回はどんな課題を抱えているかを聞かせていただければ十分です。
  </p>
  <p class="font-sans text-sm leading-7 text-zinc-600 dark:text-poi-muted lang-en">
    Please reach out via the form for inquiries or work requests.
    A brief description of your current challenges is plenty to get started.
  </p>

  <!-- Contact Form -->
  <section class="mt-10">
    <h2 class="mb-6 text-base font-semibold text-zinc-900 dark:text-poi-focus">
      <span class="lang-ja">お問い合わせ</span>
      <span class="lang-en">Inquiry Form</span>
    </h2>

    <form id="contact-form" class="space-y-4 max-w-md">
      <div>
        <label for="cf-name" class="block text-sm font-semibold text-zinc-700 dark:text-poi-focus/90 mb-1">
          <span class="lang-ja">名前</span>
          <span class="lang-en">Name</span>
          <span class="text-red-400">*</span>
        </label>
        <input
          type="text"
          id="cf-name"
          name="name"
          required
          class="w-full rounded-md border border-zinc-300 dark:border-zinc-600 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-900 dark:text-poi-focus placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-light-accent dark:focus:border-poi-accent focus:outline-hidden transition-colors"
        />
      </div>

      <div>
        <label for="cf-email" class="block text-sm font-semibold text-zinc-700 dark:text-poi-focus/90 mb-1">
          <span class="lang-ja">メールアドレス</span>
          <span class="lang-en">Email Address</span>
          <span class="text-red-400">*</span>
        </label>
        <input
          type="email"
          id="cf-email"
          name="email"
          required
          class="w-full rounded-md border border-zinc-300 dark:border-zinc-600 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-900 dark:text-poi-focus placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-light-accent dark:focus:border-poi-accent focus:outline-hidden transition-colors"
        />
      </div>

      <div>
        <label for="cf-phone" class="block text-sm font-semibold text-zinc-700 dark:text-poi-focus/90 mb-1">
          <span class="lang-ja">電話番号</span>
          <span class="lang-en">Phone Number</span>
          <span class="text-red-400">*</span>
        </label>
        <input
          type="tel"
          id="cf-phone"
          name="phone"
          required
          class="w-full rounded-md border border-zinc-300 dark:border-zinc-600 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-900 dark:text-poi-focus placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-light-accent dark:focus:border-poi-accent focus:outline-hidden transition-colors"
        />
      </div>

      <div>
        <label for="cf-message" class="block text-sm font-semibold text-zinc-700 dark:text-poi-focus/90 mb-1">
          <span class="lang-ja">メッセージ</span>
          <span class="lang-en">Message</span>
        </label>
        <textarea
          id="cf-message"
          name="message"
          rows="4"
          class="w-full rounded-md border border-zinc-300 dark:border-zinc-600 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-2 text-sm text-zinc-900 dark:text-poi-focus placeholder-zinc-400 dark:placeholder-zinc-500 focus:border-light-accent dark:focus:border-poi-accent focus:outline-hidden transition-colors resize-y"
        ></textarea>
      </div>

      <!-- Cloudflare Turnstile -->
      <div
        class="cf-turnstile"
        data-sitekey="0x4AAAAAACtlG-abZy2cvpsN"
        data-theme="auto"
      ></div>

      <button
        type="submit"
        class="rounded-md bg-zinc-700 dark:bg-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-100 dark:text-poi-focus/90 hover:bg-zinc-600 dark:hover:bg-zinc-600 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span class="lang-ja">送信</span>
        <span class="lang-en">Send Message</span>
      </button>

      <p id="cf-status" class="text-sm hidden"></p>
    </form>
  </section>
</MainLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { buildContactBody } from '../lib/contact-form';

  // CDN スクリプト (challenges.cloudflare.com/turnstile/v0/api.js) が定義するグローバル。
  // 読み込み前・失敗時は undefined になり得るため呼び出し側で存在チェックする。
  declare global {
    interface Window {
      turnstile?: {
        reset: (widgetId?: string) => void;
      };
    }
  }

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const status = document.getElementById('cf-status') as HTMLParagraphElement;

    btn.disabled = true;
    btn.textContent = '送信中…';
    status.classList.add('hidden');

    const body = buildContactBody(form);

    const resetTurnstile = () => {
      // reset 直後はトークン未発行のため、発行が反映されるまでボタンを再有効化しない
      // （でないと空トークンのまま再送し、サーバ側の 403 を確実に踏む）。
      window.turnstile?.reset();
      const widget = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
      if (!widget) {
        btn.disabled = false;
        return;
      }
      const check = setInterval(() => {
        if (widget.value) {
          clearInterval(check);
          btn.disabled = false;
        }
      }, 200);
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();

      status.classList.remove('hidden');
      if (data.ok) {
        status.textContent = 'ありがとうございます。メッセージを送信しました。';
        status.className = 'text-sm text-green-600 dark:text-green-400';
        form.reset();
        btn.disabled = false;
        btn.textContent = '送信';
        return;
      }

      status.textContent = '送信に失敗しました。再度お試しください。';
      status.className = 'text-sm text-red-500';
      btn.textContent = '送信';
      resetTurnstile();
    } catch {
      status.classList.remove('hidden');
      status.textContent = 'ネットワークエラーが発生しました。';
      status.className = 'text-sm text-red-500';
      btn.textContent = '送信';
      resetTurnstile();
    }
  });
</script>
