---
import MainLayout from '../layouts/MainLayout.astro';
import T from '../components/T.astro';
import TrailGrid from '../components/TrailGrid.astro';
import LucideIcon from '../components/LucideIcon.astro';
import { services } from '../data/services';

const fields = [
  { id: 'cf-name', name: 'name', type: 'text', autocomplete: 'name', label: { ja: '名前', en: 'Name' } },
  { id: 'cf-email', name: 'email', type: 'email', autocomplete: 'email', label: { ja: 'メールアドレス', en: 'Email Address' } },
  { id: 'cf-phone', name: 'phone', type: 'tel', autocomplete: 'tel', label: { ja: '電話番号', en: 'Phone Number' } },
] as const;

const labelClass = 'mb-1.5 flex items-baseline gap-2 type-small font-semibold text-zinc-800 dark:text-poi-focus/90';
const inputClass =
  'w-full rounded-md border border-zinc-300 bg-white px-3 py-2 type-body text-zinc-900 transition-colors focus:border-poi-accent focus:outline-hidden dark:border-poi-border dark:bg-poi-panel/30 dark:text-poi-focus';
---
<MainLayout title="Contact" description="Inquiries and work requests.">
  <div class="max-w-3xl">
    <p class="font-mono type-caption tracking-widest uppercase text-zinc-500 dark:text-poi-muted">Contact</p>
    <h1 class="mt-2 type-display font-semibold leading-relaxed tracking-tight text-zinc-900 dark:text-poi-focus">
      <T text={{ ja: 'いま困っていることを、聞かせてください。', en: 'Tell me what is getting in your way.' }} />
    </h1>
    <p class="mt-5 max-w-2xl type-lead leading-7 text-zinc-600 sm:leading-8 dark:text-poi-muted">
      <T text={{
        ja: 'お仕事のご相談・ご依頼はフォームからご連絡ください。初回はどんな課題を抱えているかを聞かせていただければ十分です。',
        en: 'Please reach out via the form for inquiries or work requests. A brief description of your current challenges is plenty to get started.',
      }} />
    </p>
  </div>

  {/* 罫線の代わりに TrailGrid で区切る */}
  <TrailGrid variant="divider" class="mt-10 sm:mt-12" />
  <div class="mt-10 grid gap-12 sm:mt-12 md:grid-cols-2 md:items-start">
    <form id="contact-form" class="space-y-5">
      {fields.map((f) => (
        <div>
          <label for={f.id} class={labelClass}>
            <T text={f.label} />
            <span class="type-label font-normal text-zinc-500 dark:text-poi-muted"><span class="lang-ja">必須</span><span class="lang-en">required</span></span>
          </label>
          <input type={f.type} id={f.id} name={f.name} autocomplete={f.autocomplete} required class={inputClass} />
        </div>
      ))}

      <div>
        <label for="cf-message" class={labelClass}>
          <T text={{ ja: 'メッセージ', en: 'Message' }} />
        </label>
        <textarea id="cf-message" name="message" rows="5" class:list={[inputClass, 'resize-y']}></textarea>
      </div>

      <!-- Cloudflare Turnstile -->
      <div
        class="cf-turnstile"
        data-sitekey="0x4AAAAAACtlG-abZy2cvpsN"
        data-theme="auto"
      ></div>

      <button
        type="submit"
        class="inline-flex items-center gap-1.5 rounded-md border border-poi-accent/45 bg-poi-accent/10 px-5 py-2.5 type-body font-semibold text-poi-accent transition-colors hover:bg-poi-accent/20 focus-visible:underline outline-hidden disabled:cursor-not-allowed disabled:opacity-50"
      >
        <T text={{ ja: '送信', en: 'Send Message' }} />
      </button>

      <p id="cf-status" class="type-body hidden"></p>
    </form>

    {/* 何を頼めるかを、フォームの横で確かめられるようにする */}
    <aside>
      <p class="font-mono type-caption tracking-widest uppercase text-zinc-500 dark:text-poi-muted">Services</p>
      <p class="mt-3 type-body leading-7 text-zinc-700 dark:text-poi-muted">
        <T text={{
          ja: '受けている仕事は次の2つです。どちらに近いか分からない段階でも構いません。',
          en: 'These are the two areas of work I take on. It is fine if you are not yet sure which one fits.',
        }} />
      </p>
      <ul class="mt-4 space-y-3">
        {services.map((sv) => (
          <li>
            <a href={`/services/${sv.slug}/`} class="group block ui-card p-5 transition-colors duration-200 hover:border-poi-accent/50 dark:hover:border-poi-accent/50">
              <span class="flex items-center gap-2 font-mono type-label text-zinc-500 dark:text-poi-muted">
                <LucideIcon name={sv.icon} />
                <span>{sv.no}</span>
                <span class="tracking-widest">{sv.kicker}</span>
              </span>
              <span class="mt-2 flex items-center justify-between gap-3 type-subheading font-semibold text-zinc-900 transition-colors group-hover:text-poi-accent dark:text-poi-focus">
                <T text={sv.title} />
                <LucideIcon name="arrow-right" class="h-4 w-4 shrink-0 text-zinc-400 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-poi-accent dark:text-poi-muted" />
              </span>
              <span class="mt-1.5 block type-small leading-6 text-zinc-600 dark:text-poi-muted">
                {sv.offerings.map((o, i) => <>{i > 0 && ' / '}<T text={o.title} /></>)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</MainLayout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { buildContactBody } from '../lib/contact-form';

  // CDN スクリプト (challenges.cloudflare.com/turnstile/v0/api.js) が定義するグローバル。
  // 読み込み前・失敗時は undefined になり得るため呼び出し側で存在チェックする。
  declare global {
    interface Window {
      turnstile?: {
        reset: (widgetId?: string) => void;
      };
    }
  }

  type Msg = { ja: string; en: string };
  const MSG = {
    sending: { ja: '送信中…', en: 'Sending…' },
    sent: { ja: 'ありがとうございます。メッセージを送信しました。', en: 'Thank you. Your message has been sent.' },
    failed: { ja: '送信に失敗しました。再度お試しください。', en: 'Sending failed. Please try again.' },
    network: { ja: 'ネットワークエラーが発生しました。', en: 'A network error occurred.' },
  } satisfies Record<string, Msg>;

  // 送信後に言語を切り替えても表示が追従するよう、ページの文言と同じく日英の span を並べる
  const setMsg = (el: HTMLElement, m: Msg) => {
    const ja = document.createElement('span');
    ja.className = 'lang-ja';
    ja.textContent = m.ja;
    const en = document.createElement('span');
    en.className = 'lang-en';
    en.textContent = m.en;
    el.replaceChildren(ja, en);
  };

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const status = document.getElementById('cf-status') as HTMLParagraphElement;
    const btnLabel = btn.innerHTML;

    btn.disabled = true;
    setMsg(btn, MSG.sending);
    status.classList.add('hidden');

    const body = buildContactBody(form);

    const resetTurnstile = () => {
      // reset 直後はトークン未発行のため、発行が反映されるまでボタンを再有効化しない
      // （でないと空トークンのまま再送し、サーバ側の 403 を確実に踏む）。
      window.turnstile?.reset();
      const widget = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
      if (!widget) {
        btn.disabled = false;
        return;
      }
      const check = setInterval(() => {
        if (widget.value) {
          clearInterval(check);
          btn.disabled = false;
        }
      }, 200);
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const data = await res.json();

      status.classList.remove('hidden');
      if (data.ok) {
        setMsg(status, MSG.sent);
        status.className = 'type-body text-green-600 dark:text-green-400';
        form.reset();
        btn.disabled = false;
        btn.innerHTML = btnLabel;
        return;
      }

      setMsg(status, MSG.failed);
      status.className = 'type-body text-red-500';
      btn.innerHTML = btnLabel;
      resetTurnstile();
    } catch {
      status.classList.remove('hidden');
      setMsg(status, MSG.network);
      status.className = 'type-body text-red-500';
      btn.innerHTML = btnLabel;
      resetTurnstile();
    }
  });
</script>
