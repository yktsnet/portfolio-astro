---
import MainLayout from '../layouts/MainLayout.astro';
import AboutSection from '../components/About.astro';
---

<MainLayout title="About"
  description="I didn't start out as an engineer. I was running the business, and ended up building the systems myself."
>
  <div class="max-w-2xl">
    <div class="mb-12 flex items-center gap-5">
      <img src="/images/profile/me.webp" alt="Katsuhiro Yamakawa" class="h-20 w-20 rounded-full object-cover" />
      <div>
        <p class="text-lg font-semibold text-zinc-900 dark:text-poi-focus">Katsuhiro Yamakawa</p>
        <p class="text-sm text-poi-accent">Builder</p>
      </div>
    </div>
    <AboutSection />
  </div>
</MainLayout>
