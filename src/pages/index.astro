---
import MainLayout from '../layouts/MainLayout.astro';
import T from '../components/T.astro';
import LucideIcon from '../components/LucideIcon.astro';
import RepoLink from '../components/RepoLink.astro';
import Career from '../components/Career.astro';
import SectionHead from '../components/services/SectionHead.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import { services } from '../data/services';
import { siteConfig } from '../site.config';

// 4つのうち3つは導入事例の数字。最後の1つだけ経歴から取る
const numbers = [
  { tag: 'ATTENDANCE', value: { ja: '−5', en: '−5' }, unit: { ja: '時間/月', en: 'h/mo' }, label: { ja: '管理者の勤怠集計の工数', en: 'Admin hours on attendance' } },
  { tag: 'PAYROLL', value: { ja: '−3〜4', en: '−3〜4' }, unit: { ja: '万円/月', en: '×10k JPY/mo' }, label: { ja: '給与計算の月次差異', en: 'Monthly payroll discrepancy' } },
  { tag: 'ADOPTION', value: { ja: '初日', en: 'Day 1' }, unit: { ja: 'から', en: '' }, label: { ja: '説明なしで現場に定着', en: 'Adopted without instructions' } },
  { tag: 'TUTORING', value: { ja: '12', en: '12' }, unit: { ja: '年', en: 'yrs' }, label: { ja: '学習塾の経営', en: 'Running a tutoring school' } },
];

// 見出しの「決めるのは経営から、作るのは現場から、渡すのは教育から」を1枚ずつに分ける
const origins = [
  {
    tag: 'DECIDE',
    from: { ja: '経営から', en: 'From management' },
    title: { ja: '数字から直すものを決める', en: 'Decide what to fix from the numbers' },
    body: {
      ja: '塾と会社の経営では税理士を立てず、決算まで自分でやってきた。だから事業の金がどこを通っているかを自分で読める。依頼を待たず、数字を見て直すものを決めるところから入る。',
      en: 'Running the school and the company, I closed the books myself without an accountant, so I can read where the money moves in a business. I start from the numbers rather than from a brief.',
    },
  },
  {
    tag: 'BUILD',
    from: { ja: '現場から', en: 'From the floor' },
    title: { ja: '現場のやり方を変えずに作る', en: 'Build without changing how people work' },
    body: {
      ja: '塾でも会社でも、仕組みを作るのも毎日使うのも自分だった。手順を一つ増やせばそのまま自分の手間になるので、増やさずに回る形を先に考える。導入時に歓迎された機能が半年後には使われなくなるのも見てきたので、新しい操作を覚えさせず、自動化は既存の運用の裏側に差し込む。',
      en: 'In both businesses, I built the systems and used them every day. Every extra step landed back on me, so I look first for a way to run things without adding steps. Having watched features welcomed at launch go unused six months later, I don\'t make people learn new operations; automation goes in behind the existing work.',
    },
  },
  {
    tag: 'HAND OVER',
    from: { ja: '教育から', en: 'From teaching' },
    title: { ja: '回り出すまで付き合って渡す', en: 'Stay until it runs, then hand it over' },
    body: {
      ja: '教えるときは、言って聞かせるより、生徒が自分で進められるよう場と段取りを整えるほうが続いた。仕組みも納めて終わりにせず、使われ方を見て合わないところを直し、現場で回り出すまで付き合う。',
      en: 'In teaching, setting up the room and the sequence so students could move on their own lasted longer than telling them what to do. Systems are the same: delivery is not the end. I watch how they are used, fix what does not fit, and stay until they run on their own.',
    },
  },
];
---

<MainLayout title={siteConfig.author} wide>
  {/* 最初に伝えるのは経歴。どういう人かを先に置く */}
  <section class="pt-4">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <img src="/images/profile/me.webp" alt="Katsuhiro Yamakawa" class="h-24 w-24 shrink-0 rounded-full object-cover sm:h-32 sm:w-32" />
      <div>
        <p class="font-mono text-sm text-zinc-500 dark:text-poi-muted">Katsuhiro Yamakawa</p>
        <p class="mt-1 font-mono text-sm text-poi-accent">Builder</p>
        <h1 class="mt-3 text-2xl sm:text-[32px] font-semibold leading-normal tracking-tight text-zinc-900 dark:text-poi-focus">
          <span class="lang-ja"><span class="block">実装から来た人間ではない。</span><span class="block">事業を回す側にいて、開発もやるようになった。</span></span>
          <span class="lang-en"><span class="block">I didn't start out as an engineer.</span><span class="block">I was running the business, and ended up building the systems myself.</span></span>
        </h1>
        <p class="mt-6 max-w-2xl text-sm leading-8 text-zinc-600 dark:text-poi-muted">
          <span class="lang-ja">学習塾を12年、合同会社を設立から清算まで経営してきた。いまは受託開発の企業に勤めながら、個人でも開発とコンサルを受け、マンション管理会社の外部 CTO も務めている。</span>
          <span class="lang-en">Twelve years running a tutoring school, and an LLC from founding to liquidation. Today I work at a contract development firm, take on development and consulting on my own, and serve as external CTO for a property management company.</span>
        </p>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-8 border-t border-zinc-200 pt-8 dark:border-poi-border/60 md:grid-cols-4">
      {numbers.map((n) => (
        <div>
          <dt class="font-mono text-[10px] tracking-widest text-poi-muted">{n.tag}</dt>
          <dd class="mt-2 font-mono text-2xl font-medium text-poi-accent">
            <T text={n.value} /><span class="ml-0.5 text-xs"><T text={n.unit} /></span>
          </dd>
          <dd class="mt-1 text-xs text-zinc-600 dark:text-poi-muted"><T text={n.label} /></dd>
        </div>
      ))}
    </dl>
  </section>

  {/* Services */}
  <section id="services" class="mt-32 scroll-mt-28">
    <SectionHead
      kicker="Services"
      title={{ ja: '個人として受けていること', en: 'Work I take on as an individual' }}
      lead={{
        ja: '経営と現場と教育でやってきたことを、いまは個人の仕事として受けている。使っている仕組みは GitHub で公開している。',
        en: 'What I did in management, on the floor and in teaching, I now take on as individual work. The building blocks are public on GitHub.',
      }}
    />
    <div class="mt-12 space-y-8">
      {services.map((s, idx) => <ServiceCard service={s} reverse={idx % 2 === 1} />)}
    </div>
  </section>

  {/* About: 考え方は、経歴のどこから来たかと一緒に示す */}
  <section id="about" class="mt-32 scroll-mt-28">
    <SectionHead
      kicker="About"
      title={{ ja: '決めるところは経営から、作るところは現場から、渡すところは教育から来ている', en: 'Deciding comes from running a business, building from the shop floor, handing over from teaching' }}
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {origins.map((o) => (
        <article class="rounded-lg border border-zinc-200 bg-white p-7 dark:border-poi-border/70 dark:bg-poi-base">
          <p class="flex items-baseline justify-between font-mono text-[10px] tracking-widest text-poi-muted">
            <span>{o.tag}</span>
            <span class="text-poi-accent"><T text={o.from} /></span>
          </p>
          <h3 class="mt-3 text-[15px] font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={o.title} /></h3>
          <p class="mt-3 text-[13px] leading-7 text-zinc-600 dark:text-poi-muted"><T text={o.body} /></p>
        </article>
      ))}
    </div>

    {/* いまの開発の考え方。生成より検証、機能より安定 */}
    <div class="mt-6 grid gap-6 rounded-lg border border-zinc-200 bg-white p-7 sm:p-10 dark:border-poi-border/70 dark:bg-poi-base md:grid-cols-[1fr_2fr]">
      <div>
        <p class="font-mono text-[10px] tracking-widest text-poi-muted"><span class="lang-ja">いまの開発</span><span class="lang-en">DEVELOPMENT TODAY</span></p>
        <h3 class="mt-3 text-[15px] font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus">
          <span class="lang-ja">人の注意や記憶に、品質を預けない</span>
          <span class="lang-en">Quality never rests on human vigilance or memory</span>
        </h3>
      </div>
      <div>
        <p class="text-[13px] leading-7 text-zinc-600 dark:text-poi-muted">
          <span class="lang-ja">受託開発の企業に勤めながら、必要になった仕組みを小さく OSS として公開している。AI がコードを書くいまは、書かれたものを信じられるか確かめることに時間を使う。何が壊れてはいけないかだけを人が決めて文書で承認し、テストと実装は AI に任せ、約束が破られれば機械が止める。この分業を保証駆動開発（GDD）と呼んでいる。自動売買を個人で本番運用するために操作画面を捨てて最小の構成に作り直したように、機能の多さより止まらないことを選ぶ。</span>
          <span class="lang-en">I work at a contract development firm and publish the tools I need as small open-source projects. With AI writing code, I spend my time confirming that what was written can be trusted. A human decides only what must not break and approves it in writing; tests and implementation go to AI, and the machine stops when a promise is broken. I call this split Guarantee-Driven Development (GDD). Just as I rebuilt my automated trading setup without its UI so it would never stop in production, I choose not stopping over having more features.</span>
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          <RepoLink label="Zenn — 保証駆動開発 (GDD)" href="https://zenn.dev/yktsnet/articles/202608-guarantee-driven-development" icon="file-text" />
          <RepoLink label="drip-live-public" href="https://github.com/yktsnet/drip-live-public" />
          <RepoLink label="dotfiles-public" href="https://github.com/yktsnet/dotfiles-public" />
        </div>
      </div>
    </div>

    <div class="mt-16">
      <Career />
    </div>

  </section>
</MainLayout>
