---
import ProfileLayout from '../layouts/ProfileLayout.astro';
import HostingArchitecture from '../components/HostingArchitecture.astro';
import WorkSteps from '../components/WorkSteps.astro';
import AllWorks from '../components/AllWorks.astro';
import WorkFilter from '../components/WorkFilter.astro';
import { works, researches, getCategoryIcon } from '../data/works';
import { getLucideIcon } from '../lib/lucide';
import { siteConfig } from '../site.config';

// 現場導入（inUse trueが上）を第一キー、優先度（priority 昇順）を第二キー、時系列（publishedAt 降順）を第三キーとしてソート
const sortedWorks = [...works].sort((a, b) => {
  if (!!a.inUse !== !!b.inUse) {
    return a.inUse ? -1 : 1;
  }
  if (a.priority !== b.priority) {
    return a.priority - b.priority;
  }
  const dateA = a.publishedAt || "0000.00";
  const dateB = b.publishedAt || "0000.00";
  return dateB.localeCompare(dateA);
});

// 全件を同じ軽いカードで並べる。研究も別枠に戻さず同じ一覧に入れる
const allItems = [
  ...sortedWorks.map(w => ({
    title: w.title,
    icon: w.icon,
    description: w.description,
    href: w.href,
    publishedAt: w.publishedAt,
    inUse: w.inUse,
    categoryTag: w.categoryTag,
    tagIconPath: getLucideIcon(getCategoryIcon(w.categoryTag)),
  })),
  ...researches.map(r => ({
    title: r.title,
    description: r.description,
    href: r.href,
    publishedAt: r.publishedAt,
  })),
];

// ユニークなカテゴリタグの抽出（小文字、アルファベット順にソート）
const allUniqueCategoryTags = Array.from(
  new Set(works.map(w => w.categoryTag))
).sort();

const resolvedTags = allUniqueCategoryTags.map(tag => {
  const count = works.filter(w => w.categoryTag === tag).length;
  return {
    name: tag,
    count,
    iconPath: getLucideIcon(getCategoryIcon(tag)),
  };
});
---

<ProfileLayout current="works" title={siteConfig.author}>
  {/* 上部: 共同ホスト基盤「NixOS + Docker」の解説と構成図モニター */}
  <HostingArchitecture />

  {/* 三段それぞれを1枚のパネルで説明し、作品は証拠として1件だけ引く */}
  <div class="mt-10 sm:mt-12">
    <WorkSteps />
  </div>

  {/* 下段: 全件一覧。フィルタの対象はこの一覧のみ */}
  <AllWorks items={allItems}>
    <WorkFilter slot="filter" resolvedTags={resolvedTags} />
  </AllWorks>
</ProfileLayout>
