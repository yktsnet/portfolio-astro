---
import MainLayout from '../layouts/MainLayout.astro';
import T from '../components/T.astro';
import Career from '../components/Career.astro';
import CaseBlock from '../components/CaseBlock.astro';
import Fold from '../components/Fold.astro';
import FoldToggle from '../components/FoldToggle.astro';
import LucideIcon from '../components/LucideIcon.astro';
import RepoLink from '../components/RepoLink.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import WorkList from '../components/WorkList.astro';
import { cases } from '../data/cases';
import { services } from '../data/services';
import { works } from '../data/works';
import { gddArticle } from '../data/articles';
import { siteConfig } from '../site.config';
import type { SectionLink } from '../types';

// 見出しの「決めるのは経営から、作るのは現場から、渡すのは教育から」を1枚ずつに分ける
const origins = [
  {
    tag: 'DECIDE',
    from: { ja: '経営から', en: 'From management' },
    title: { ja: '数字から直すものを決める', en: 'Decide what to fix from the numbers' },
    body: {
      ja: '塾と会社の経営では税理士を立てず、決算まで自分でやってきた。だから事業の金がどこを通っているかを自分で読める。依頼を待たず、数字を見て直すものを決めるところから入る。',
      en: 'Running the school and the company, I closed the books myself without an accountant, so I can read where the money moves in a business. I start from the numbers rather than from a brief.',
    },
  },
  {
    tag: 'BUILD',
    from: { ja: '現場から', en: 'From the floor' },
    title: { ja: '現場のやり方を変えずに作る', en: 'Build without changing how people work' },
    body: {
      ja: '塾でも会社でも、仕組みを作るのも毎日使うのも自分だった。手順を一つ増やせばそのまま自分の手間になるので、増やさずに回る形を先に考える。導入時に歓迎された機能が半年後には使われなくなるのも見てきたので、新しい操作を覚えさせず、自動化は既存の運用の裏側に差し込む。',
      en: 'In both businesses, I built the systems and used them every day. Every extra step landed back on me, so I look first for a way to run things without adding steps. Having watched features welcomed at launch go unused six months later, I don\'t make people learn new operations; automation goes in behind the existing work.',
    },
  },
  {
    tag: 'HAND OVER',
    from: { ja: '教育から', en: 'From teaching' },
    title: { ja: '回り出すまで付き合って渡す', en: 'Stay until it runs, then hand it over' },
    body: {
      ja: '教えるときは、言って聞かせるより、生徒が自分で進められるよう場と段取りを整えるほうが続いた。仕組みも納めて終わりにせず、使われ方を見て合わないところを直し、現場で回り出すまで付き合う。',
      en: 'In teaching, setting up the room and the sequence so students could move on their own lasted longer than telling them what to do. Systems are the same: delivery is not the end. I watch how they are used, fix what does not fit, and stay until they run on their own.',
    },
  },
];

// 顧客理解と実装の分担（全体）、上流、下流の順。詳細ページの3つの図と同じ並び
const flow = [
  {
    icon: 'users',
    tag: 'BIG PICTURE',
    title: { ja: '顧客理解と実装を分けてつなぐ', en: 'Connect customer understanding and implementation' },
    body: {
      ja: '利用者の慣れや書かれていない例外は、現場にしかない。顧客理解の担当を実装から切り離して現場と試作から何を作るかを決め、実装とは動く試作と問いでつなぐ。',
      en: 'User habits and unwritten exceptions exist only on site. Customer Understanding stays apart from implementation and decides what to build from the site and prototypes, connected to implementation through working prototypes and questions.',
    },
  },
  {
    icon: 'flask-conical',
    tag: 'UPSTREAM',
    title: { ja: '答えを待たずに「仮置き」で試作', en: 'Prototype on explicit assumptions' },
    body: {
      ja: '先方の回答を待てば手が止まり、待たずに進めれば AI が黙って推測で埋める。未確定の点は仮置き一覧に分けて先に動く画面を見せ、並行して問いを照会・回収する。',
      en: 'Waiting for client answers stalls the work; moving on without them lets AI fill gaps with silent guesses. Unknowns go into an assumption list so working screens can be shown first, while questions are sent and collected in parallel.',
    },
  },
  {
    icon: 'shield-check',
    tag: 'DOWNSTREAM',
    title: { ja: '約束を先に承認し、別文脈で判定', en: 'Approve promises first, verify separately' },
    body: {
      ja: '自分で書いたテストで自分の実装を確かめると解釈が甘くなる。入口で完了条件（AC）と壊さない保証を承認し、出口では別文脈の確認者が証拠付きで判定する。',
      en: 'Checking your own code with your own tests leads to lenient grading. Approve ACs and guarantees upfront, and verify in a separate session with test evidence.',
    },
  },
];

const sections: SectionLink[] = [
  { id: 'about', label: 'About' },
  { id: 'services', label: 'Services' },
  { id: 'workflow', label: 'Workflow' },
  { id: 'works', label: 'Works', mdOnly: true },
];
---

<MainLayout title={siteConfig.author} sections={sections}>
  {/* 1. About: どういう人か・なぜ1人で回せるかを先に完結させる */}
  <section id="about" class="scroll-mt-32">
    <div class="flex items-center gap-6">
      <img src="/images/profile/me.webp" alt="Katsuhiro Yamakawa" class="h-24 w-24 shrink-0 rounded-full object-cover sm:h-28 sm:w-28" />
      <div>
        <h1 class="type-display font-semibold tracking-tight text-zinc-900 dark:text-poi-focus">Katsuhiro Yamakawa</h1>
        <a href="https://github.com/yktsnet" target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex items-center gap-1.5 font-mono type-subheading text-poi-accent hover:underline focus-visible:underline outline-hidden">
          {/* ヘッダーの GitHub のリンクと同じ塗りのロゴ */}
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" /></svg>
          yktsnet
        </a>
      </div>
    </div>

    <div class="mt-8 sm:mt-10">
      <SectionHead
        kicker="About"
        title={{
          ja: '実装から来た人間ではない。\n事業を回す側にいて、開発もやるようになった。',
          en: "I didn't start out as an engineer.\nI was running the business, and ended up building the systems myself.",
        }}
        lead={{
          ja: '学習塾を12年、合同会社を設立から清算まで経営してきた。いまは受託開発の企業に勤めながら、個人でも開発とコンサルを受け、マンション管理会社の外部CTOも務めている。必要になった仕組みや自分の開発基盤は、小さくOSSとして公開している。',
          en: 'Twelve years running a tutoring school, and an LLC from founding to liquidation. Today I work at a contract development firm, take on development and consulting on my own, and serve as external CTO for a property management company, releasing the tools and development setup I build along the way as small open-source projects.',
        }}
      />
    </div>

    {/* About の下は1つの段。左に考え方と経歴、右に実例と技術を置き、2列の高さをそろえる。
        スマホでは 原則・実例・技術・経歴 の順に並べたいので、列の箱を外して order で並べ替える */}
    <div class="mt-10 flex flex-col border-t border-zinc-200 pt-10 sm:mt-12 sm:pt-12 md:grid md:grid-cols-2 md:items-start md:gap-x-12 dark:border-poi-border/60">
      <div class="contents md:block">
        <div data-fold-group class="order-1">
          <p class="font-mono type-caption tracking-widest uppercase text-zinc-500 dark:text-poi-muted">PRINCIPLES</p>
          {/* 箱はリンクになるものと図に使う。ここは読むだけなので線で区切る */}
          <FoldToggle class="mt-4" />
          <ol class="mt-4 space-y-5 md:space-y-7">
            {origins.map((o) => (
              <li class="border-l-2 border-poi-accent/50 pl-4 sm:pl-5">
                <Fold>
                  <Fragment slot="head">
                    <span class="flex items-baseline gap-2.5 ui-kicker font-normal">
                      <span>{o.tag}</span>
                      <span class="text-poi-accent"><T text={o.from} /></span>
                    </span>
                    <span class="mt-1.5 block type-subheading font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={o.title} /></span>
                  </Fragment>
                  <p class="mt-2 type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={o.body} /></p>
                </Fold>
              </li>
            ))}
          </ol>
        </div>
        <div class="order-4 md:mt-12">
          <Career part="timeline" />
        </div>
      </div>

      <div class="contents md:block">
        <div class="order-2 mt-12 space-y-12 md:mt-0">
          {cases.map((c) => <CaseBlock study={c} />)}
        </div>
        <div class="order-3 mt-12">
          <Career part="coverage" />
        </div>
      </div>
    </div>
  </section>

  {/* 2. Services: 開発と、事務・採用を、同じエンジニアリングで変えるという1つの話として出す */}
  <section id="services" class="mt-20 scroll-mt-32 border-t border-zinc-200 pt-16 sm:mt-24 sm:pt-20 dark:border-poi-border/60">
    <SectionHead
      kicker="Services"
      title={{
        ja: '開発を良くすることと、事務や採用を良くすること。\n分かれていた2つを、同じエンジニアリングで変える。',
        en: 'Making development better, and making office work and hiring better.\nTwo things once kept apart, changed by the same engineering.',
      }}
    />
    <div class="mt-8 space-y-6 sm:mt-12 sm:space-y-12">
      {services.map((s, idx) => <ServiceCard service={s} reverse={idx % 2 === 1} />)}
    </div>
  </section>

  {/* 3. Workflow: AIと開発するときの自分の進め方（Servicesとは独立した3本目の柱） */}
  <section id="workflow" class="mt-20 scroll-mt-32 border-t border-zinc-200 pt-16 sm:mt-24 sm:pt-20 dark:border-poi-border/60">
    <SectionHead
      kicker="Workflow"
      title={{
        ja: 'AIと開発するときは、\n顧客理解と実装を分けて行き来している。',
        en: 'When building with AI,\nI separate and connect customer understanding and implementation.',
      }}
      lead={{
        ja: 'AI で実装が速くなると、詰まるのは「何を作るか決めること」と「出力の検証」になる。答えを待たずに仮置きで試作して暗黙知を引き出し、作った者とは別の文脈で検証する。',
        en: 'When AI makes coding fast, the bottlenecks shift to deciding what to build and verifying the output. I prototype on explicit assumptions without waiting for answers, and verify in a fresh context.',
      }}
    />

    {/* md 以上はカード全体がリンク。スマホは中に開閉があるので、押し間違えないようボタンだけをリンクにする */}
    <article data-fold-group class="group relative mt-10 overflow-hidden ui-card transition-colors duration-200 sm:mt-12 md:hover:border-poi-accent/50 dark:md:hover:border-poi-accent/50">
      <FoldToggle variant="band" class="border-b ui-subpanel px-6 py-3" />
      <div class="grid divide-y divide-zinc-200 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {flow.map((f) => (
          <div class="p-6 sm:p-8 lg:p-9">
            <Fold>
              <Fragment slot="head">
                <span class="flex items-center gap-2 font-mono type-caption font-normal text-poi-accent">
                  <LucideIcon name={f.icon} class="h-4 w-4" />
                  <span>{f.tag}</span>
                </span>
                <span class="mt-3 block type-subheading font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={f.title} /></span>
              </Fragment>
              <p class="mt-3 type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={f.body} /></p>
            </Fold>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-4 border-t ui-subpanel p-6 sm:flex-row sm:items-center sm:justify-between sm:px-8 sm:py-5 lg:px-9">
        {/* スマホではボタンの行き先の workflow のページに同じ記事のリンクがあるので、ここでは出さない */}
        <div class="relative z-10 hidden flex-wrap items-center gap-x-5 gap-y-2 md:flex">
          <RepoLink {...gddArticle} />
        </div>
        <a
          href="/services/ai-development/workflow/"
          class="inline-flex items-center gap-1.5 self-start rounded-md border border-poi-accent/35 bg-poi-accent/5 px-3.5 py-2 font-mono type-caption text-poi-accent md:after:absolute md:after:inset-0 md:after:content-[''] focus-visible:underline outline-hidden sm:self-auto"
        >
          <span class="lang-ja">3つの図で詳しく見る</span><span class="lang-en">See the workflow in 3 diagrams</span>
          <LucideIcon name="arrow-right" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
        </a>
      </div>
    </article>
  </section>

  {/* 4. Works: Services に出していない公開リポを、仕事・道具・検証を分けずに並べる。スマホでは出さない */}
  <section id="works" class="hidden mt-16 scroll-mt-32 border-t border-zinc-200 pt-12 sm:mt-20 sm:pt-14 dark:border-poi-border/60 md:block">
    <SectionHead
      kicker="Works"
      title={{ ja: '作ったものの一覧', en: "Everything I've Built" }}
      lead={{
        ja: 'Services で紹介したもの以外の公開リポ。自分で使う道具、確かめるために作ったもの、移行のサンプルを分けずに並べている。',
        en: 'Public repositories beyond those in Services: tools I use myself, things built to find something out, and migration samples, listed together.',
      }}
    />
    <div class="mt-6">
      <WorkList works={works} />
    </div>
  </section>
</MainLayout>
