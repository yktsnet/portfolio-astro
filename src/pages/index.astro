---
import MainLayout from '../layouts/MainLayout.astro';
import T from '../components/T.astro';
import Career from '../components/Career.astro';
import SectionHead from '../components/services/SectionHead.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import { services } from '../data/services';
import { siteConfig } from '../site.config';

// 4つのうち3つは導入事例の数字。最後の1つだけ経歴から取る
const numbers = [
  { tag: 'ATTENDANCE', value: { ja: '−5', en: '−5' }, unit: { ja: '時間/月', en: 'h/mo' }, label: { ja: '管理者の勤怠集計の工数', en: 'Admin hours on attendance' } },
  { tag: 'PAYROLL', value: { ja: '−3〜4', en: '−3〜4' }, unit: { ja: '万円/月', en: '×10k JPY/mo' }, label: { ja: '給与計算の月次差異', en: 'Monthly payroll discrepancy' } },
  { tag: 'ADOPTION', value: { ja: '初日', en: 'Day 1' }, unit: { ja: 'から', en: '' }, label: { ja: '説明なしで現場に定着', en: 'Adopted without instructions' } },
  { tag: 'MANAGEMENT', value: { ja: '12', en: '12' }, unit: { ja: '年', en: 'yrs' }, label: { ja: '学習塾の経営', en: 'Running a tutoring school' } },
];

// 見出しの「決めるのは経営から、作るのは現場から、渡すのは教育から」を1枚ずつに分ける
const origins = [
  {
    tag: 'DECIDE',
    from: { ja: '経営から', en: 'From management' },
    title: { ja: '数字から直すものを決める', en: 'Decide what to fix from the numbers' },
    body: {
      ja: '塾と会社の経営では税理士を立てず、決算まで自分でやってきた。だから事業の金がどこを通っているかを自分で読める。依頼を待たず、数字を見て直すものを決めるところから入る。',
      en: 'Running the school and the company, I closed the books myself without an accountant, so I can read where the money moves in a business. I start from the numbers rather than from a brief.',
    },
  },
  {
    tag: 'BUILD',
    from: { ja: '現場から', en: 'From the floor' },
    title: { ja: '現場のやり方を変えずに作る', en: 'Build without changing how people work' },
    body: {
      ja: '塾でも会社でも、仕組みを作るのも毎日使うのも自分だった。手順を一つ増やせばそのまま自分の手間になるので、増やさずに回る形を先に考える。導入時に歓迎された機能が半年後には使われなくなるのも見てきたので、新しい操作を覚えさせず、自動化は既存の運用の裏側に差し込む。',
      en: 'In both businesses, I built the systems and used them every day. Every extra step landed back on me, so I look first for a way to run things without adding steps. Having watched features welcomed at launch go unused six months later, I don\'t make people learn new operations; automation goes in behind the existing work.',
    },
  },
  {
    tag: 'HAND OVER',
    from: { ja: '教育から', en: 'From teaching' },
    title: { ja: '回り出すまで付き合って渡す', en: 'Stay until it runs, then hand it over' },
    body: {
      ja: '教えるときは、言って聞かせるより、生徒が自分で進められるよう場と段取りを整えるほうが続いた。仕組みも納めて終わりにせず、使われ方を見て合わないところを直し、現場で回り出すまで付き合う。',
      en: 'In teaching, setting up the room and the sequence so students could move on their own lasted longer than telling them what to do. Systems are the same: delivery is not the end. I watch how they are used, fix what does not fit, and stay until they run on their own.',
    },
  },
];
---

<MainLayout title={siteConfig.author}>
  {/* 1. About: どういう人か・なぜ1人で回せるかを先に完結させる */}
  <section id="about" class="scroll-mt-28">
    <div class="flex items-center gap-6">
      <img src="/images/profile/me.webp" alt="Katsuhiro Yamakawa" class="h-24 w-24 shrink-0 rounded-full object-cover sm:h-28 sm:w-28" />
      <div>
        <h1 class="type-display font-semibold tracking-tight text-zinc-900 dark:text-poi-focus">Katsuhiro Yamakawa</h1>
        <p class="mt-1 font-mono type-subheading text-poi-accent">Builder</p>
      </div>
    </div>

    <div class="mt-8 sm:mt-10">
      <SectionHead
        kicker="About"
        title={{
          ja: '実装から来た人間ではない。\n事業を回す側にいて、開発もやるようになった。',
          en: "I didn't start out as an engineer.\nI was running the business, and ended up building the systems myself.",
        }}
        lead={{
          ja: '学習塾を12年、合同会社を設立から清算まで経営してきた。いまは受託開発の企業に勤めながら、個人でも開発とコンサルを受け、マンション管理会社の外部CTOも務めている。必要になった仕組みや自分の開発基盤は、小さくOSSとして公開している。',
          en: 'Twelve years running a tutoring school, and an LLC from founding to liquidation. Today I work at a contract development firm, take on development and consulting on my own, and serve as external CTO for a property management company, releasing the tools and development setup I build along the way as small open-source projects.',
        }}
      />
    </div>

    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 border-y border-zinc-200 py-5 sm:mt-10 sm:gap-8 sm:py-6 dark:border-poi-border/60 md:grid-cols-4">
      {numbers.map((n) => (
        <div>
          <dt class="font-mono type-label tracking-widest text-poi-muted">{n.tag}</dt>
          <dd class="mt-2 font-mono type-display font-medium text-poi-accent">
            <T text={n.value} /><span class="ml-0.5 type-caption"><T text={n.unit} /></span>
          </dd>
          <dd class="mt-1 type-caption text-zinc-600 dark:text-poi-muted"><T text={n.label} /></dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 grid gap-12 sm:mt-16 md:grid-cols-2 md:items-start">
      <div>
        <p class="font-mono type-caption tracking-widest uppercase text-poi-muted">PRINCIPLES</p>
        <div class="mt-3 space-y-4">
          {origins.map((o) => (
            <article class="ui-card ui-card-hover p-5 sm:p-6">
              <p class="flex items-baseline justify-between ui-kicker">
                <span>{o.tag}</span>
                <span class="text-poi-accent"><T text={o.from} /></span>
              </p>
              <h3 class="mt-2 type-subheading font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={o.title} /></h3>
              <p class="mt-2 type-small leading-7 text-zinc-600 dark:text-poi-muted"><T text={o.body} /></p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <Career />
      </div>
    </div>
  </section>

  {/* 2. Services: 経営・現場・教育から来ている仕事の受け方 */}
  <section id="services" class="mt-20 scroll-mt-28 border-t border-zinc-200 pt-16 sm:mt-24 sm:pt-20 dark:border-poi-border/60">
    <SectionHead
      kicker="Services"
      title={{
        ja: '経営・現場・教育の3つでやってきたことを、\n2つの仕事として受けている。',
        en: 'What I learned across management, the floor, and teaching,\nI now take on as two areas of work.',
      }}
    />
    <div class="mt-10 space-y-10 sm:mt-12 sm:space-y-12">
      {services.map((s, idx) => <ServiceCard service={s} reverse={idx % 2 === 1} />)}
    </div>
  </section>
</MainLayout>
