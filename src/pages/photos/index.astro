---
import { Image, getImage } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import { photos, type Photo } from "../../data/photos";

// 本文の列は max-w-4xl（896px）で頭打ちになる。full はその全幅、pair は半幅で出る
const FULL_SIZES = "(min-width: 896px) 896px, 100vw";
const PAIR_SIZES = "(min-width: 896px) 444px, 50vw";
const FULL_WIDTHS = [480, 896, 1344, 1792];
const PAIR_WIDTHS = [320, 444, 640, 888];
const widthsFor = (photo: Photo, widths: number[]) =>
  widths.filter((w) => w <= photo.src.width);

const lightboxSrc = new Map(
  await Promise.all(
    photos.map(async (photo) => {
      const img = await getImage({ src: photo.src, width: Math.min(photo.src.width, 2048), format: "webp" });
      return [photo.src.src, img.src] as const;
    })
  )
);

// Group consecutive photos with same location + date
type Section = { id: string; location: string; date: string; items: Photo[] };
const sections: Section[] = [];
for (const photo of photos) {
  const existing = sections.find(
    s => s.location === photo.location && s.date === photo.date
  );
  if (existing) {
    existing.items.push(photo);
  } else {
    sections.push({ id: toSlug(`${photo.location}-${photo.date}`), location: photo.location, date: photo.date, items: [photo] });
  }
}
sections.sort((a, b) => b.date.localeCompare(a.date));

function toSlug(text: string) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
}

// Split a flat array into alternating rhythm chunks: [full, pair, full, pair, ...]
// chunk pattern per 3: [1 full] [2 side-by-side]
function toRhythmChunks(items: Photo[]) {
  const chunks: { type: "full"; photo: Photo } | { type: "pair"; photos: [Photo, Photo] } extends infer C ? C[] : never = [];
  let i = 0;
  while (i < items.length) {
    // full
    chunks.push({ type: "full", photo: items[i] });
    i++;
    // pair (if enough remain)
    if (i < items.length) {
      if (i + 1 < items.length) {
        chunks.push({ type: "pair", photos: [items[i], items[i + 1]] });
        i += 2;
      } else {
        // only one left — render as full
        chunks.push({ type: "full", photo: items[i] });
        i++;
      }
    }
  }
  return chunks;
}
---

<MainLayout title="Photos" description="Photos taken by Katsuhiro Yamakawa." showChat={false}>
  <nav id="photo-index" aria-label="Photo sections" class="mb-16 rounded-md border border-zinc-200/80 px-5 py-4 sm:px-6 sm:py-5 dark:border-poi-border/50">
    <ul class="flex flex-col">
      {sections.map((section) => (
        <li>
          <a href={`#${section.id}`} class="group flex items-baseline gap-4 py-2 text-xs">
            <span class="text-zinc-700 dark:text-poi-text group-hover:text-light-accent dark:group-hover:text-poi-accent">
              {section.location}
            </span>
            <span class="text-zinc-400 dark:text-poi-muted/70">{section.date}</span>
            <span class="ml-auto text-zinc-400 dark:text-zinc-500">{section.items.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="-mx-4 sm:-mx-8">
    {sections.map((section) => (
      <section id={section.id} class="mb-20">
        <!-- 見出しはスクロール中も残し、いまどのセクションかを示す -->
        <div class="sticky top-0 z-10 flex items-baseline gap-3 bg-zinc-50/90 px-4 py-3 mb-3 backdrop-blur dark:bg-poi-base/90 sm:px-8">
          <h2 class="text-sm font-normal text-light-accent dark:text-poi-accent sm:text-base">
            {section.location}
          </h2>
          <span class="font-mono text-xs text-zinc-400 dark:text-poi-muted/70">
            {section.date}
          </span>
          <span class="font-mono text-xs text-zinc-400 dark:text-zinc-500 ml-auto">
            {section.items.length}
          </span>
        </div>

        <!-- Alternating rhythm: full → 2up → full → 2up … -->
        <div class="flex flex-col gap-3">
          {toRhythmChunks(section.items).map((chunk) =>
            chunk.type === "full" ? (
              <button
                class="photo-btn block w-full overflow-hidden cursor-zoom-in group"
                data-src={lightboxSrc.get(chunk.photo.src.src)}
                data-meta={`${chunk.photo.location} · ${chunk.photo.date}`}
                aria-label={`Open photo — ${chunk.photo.location}`}
                type="button"
              >
                <Image
                  src={chunk.photo.src}
                  widths={widthsFor(chunk.photo, FULL_WIDTHS)}
                  sizes={FULL_SIZES}
                  alt={chunk.photo.location}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto block transition-opacity duration-200 group-hover:opacity-75"
                />
              </button>
            ) : (
              <div class="grid grid-cols-2 gap-2">
                {chunk.photos.map((photo) => (
                  <button
                    class="photo-btn block w-full overflow-hidden cursor-zoom-in group"
                    data-src={lightboxSrc.get(photo.src.src)}
                    data-meta={`${photo.location} · ${photo.date}`}
                    aria-label={`Open photo — ${photo.location}`}
                    type="button"
                  >
                    <Image
                      src={photo.src}
                      widths={widthsFor(photo, PAIR_WIDTHS)}
                      sizes={PAIR_SIZES}
                      alt={photo.location}
                      loading="lazy"
                      decoding="async"
                      class="w-full h-auto block transition-opacity duration-200 group-hover:opacity-75"
                    />
                  </button>
                ))}
              </div>
            )
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- Lightbox -->
  <div id="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <img id="lightbox-img" src="" alt="" />
    <p id="lightbox-meta" class="lightbox-meta"></p>
  </div>

  <button
    class="fixed inset-e-4 bottom-8 z-50 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 opacity-0 transition-all duration-300 hover:border-light-accent dark:hover:border-poi-accent sm:inset-e-8 sm:h-12 sm:w-12"
    id="to-top-btn"
  >
    <span class="sr-only">Back to index</span>
    <svg aria-hidden="true" class="h-6 w-6" fill="none" focusable="false"
      stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</MainLayout>

<style>
  #lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 9999;
    cursor: zoom-out;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
  }
  #lightbox.open {
    display: flex;
  }
  #lightbox img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
  }
  .lightbox-meta {
    font-family: "Fira Code", monospace;
    font-size: 0.7rem;
    color: rgba(166, 172, 205, 0.55);
    letter-spacing: 0.05em;
  }
</style>

<script>
  const lightbox = document.getElementById("lightbox")!;
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
  const lightboxMeta = document.getElementById("lightbox-meta")!;

  document.querySelectorAll<HTMLButtonElement>(".photo-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      lightboxImg.src = btn.dataset.src ?? "";
      lightboxMeta.textContent = btn.dataset.meta ?? "";
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    });
  });

  lightbox.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });

  function close() {
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  // Back to index
  const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
  window.addEventListener("scroll", () => {
    const show = window.scrollY > 300;
    scrollBtn.style.opacity = show ? "1" : "0";
    scrollBtn.style.pointerEvents = show ? "auto" : "none";
  });
  scrollBtn.addEventListener("click", () => document.getElementById("photo-index")!.scrollIntoView({ behavior: "smooth" }));
</script>
