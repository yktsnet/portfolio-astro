---
import MainLayout from '../../layouts/MainLayout.astro';
import T from '../../components/T.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import RepoLink from '../../components/RepoLink.astro';
import SectionHead from '../../components/services/SectionHead.astro';
import ServiceDiagram from '../../components/services/ServiceDiagram.astro';
import ProcessSteps from '../../components/services/ProcessSteps.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import OtherServices from '../../components/services/OtherServices.astro';
import { services, type CaseStudy, type Link, type Metric, type Offering, type Repo, type Service } from '../../data/services';
import type { MultilingualText } from '../../lib/i18n';

export function getStaticPaths() {
  // operations は専用のページ（operations.astro）で描く
  return services
    .filter((service) => service.slug !== 'operations')
    .map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
const others = services.filter((o) => o.slug !== s.slug);
---

<MainLayout title={s.title.en} description={s.summary.ja}>
  {/* Hero */}
  <ServiceHero service={s} useHeroCopy />

  {/* 課題 */}
  <section class="mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="Problem" title={{ ja: 'こんな状態になっていないか', en: 'Sound familiar?' }} />
    <div class="mt-5 grid gap-4 sm:mt-6 md:grid-cols-3">
      {s.problems.map((p: Service['problems'][number], idx: number) => (
        <div class="ui-card p-6">
          <p class="font-mono type-label text-poi-accent">0{idx + 1}</p>
          <h3 class="mt-2 type-body font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={p.title} /></h3>
          <p class="mt-1.5 type-caption leading-6 text-zinc-600 dark:text-poi-muted"><T text={p.body} /></p>
        </div>
      ))}
    </div>
  </section>

  {/* 全体図 */}
  <section class="mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="Overview" title={{ ja: '全体の形', en: 'The big picture' }} lead={s.summary} />
    <div class="mt-5 flex justify-center rounded-xl border ui-subpanel p-6 sm:mt-6 sm:p-10">
      <div class="w-full max-w-xl">
        <ServiceDiagram slug={s.slug} />
      </div>
    </div>
  </section>

  {/* 考え方・背景 */}
  <section class="mt-20 sm:mt-24">
    <SectionHead size="heading" kicker={s.stance.kicker} title={s.stance.title} />
    <div class="mt-5 max-w-3xl space-y-4 type-body leading-7 text-zinc-600 sm:mt-6 dark:text-poi-muted">
      {s.stance.body.map((para: MultilingualText) => <p><T text={para} /></p>)}
    </div>
    {s.stance.links && (
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
        {s.stance.links.map((l: Link) => <RepoLink label={l.label} href={l.href} icon="file-text" />)}
      </div>
    )}
  </section>

  {/* 提供できること */}
  <section class="mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="What I offer" title={{ ja: '提供できること', en: 'What I offer' }} />
    <div class:list={["mt-5 grid gap-5 sm:mt-6", s.offerings.length % 2 === 0 ? "md:grid-cols-2" : "md:grid-cols-3"]}>
      {s.offerings.map((o: Offering) => (
        <article class="flex flex-col ui-card p-6">
          <p class="flex items-center gap-2 type-subheading font-semibold text-zinc-900 dark:text-poi-focus">
            <LucideIcon name={o.icon} class="h-4 w-4 text-poi-accent" />
            <T text={o.title} />
          </p>
          <p class="mt-3 type-small leading-7 text-zinc-600 dark:text-poi-muted"><T text={o.body} /></p>
          <ul class="mt-4 space-y-1.5 border-t border-zinc-200 pt-4 dark:border-poi-border/60">
            {o.points.map((pt: MultilingualText) => (
              <li class="flex gap-2 type-caption leading-6 text-zinc-700 dark:text-poi-text">
                <span class="font-mono text-poi-accent" aria-hidden="true">—</span>
                <span><T text={pt} /></span>
              </li>
            ))}
          </ul>
          {(o.repos.length > 0 || o.note) && (
            <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-5">
              {o.repos.map((r: Repo) => <RepoLink label={r.name} href={r.href} />)}
              {o.note && <span class="font-mono type-label text-zinc-500 dark:text-poi-muted"><T text={o.note} /></span>}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  {/* 導入事例（実際に入れた案件のあるサービスだけ） */}
  {s.caseStudy && (
    <section id="case" class="mt-20 scroll-mt-28 sm:mt-24">
      <SectionHead size="heading" kicker="Case" title={{ ja: '導入事例', en: 'Case study' }} />
      <div class="mt-5 grid overflow-hidden ui-card sm:mt-6 md:grid-cols-[1fr_1.2fr]">
        <div class="p-6 sm:p-10">
          <p class="ui-kicker">{s.caseStudy.label}</p>
          <h3 class="mt-3 type-heading font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={s.caseStudy.title} /></h3>
          <p class="mt-4 type-body leading-8 text-zinc-600 dark:text-poi-muted"><T text={s.caseStudy.body} /></p>
        </div>
        <ol class="border-t ui-subpanel p-6 sm:p-10 md:border-t-0 md:border-l">
          {s.caseStudy.timeline.map((t: CaseStudy['timeline'][number], idx: number) => (
            <li class="relative pb-8 pl-7 last:pb-0">
              {idx < s.caseStudy!.timeline.length - 1 && <span class="absolute left-[5px] top-4 bottom-0 w-px bg-zinc-200 dark:bg-poi-border" aria-hidden="true"></span>}
              <span class:list={[
                "absolute left-0 top-1.5 h-3 w-3 rounded-full border-2",
                t.on ? "border-poi-accent bg-poi-accent" : "border-zinc-300 bg-zinc-50 dark:border-poi-border dark:bg-poi-base",
              ]} aria-hidden="true"></span>
              <p class="ui-kicker">{t.tag}</p>
              <p class:list={["mt-1 type-body font-semibold", t.on ? "text-poi-accent" : "text-zinc-900 dark:text-poi-focus"]}><T text={t.title} /></p>
              <p class="mt-1.5 type-small leading-7 text-zinc-600 dark:text-poi-muted"><T text={t.body} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* 成果（数字のあるサービスだけ） */}
  {s.results && (
    <section class="mt-20 sm:mt-24">
      <SectionHead size="heading" kicker="Results" title={{ ja: '導入の成果', en: 'Results' }} lead={s.results.note} />
      <div class="mt-5 grid gap-8 border-t border-zinc-200 pt-6 sm:mt-6 dark:border-poi-border/60 md:grid-cols-3">
        {s.results.metrics.map((m: Metric) => (
          <div>
            <p class="font-mono type-metric font-medium text-poi-accent">
              <T text={m.value} /><span class="ml-1 type-body"><T text={m.unit} /></span>
            </p>
            <p class="mt-1 type-caption text-zinc-600 dark:text-poi-muted"><T text={m.label} /></p>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* 進め方 */}
  <section class="mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="Process" title={{ ja: '進め方', en: 'How it goes' }} />
    <div class="mt-6 sm:mt-8">
      <ProcessSteps steps={s.process} />
    </div>
  </section>

  {/* ほかのサービス */}
  <OtherServices others={others} />

</MainLayout>
