---
import MainLayout from '../../../layouts/MainLayout.astro';
import T from '../../../components/T.astro';
import LucideIcon from '../../../components/LucideIcon.astro';
import RepoLink from '../../../components/RepoLink.astro';
import SectionHead from '../../../components/services/SectionHead.astro';
import DevDiagram from '../../../components/workflow/DevDiagram.astro';
import { services } from '../../../data/services';
import type { MultilingualText } from '../../../lib/i18n';

const gddArticle = 'https://zenn.dev/yktsnet/articles/202608-guarantee-driven-development';
const anthropicArticle = 'https://claude.com/ja/resources/articles/building-agents-when-to-fold-subagents-into-your-main-agent-loop';

type Point = { no: string; title: MultilingualText; body: MultilingualText };
type StepItem = { no: string; title: MultilingualText; tags: string[]; body: MultilingualText };

const overviewPoints: Point[] = [
  {
    no: '01',
    title: {
      ja: '「要件定義担当」ではなく「顧客理解担当」を置く理由',
      en: 'Why "Customer Understanding" instead of "Requirements Analyst"',
    },
    body: {
      ja: 'AI で実装が速くなると、ずれたものを速く作ることが最大の失敗になる。仕様書をまとめる仕事は AI に移し、人の時間は「現場を見て、試作を先に触り、何を作るべきかを決めること」に使う。',
      en: 'When AI makes building fast, the biggest failure is building the wrong thing fast. Spec writing moves to AI; human time goes into observing the site, touching prototypes first, and deciding what to build.',
    },
  },
  {
    no: '02',
    title: {
      ja: '設計書を先に固めず、動く試作で暗黙知を引き出す理由',
      en: 'Why surface tacit knowledge with prototypes instead of upfront specs',
    },
    body: {
      ja: '利用者が慣れで回避している手間や書かれていない例外は、質問表では出てこない。答えを待って文書を重ねるより、仮置きで動く画面を先に見せるほうが、顧客自身も自分の要件に気づける。',
      en: 'Workarounds users take for granted and unwritten edge cases never appear in questionnaires. Showing a working screen built on explicit assumptions lets clients recognize their own needs far faster than piling up documents.',
    },
  },
  {
    no: '03',
    title: {
      ja: '人が見る場所を「書いて渡せない判断」だけに絞る理由',
      en: 'Why restrict human review to judgments that cannot be written down',
    },
    body: {
      ja: '値の照合や手順のチェックに人の注意力を使うとレビューが詰まる。人が止まるのは「約束（AC・保証）の承認」「使い心地」「マージ」だけに固定し、それ以外は別文脈の検証器で流す。',
      en: 'Spending human attention on value matching and procedural checks bottlenecks review. Humans stop only at three gates—approving contracts (ACs & guarantees), UX feel, and merge—while isolated verifiers handle the rest.',
    },
  },
];

const downstreamSteps: StepItem[] = [
  {
    no: '01',
    title: {
      ja: '実装前に Issue で約束を切る',
      en: 'Approve contracts in the Issue before building',
    },
    tags: ['/issue-draft'],
    body: {
      ja: '後から条件を決めると、できたコードに合わせた甘い条件になる。完了条件（AC）と壊さない振る舞い（保証）を先に書き、人が判断すべき項目だけを承認する。',
      en: 'Defining criteria after the code is written leads to lenient tests tailored to the implementation. Acceptance criteria (AC) and invariants (guarantees) are written and approved upfront.',
    },
  },
  {
    no: '02',
    title: {
      ja: '文脈を切って新セッションで1本通しで作る',
      en: 'Build end-to-end in a fresh session',
    },
    tags: ['/issue-work'],
    body: {
      ja: '起票時の相談の文脈を持ち込むと、書かれていない暗黙の了解で実装が進む。Issue だけを渡した新セッションを開き、独立した worktree で3本を並行して作る。',
      en: 'Carrying over the drafting conversation lets unwritten assumptions slip into code. A fresh session receives only the Issue, building up to 3 issues in parallel across isolated worktrees.',
    },
  },
  {
    no: '03',
    title: {
      ja: '作った者は判定しない',
      en: 'The builder never judges its own work',
    },
    tags: ['screen-operator', 'issue-verifier'],
    body: {
      ja: '自分で書いたテストで自分の実装を確かめると、自分の解釈で合格にする。画面は操作役がたどって写真を撮り、人は「使い心地」だけを見る。合否は別文脈の確認者が AC ごとに判定する。',
      en: 'An agent testing its own code grades on its own interpretation. A screen operator captures UI flows so humans check only UX feel, while an isolated verifier judges each AC.',
    },
  },
  {
    no: '04',
    title: {
      ja: '手戻りの原因を仕組みへ還流する',
      en: 'Feed rework causes back into Skills and Hooks',
    },
    tags: ['/rework-review'],
    body: {
      ja: '判定がすべて通れば止まらずに証拠付き PR を出す。実装中にやり直した箇所（手戻り）は PR に記録し、繰り返す原因を集計して Skill の手順と Hook の更新へ戻す。',
      en: 'When all checks pass, an evidence-backed PR is opened without stopping. Rework during implementation is logged in the PR and aggregated to update Skill steps and mechanical Hooks.',
    },
  },
];

// 架空の受注管理案件での見本
const acSampleJa = `## AC（完了条件）
- [ ] 確認書を送り直す画面を開くと、送り先に前回の送り先が入っている
- [ ] 前回の送り先が無い注文では、送り先を空のままにする

## 保証（壊してはいけない振る舞い）
- 送り先を書き換えて送っても、注文マスタの記録は書き換えない`;

const acSampleEn = `## AC (Acceptance Criteria)
- [ ] Opening the resend screen pre-fills the last recipient address
- [ ] Orders without a previous recipient leave the address blank

## Guarantees (Invariants)
- Editing the recipient on resend never mutates the master order record`;

const verdicts: { no: MultilingualText; ac: MultilingualText; evidence: string }[] = [
  {
    no: { ja: 'AC 1', en: 'AC 1' },
    ac: { ja: '前回の送り先が入る', en: 'Pre-fills last recipient address' },
    evidence: 'TestResendPrefillsLastAddress',
  },
  {
    no: { ja: 'AC 2', en: 'AC 2' },
    ac: { ja: '前回が無ければ空のまま', en: 'Leaves blank when no history' },
    evidence: 'TestResendWithoutHistoryLeavesBlank',
  },
  {
    no: { ja: '保証', en: 'Guarantee' },
    ac: { ja: '注文マスタの記録は書き換えない', en: 'Master order record is unchanged' },
    evidence: 'TestResendKeepsAddressHistory',
  },
];
---

<MainLayout title="Workflow — Development Process" description="AI と開発するときの仕組みを、顧客理解と実装の分担と別文脈での検証で図解する。">
  {/* ヒーロー */}
  <section>
    <a href="/" class="inline-flex items-center gap-1.5 font-mono type-caption text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-poi-muted dark:hover:text-poi-focus">
      <span aria-hidden="true">←</span> Top
    </a>
    <p class="mt-8 flex items-center gap-2 font-mono type-caption tracking-widest uppercase text-poi-muted sm:mt-10">
      <LucideIcon name="user-round-pen" class="h-4 w-4 text-poi-accent" />
      <span>Workflow</span>
    </p>
    <h1 class="mt-3 max-w-3xl type-display font-semibold leading-normal tracking-tight text-zinc-900 dark:text-poi-focus">
      <T text={{
        ja: '開発の進め方：顧客理解と実装を分けて行き来する',
        en: 'How I Build: Separating and Connecting Discovery and Implementation',
      }} />
    </h1>
    <p class="mt-4 max-w-2xl type-lead leading-7 text-zinc-600 sm:leading-8 dark:text-poi-muted">
      <T text={{
        ja: 'AI で実装が速くなると、詰まるのは「何を作るか決めること」と「出力の検証」になる。答えを待たずに仮置きで試作して暗黙知を引き出し、作った者とは別の文脈で検証する。',
        en: 'When AI makes coding fast, the bottlenecks shift to deciding what to build and verifying the output. I prototype on explicit assumptions to surface tacit needs and verify in a fresh context.',
      }} />
    </p>
  </section>

  {/* 01: 全体像 */}
  <section id="overview" class="mt-14 scroll-mt-24 sm:mt-16">
    <SectionHead
      size="heading"
      kicker="01 — Big Picture"
      title={{
        ja: '顧客理解担当と実装担当を分け、試作と問いでつなぐ',
        en: 'Connecting Customer Understanding and Implementation',
      }}
      lead={{
        ja: '現場と試作から要件を決める「顧客理解担当」と、約束を切って作る「実装担当」に分ける。文書でやり取りせず、動く試作と問いの Issue で2つの担当を行き来させる。',
        en: 'Customer Understanding decides what to build from the site and prototypes; Implementation builds against approved contracts. The two sides stay connected through working prototypes and question Issues.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="overview" label="顧客理解担当と実装担当を動く試作と問いのIssueでつなぐ全体図" />
      </div>
      <div class="grid divide-y divide-zinc-200 border-t ui-subpanel md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {overviewPoints.map((p) => (
          <div class="p-6 sm:p-7">
            <p class="font-mono type-caption text-zinc-400 dark:text-poi-muted">{p.no}</p>
            <h3 class="mt-1.5 type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={p.title} /></h3>
            <p class="mt-2 type-small leading-6 text-zinc-600 dark:text-poi-muted"><T text={p.body} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 02: 上流 */}
  <section id="upstream" class="mt-20 scroll-mt-24 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="02 — Upstream"
      title={{
        ja: '答えを待たずに「仮置き」で作り、問いの回収と並行させる',
        en: 'Build on Explicit Assumptions in Parallel with Q&A Collection',
      }}
      lead={{
        ja: '受託開発で手が止まる最大の理由は、実装の遅さではなく「先方の回答待ち」にある。実装担当は仮置きで試作を進め、顧客理解担当が並行して問いを照会・回収する。',
        en: 'The biggest delay in contract development is waiting for client answers, not coding speed. Implementation keeps prototyping on explicit assumptions while Customer Understanding sends and collects questions in parallel.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="spec" label="実装担当の仮置き試作と、顧客理解担当の問いの照会・回収を並行させる図" />
      </div>
      <div class="grid divide-y divide-zinc-200 border-t ui-subpanel md:grid-cols-2 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {/* 左列：実装担当 */}
        <div class="p-6 sm:p-7">
          <p class="ui-kicker">Implementation</p>
          <h3 class="mt-1.5 type-body font-semibold text-zinc-900 dark:text-poi-focus">
            <T text={{
              ja: '実装担当：未確定を「仮置き」と「問い」に分けて試作',
              en: 'Implementation: Split unknowns into assumptions and question Issues',
            }} />
          </h3>
          <ul class="mt-3.5 space-y-3">
            <li class="flex gap-3 type-small leading-6">
              <span class="font-mono type-caption text-zinc-400 dark:text-poi-muted pt-0.5">01</span>
              <div class="text-zinc-600 dark:text-poi-muted">
                <p class="font-semibold text-zinc-900 dark:text-poi-focus">
                  <T text={{ ja: '仮置き一覧に分離して作る', en: 'Isolate in an assumption list' }} />
                </p>
                <p class="mt-0.5">
                  <T text={{
                    ja: 'AI が黙って選んだ前提がそのまま本番に残らないよう、仮に置いた仕様は一覧に明記して確定分と分ける。',
                    en: 'So silent AI guesses never slip into production, provisional choices are recorded in a dedicated assumption list separate from confirmed specs.',
                  }} />
                </p>
              </div>
            </li>
            <li class="flex gap-3 type-small leading-6">
              <span class="font-mono type-caption text-zinc-400 dark:text-poi-muted pt-0.5">02</span>
              <div class="text-zinc-600 dark:text-poi-muted">
                <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-semibold text-zinc-900 dark:text-poi-focus">
                  <span><T text={{ ja: '問いを起こし、回答を読む', en: 'Open questions & apply answers' }} /></span>
                  <code class="inline-flex items-center rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-1.5 py-0.5 font-mono type-label font-normal text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:hover:bg-poi-panel/50 dark:hover:text-poi-focus select-none">/client-next</code>
                </p>
                <p class="mt-0.5">
                  <T text={{
                    ja: '先方の判断が要る点は同じ変更で「問いの Issue」に起こして渡す。戻った回答は次の起票時に読み、仮置きと違えば直しの Issue にする。',
                    en: 'Items needing client decisions are opened as Question Issues in the same change. Returned answers are read on the next draft and turned into fix Issues if they differ.',
                  }} />
                </p>
              </div>
            </li>
          </ul>
        </div>

        {/* 右列：顧客理解担当 */}
        <div class="p-6 sm:p-7">
          <p class="ui-kicker">Customer Understanding</p>
          <h3 class="mt-1.5 type-body font-semibold text-zinc-900 dark:text-poi-focus">
            <T text={{
              ja: '顧客理解担当：照会・回収を回し、試作から要件を決める',
              en: 'Customer Understanding: Run Q&A skills and decide specs from prototypes',
            }} />
          </h3>
          <ul class="mt-3.5 space-y-3">
            <li class="flex gap-3 type-small leading-6">
              <span class="font-mono type-caption text-zinc-400 dark:text-poi-muted pt-0.5">03</span>
              <div class="text-zinc-600 dark:text-poi-muted">
                <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 font-semibold text-zinc-900 dark:text-poi-focus">
                  <span class="mr-0.5"><T text={{ ja: '照会と1か所への回収', en: 'Send & centralize answers' }} /></span>
                  <code class="inline-flex items-center rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-1.5 py-0.5 font-mono type-label font-normal text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:hover:bg-poi-panel/50 dark:hover:text-poi-focus select-none">/qa-send</code>
                  <code class="inline-flex items-center rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-1.5 py-0.5 font-mono type-label font-normal text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:hover:bg-poi-panel/50 dark:hover:text-poi-focus select-none">/qa-collect</code>
                </p>
                <p class="mt-0.5">
                  <T text={{
                    ja: '照会文面を下書きして送り、照会表・MTG・チャットのどこで出た回答も問いの Issue 1か所に集約する。',
                    en: 'Draft inquiries to send, and funnel answers from spreadsheets, meetings, or chat into a single Question Issue.',
                  }} />
                </p>
              </div>
            </li>
            <li class="flex gap-3 type-small leading-6">
              <span class="font-mono type-caption text-zinc-400 dark:text-poi-muted pt-0.5">04</span>
              <div class="text-zinc-600 dark:text-poi-muted">
                <p class="font-semibold text-zinc-900 dark:text-poi-focus">
                  <T text={{ ja: '2段階レビューと正本の更新', en: 'Two-stage review & canonical spec updates' }} />
                </p>
                <p class="mt-0.5">
                  <T text={{
                    ja: '試作を利用者より先に触り（社内レビュー）、直ったものを利用者に見せて反応を引き出す（利用者レビュー）。決まった要件を正本へマージするのはこの担当だけに絞る。',
                    en: 'Touch the prototype before users do (internal review), then show the refined version to users to draw out feedback. Only this role merges confirmed specs.',
                  }} />
                </p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 03: 下流 */}
  <section id="downstream" class="mt-20 scroll-mt-24 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="03 — Downstream"
      title={{
        ja: '約束を先に承認し、作った者とは別の文脈で判定する',
        en: 'Approve Contracts First, Verify in an Isolated Context',
      }}
      lead={{
        ja: 'エージェントは検証器が見ているものを解く。人が全差分を読む代わりに、入口で「完了条件（AC）」と「壊さない保証」を承認し、出口では別文脈の確認者が証拠付きで検証する。',
        en: 'Agents optimize for what the verifier checks. Instead of reading every diff line by line, humans approve ACs and guarantees at the entrance, and an isolated verifier checks them with evidence at the exit.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="verify" label="約束の承認から1セッションでの実装、別文脈の確認者による判定、PRと手戻り還流までの図" />
      </div>

      {/* 下段：左に01〜04の手順、右に実際の成果物（IssueのACとPRの判定表） */}
      <div class="grid divide-y divide-zinc-200 border-t ui-subpanel lg:grid-cols-12 lg:divide-x lg:divide-y-0 dark:divide-poi-border/60">
        <div class="flex flex-col justify-between p-6 sm:p-7 lg:col-span-7">
          <div>
            <p class="ui-kicker">Verification Flow</p>
            <ol class="mt-3.5 space-y-3.5">
              {downstreamSteps.map((st) => (
                <li class="flex gap-3">
                  <span class="font-mono type-caption text-zinc-400 dark:text-poi-muted pt-1">{st.no}</span>
                  <div class="type-small leading-6">
                    <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 font-semibold text-zinc-900 dark:text-poi-focus">
                      <span class="mr-0.5"><T text={st.title} /></span>
                      {st.tags.map((tag) => (
                        <code class="inline-flex items-center gap-1 rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-1.5 py-0.5 font-mono type-label font-normal text-zinc-600 transition-colors duration-200 hover:bg-zinc-100 hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:hover:bg-poi-panel/50 dark:hover:text-poi-focus select-none">
                          {!tag.startsWith('/') && <LucideIcon name="bot" class="h-3 w-3 text-poi-accent" />}
                          <span>{tag}</span>
                        </code>
                      ))}
                    </p>
                    <p class="mt-0.5 text-zinc-600 dark:text-poi-muted"><T text={st.body} /></p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="mt-6 border-t border-zinc-200/80 pt-4 dark:border-poi-border/50">
            <RepoLink label="Zenn — 保証駆動開発 (GDD)" href={gddArticle} icon="zenn" />
          </div>
        </div>

        <div class="flex flex-col justify-between divide-y divide-zinc-200 lg:col-span-5 dark:divide-poi-border/60">
          <div class="p-6 sm:p-7">
            <p class="ui-kicker">Sample 01 — <T text={{ ja: 'Issue の AC と保証', en: 'Issue ACs & Guarantees' }} /></p>
            <pre class="lang-ja mt-3 overflow-x-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-white p-3.5 type-small leading-6 text-zinc-700 dark:border-poi-border/60 dark:bg-poi-base/60 dark:text-poi-text">{acSampleJa}</pre>
            <pre class="lang-en mt-3 overflow-x-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-white p-3.5 type-small leading-6 text-zinc-700 dark:border-poi-border/60 dark:bg-poi-base/60 dark:text-poi-text">{acSampleEn}</pre>
          </div>
          <div class="p-6 sm:p-7">
            <p class="ui-kicker">Sample 03→04 — <T text={{ ja: 'PR 本文に載る確認者の判定', en: 'Verifier table in PR body' }} /></p>
            <ul class="mt-3 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white px-4 dark:divide-poi-border/60 dark:border-poi-border/60 dark:bg-poi-base/60">
              {verdicts.map((v) => (
                <li class="group flex items-center justify-between gap-3 py-3">
                  <div class="min-w-0">
                    <p class="flex items-baseline gap-2 type-small leading-5 text-zinc-900 dark:text-poi-focus">
                      <span class="shrink-0 font-mono type-label text-zinc-400 dark:text-poi-muted"><T text={v.no} /></span>
                      <span><T text={v.ac} /></span>
                    </p>
                    <p class="mt-1 truncate font-mono type-label text-zinc-500 dark:text-poi-muted">{v.evidence}</p>
                  </div>
                  <span class="inline-flex shrink-0 items-center gap-1 rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-2 py-0.5 font-mono type-label text-zinc-600 transition-colors duration-200 group-hover:bg-zinc-100 group-hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:group-hover:bg-poi-panel/50 dark:group-hover:text-poi-focus select-none">
                    <LucideIcon name="check" class="h-3 w-3 text-poi-accent" />
                    PASS
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 04: 補足（01〜03の後ろに小さく添える1枚のまとめ） */}
  <section id="decisions" class="mt-20 scroll-mt-24 sm:mt-24">
    <SectionHead
      size="heading"
