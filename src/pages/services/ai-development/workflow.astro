---
import MainLayout from '../../../layouts/MainLayout.astro';
import TrailGrid from '../../../components/TrailGrid.astro';
import T from '../../../components/T.astro';
import LucideIcon from '../../../components/LucideIcon.astro';
import RepoLink from '../../../components/RepoLink.astro';
import SectionHead from '../../../components/SectionHead.astro';
import DevDiagram from '../../../components/workflow/DevDiagram.astro';
import WfContrast from '../../../components/workflow/WfContrast.astro';
import SkillTag from '../../../components/workflow/SkillTag.astro';
import OtherServices from '../../../components/services/OtherServices.astro';
import { services } from '../../../data/services';
import { gddArticle } from '../../../data/articles';
import { overviewPoints, upstreamCols, downstreamSteps, acSampleJa, acSampleEn, verdicts, decisions } from '../../../data/workflow';
import type { SectionLink } from '../../../types';
import Fold from '../../../components/Fold.astro';
import FoldToggle from '../../../components/FoldToggle.astro';

const sections: SectionLink[] = [
  { id: 'overview', label: { ja: '全体像', en: 'Big picture' } },
  { id: 'upstream', label: { ja: '上流', en: 'Upstream' } },
  { id: 'downstream', label: { ja: '下流', en: 'Downstream' } },
  { id: 'decisions', label: { ja: '設計判断とガード', en: 'Decisions & guards' } },
];

---

<MainLayout title="Development Workflow" description="AI と開発するときの仕組みを、顧客理解と実装の分担と別文脈での検証で図解する。" sections={sections}>
  {/* ヒーロー */}
  <section>
    <a href="/" class="inline-flex items-center gap-1.5 font-mono type-caption text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-poi-muted dark:hover:text-poi-focus">
      <span aria-hidden="true">←</span> Top
    </a>
    <p class="mt-8 flex items-center gap-2 font-mono type-caption tracking-widest uppercase text-zinc-500 dark:text-poi-muted sm:mt-10">
      <LucideIcon name="user-round-pen" class="h-4 w-4 text-poi-accent" />
      <span>Workflow</span>
    </p>
    <h1 class="mt-3 max-w-3xl type-display font-semibold leading-normal tracking-tight text-zinc-900 dark:text-poi-focus">
      <T text={{
        ja: '開発の進め方：顧客理解と実装を分けて行き来する',
        en: 'Development workflow: separating and connecting customer understanding and implementation',
      }} />
    </h1>
    <p class="mt-4 max-w-2xl type-lead leading-7 text-zinc-600 sm:leading-8 dark:text-poi-muted">
      <T text={{
        ja: 'AI で実装が速くなると、詰まるのは「何を作るか決めること」と「出力の検証」になる。答えを待たずに仮置きで試作して暗黙知を引き出し、作った者とは別の文脈で検証する。',
        en: 'When AI makes coding fast, the bottlenecks shift to deciding what to build and verifying the output. I prototype on explicit assumptions to surface tacit needs and verify in a fresh context.',
      }} />
    </p>
  </section>

  {/* 01: 全体像 */}
  <TrailGrid variant="divider" class="mt-14 sm:mt-16" />
  <section id="overview" class="mt-14 scroll-mt-32 sm:mt-16">
    <SectionHead
      size="heading"
      kicker="Big Picture"
      title={{
        ja: '顧客理解担当と実装担当を分け、試作と問いでつなぐ',
        en: 'Separate customer understanding from implementation, and connect them with prototypes and questions',
      }}
      lead={{
        ja: '現場と試作から要件を決める「顧客理解担当」と、約束を切って作る「実装担当」に分ける。文書でやり取りせず、動く試作と問いの Issue で2つの担当を行き来させる。',
        en: 'Customer Understanding decides what to build from the site and prototypes; Implementation builds against approved promises. The two sides stay connected through working prototypes and question Issues.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="overview" label="顧客理解担当と実装担当を動く試作と問いのIssueでつなぐ全体図" />
      </div>
      <div data-fold-group class="border-t ui-subpanel">
      <FoldToggle variant="band" class="border-b px-6 py-3 dark:border-poi-border/60" />
      <div class="grid grid-cols-1 divide-y divide-zinc-200 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {overviewPoints.map((p) => (
          <div class="p-6 sm:p-7">
            <Fold>
              <Fragment slot="head">
                <span class="block font-mono type-caption font-normal text-zinc-400 dark:text-poi-muted">{p.no}</span>
                <span class="mt-1.5 block type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={p.title} /></span>
              </Fragment>
              <p class="mt-2 type-body leading-7 text-zinc-700 dark:text-poi-muted"><T text={p.body} /></p>
            </Fold>
          </div>
        ))}
      </div>
      </div>
    </div>
    <WfContrast
      title={{
        ja: '要件を文書で固めて、現場にしかない情報を落とす',
        en: 'Locking requirements in documents and losing what only the site knows',
      }}
      body={{
        ja: '要件を決める人まで実装の確認に追われると、現場にしかない情報を拾う時間がなくなる。',
        en: 'When the person deciding requirements is also tied up checking the build, there is no time left to pick up what only the site knows.',
      }}
      fix={{
        ja: '顧客理解の担当を実装から切り離し、現場を見て試作を触ってもらうことに時間を充てる。',
        en: 'Customer Understanding is kept apart from implementation, and its time goes to observing the site and putting prototypes in front of users.',
      }}
    />
  </section>

  {/* 02: 上流 */}
  <section id="upstream" class="mt-20 scroll-mt-32 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="Upstream"
      title={{
        ja: '答えを待たずに「仮置き」で作り、問いの回収と並行させる',
        en: 'Build on explicit assumptions in parallel with Q&A collection',
      }}
      lead={{
        ja: '受託開発で手が止まる最大の理由は、実装の遅さではなく「先方の回答待ち」にある。',
        en: 'The biggest delay in contract development is waiting for client answers, not coding speed.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="spec" label="実装担当の仮置き試作と、顧客理解担当の問いの照会・回収を並行させる図" />
      </div>
      <div data-fold-group class="border-t ui-subpanel">
      <FoldToggle variant="band" class="border-b px-6 py-3 dark:border-poi-border/60" />
      <div class="grid grid-cols-1 divide-y divide-zinc-200 md:grid-cols-2 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {/* Skill のラベルは本文の先頭の行に置き、スマホで見出しだけを並べたときに混ぜない */}
        {upstreamCols.map((col) => (
          <div class="p-6 sm:p-7">
            <p class="ui-kicker">{col.kicker}</p>
            <h3 class="mt-1.5 type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={col.title} /></h3>
            <ul class="mt-3.5 space-y-3">
              {col.items.map((st) => (
                <li class="flex gap-3">
                  <span class="pt-0.5 font-mono type-caption text-zinc-400 dark:text-poi-muted">{st.no}</span>
                  <Fold as="p" class="min-w-0 flex-1 type-small leading-6">
                    <span slot="head" class="font-semibold text-zinc-900 dark:text-poi-focus"><T text={st.title} /></span>
                    {st.tags.length > 0 && (
                      <p class="mt-1 flex flex-wrap gap-1.5">
                        {st.tags.map((tag) => (
                          <SkillTag name={tag}>
                            {!tag.startsWith('/') && <LucideIcon name="bot" class="h-3 w-3 text-poi-accent" />}
                            <span>{tag}</span>
                          </SkillTag>
                        ))}
                      </p>
                    )}
                    <p class="mt-1 text-zinc-700 dark:text-poi-muted"><T text={st.body} /></p>
                  </Fold>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      </div>
    </div>
    <WfContrast
      title={{
        ja: '曖昧な点を、AI が聞き返さずに埋める',
        en: 'AI filling in ambiguity without asking',
      }}
      body={{
        ja: 'どこを推測したかが残らないので、誰も確かめないまま本番に入る。',
        en: 'Nothing records where it guessed, so the guesses reach production with no one checking.',
      }}
      fix={{
        ja: '仮に決めた点は仮置き一覧に分けて残し、先方の判断が要る点は問いの Issue にする。',
        en: 'Provisional choices are kept apart in the assumption list, and anything the client must decide becomes a Question Issue.',
      }}
    />
  </section>

  {/* 03: 下流 */}
  <section id="downstream" class="mt-20 scroll-mt-32 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="Downstream"
      title={{
        ja: '約束を先に承認し、作った者とは別の文脈で判定する',
        en: 'Approve promises first, verify in an isolated context',
      }}
      lead={{
        ja: 'エージェントは検証器が見ているものを解く。人が全差分を読む代わりに、入口で「完了条件（AC）」と「壊さない保証」を承認し、出口では別文脈の確認者が証拠付きで検証する。',
        en: 'Agents optimize for what the verifier checks. Instead of reading every diff line by line, humans approve ACs and guarantees at the entrance, and an isolated verifier checks them with evidence at the exit.',
      }}
    />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="p-6 sm:p-8">
        <DevDiagram kind="verify" label="約束の承認から1セッションでの実装、別文脈の確認者による判定、PRと手戻り還流までの図" />
      </div>

      {/* 下段：左に01〜04の手順、右に実際の成果物（IssueのACとPRの判定表） */}
      <div data-fold-group class="border-t ui-subpanel">
      <FoldToggle variant="band" class="border-b px-6 py-3 dark:border-poi-border/60" />
      <div class="grid grid-cols-1 divide-y divide-zinc-200 lg:grid-cols-12 lg:divide-x lg:divide-y-0 dark:divide-poi-border/60">
        <div class="flex flex-col justify-between p-6 sm:p-7 lg:col-span-7">
          <div>
            {/* 手順の本文には、そうする理由だけを書く。やり方は上の図と見出しが示している */}
            <p class="ui-kicker">Verification Flow</p>
            <ol class="mt-3.5 space-y-3.5">
              {downstreamSteps.map((st) => (
                <li class="flex gap-3">
                  <span class="pt-0.5 font-mono type-caption text-zinc-400 dark:text-poi-muted">{st.no}</span>
                  <Fold as="p" class="min-w-0 flex-1 type-small leading-6">
                    <span slot="head" class="font-semibold text-zinc-900 dark:text-poi-focus"><T text={st.title} /></span>
                    {st.tags.length > 0 && (
                      <p class="mt-1 flex flex-wrap gap-1.5">
                        {st.tags.map((tag) => (
                          <SkillTag name={tag}>
                            {!tag.startsWith('/') && <LucideIcon name="bot" class="h-3 w-3 text-poi-accent" />}
                            <span>{tag}</span>
                          </SkillTag>
                        ))}
                      </p>
                    )}
                    <p class="mt-1 text-zinc-700 dark:text-poi-muted"><T text={st.body} /></p>
                  </Fold>
                </li>
              ))}
            </ol>
          </div>
          <div class="mt-6 border-t border-zinc-200/80 pt-4 dark:border-poi-border/50">
            <RepoLink {...gddArticle} />
          </div>
        </div>

        <div class="flex flex-col justify-between divide-y divide-zinc-200 lg:col-span-5 dark:divide-poi-border/60">
          <Fold as="p" class="p-6 sm:p-7">
            <span slot="head" class="ui-kicker">Sample 01 — <T text={{ ja: 'Issue の AC と保証', en: 'Issue ACs & Guarantees' }} /></span>
            <pre class="lang-ja mt-3 overflow-x-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-white p-3.5 type-small leading-6 text-zinc-700 dark:border-poi-border/60 dark:bg-poi-base/60 dark:text-poi-text">{acSampleJa}</pre>
            <pre class="lang-en mt-3 overflow-x-auto whitespace-pre-wrap rounded-lg border border-zinc-200 bg-white p-3.5 type-small leading-6 text-zinc-700 dark:border-poi-border/60 dark:bg-poi-base/60 dark:text-poi-text">{acSampleEn}</pre>
          </Fold>
          <Fold as="p" class="p-6 sm:p-7">
            <span slot="head" class="ui-kicker">Sample 03→04 — <T text={{ ja: 'PR 本文に載る確認者の判定', en: 'Verifier table in PR body' }} /></span>
            <ul class="mt-3 divide-y divide-zinc-200 rounded-lg border border-zinc-200 bg-white px-4 dark:divide-poi-border/60 dark:border-poi-border/60 dark:bg-poi-base/60">
              {verdicts.map((v) => (
                <li class="group flex items-center justify-between gap-3 py-3">
                  <div class="min-w-0">
                    <p class="flex items-baseline gap-2 type-small leading-5 text-zinc-900 dark:text-poi-focus">
                      <span class="shrink-0 font-mono type-label text-zinc-400 dark:text-poi-muted"><T text={v.no} /></span>
                      <span><T text={v.ac} /></span>
                    </p>
                    <p class="mt-1 break-all font-mono type-label text-zinc-500 dark:text-poi-muted">{v.evidence}</p>
                  </div>
                  <span class="inline-flex shrink-0 items-center gap-1 rounded-sm border border-zinc-200/70 bg-zinc-100/70 px-2 py-0.5 font-mono type-label text-zinc-600 transition-colors duration-200 group-hover:bg-zinc-100 group-hover:text-zinc-900 dark:border-poi-border/40 dark:bg-poi-panel/25 dark:text-poi-muted dark:group-hover:bg-poi-panel/50 dark:group-hover:text-poi-focus select-none">
                    <LucideIcon name="check" class="h-3 w-3 text-poi-accent" />
                    PASS
                  </span>
                </li>
              ))}
            </ul>
          </Fold>
        </div>
      </div>
      </div>
    </div>
    <WfContrast
      title={{
        ja: '検証を、作った AI か人の目視に任せる',
        en: 'Leaving verification to the builder AI or to human eyes',
      }}
      body={{
        ja: '人が全差分を読もうとしても量に追いつかず、承認が形だけになる。',
        en: 'Humans who try to read every diff cannot keep up, and approval becomes a rubber stamp.',
      }}
      fix={{
        ja: '完了条件と保証は作る前に人が承認し、合否は作った者とは別の文脈で判定する。',
        en: 'ACs and guarantees are approved by a human before building, and pass or fail is judged in a context separate from the builder.',
      }}
    />
  </section>

  {/* 04: 補足（01〜03の後ろに小さく添える1枚のまとめ） */}
  <section id="decisions" class="mt-20 scroll-mt-32 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="Architecture & Guards"
      title={{
        ja: 'この型を支える設計判断とガード',
        en: 'Architectural decisions and mechanical guards',
      }}
    />
    <div data-fold-group class="mt-5 sm:mt-6">
    <FoldToggle class="mb-5" />
    <div class="grid gap-10 md:grid-cols-2 md:gap-8">
      {decisions.map((d) => (
          <div class="border-t-2 border-zinc-300 pt-5 dark:border-poi-border">
            <Fold>
              <Fragment slot="head">
                <span class="block ui-kicker font-normal">{d.kicker}</span>
                <span class="mt-1.5 block type-body font-semibold text-zinc-900 dark:text-poi-focus"><T text={d.title} /></span>
              </Fragment>
              <ul class="mt-3 space-y-2">
                {d.items.map((it) => (
                  <li class="flex gap-2 type-small leading-6 text-zinc-700 dark:text-poi-muted">
                    <span aria-hidden="true">·</span>
                    <span>
                      <strong class="font-semibold text-zinc-900 dark:text-poi-focus"><T text={it.lead} /></strong>
                      <T text={it.body} />
                    </span>
                  </li>
                ))}
              </ul>
            </Fold>
          </div>
        ))}
    </div>
    </div>
  </section>

  {/* サービスへのリンク（2つ・右寄せ） */}
  <OtherServices others={services} />
</MainLayout>
