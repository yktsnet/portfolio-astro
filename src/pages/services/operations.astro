---
import MainLayout from '../../layouts/MainLayout.astro';
import TrailGrid from '../../components/TrailGrid.astro';
import T from '../../components/T.astro';
import RepoLink from '../../components/RepoLink.astro';
import FoldToggle from '../../components/FoldToggle.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceDiagram from '../../components/services/ServiceDiagram.astro';
import ServiceHero from '../../components/services/ServiceHero.astro';
import OtherServices from '../../components/services/OtherServices.astro';
import MetricGrid from '../../components/services/MetricGrid.astro';
import OfferingDetailCard from '../../components/services/OfferingDetailCard.astro';
import ProcessSteps from '../../components/services/ProcessSteps.astro';
import FitList from '../../components/services/FitList.astro';
import { cases } from '../../data/cases';
import { services } from '../../data/services';
import type { SectionLink } from '../../types';
import { offeringDetails, options, compare, steps, fits, misfits, zenn } from '../../data/operations';

// サービス名・説明・提供できることの名前はトップのカードと同じ値を使い、文言をずらさない
const s = services.find((x) => x.slug === 'operations')!;
const others = services.filter((x) => x.slug !== 'operations');

// 数字はトップの CASE と同じ値を使い、言い方をずらさない
const { metrics } = cases.find((c) => c.service === 'operations')!;

const sections: SectionLink[] = [
  { id: 'overview', label: { ja: '概要', en: 'Overview' } },
  { id: 'case', label: { ja: '導入例', en: 'Case' } },
  { id: 'offer', label: { ja: '提供できること', en: 'Offer' } },
  { id: 'compare', label: { ja: '比較', en: 'Compare' } },
  { id: 'process', label: { ja: '進め方', en: 'Process' } },
  { id: 'fit', label: { ja: '合う現場', en: 'Fit' } },
];
---

<MainLayout title={s.title.en} description={`${s.title.ja}。${s.summary.ja}`} sections={sections}>
  {/* 1. サービス名と説明、概念の図（どれもトップのカードと同じもの） */}
  <ServiceHero service={s}>
    <ServiceDiagram slot="diagram" slug={s.slug} />
  </ServiceHero>

  {/* 2. 導入の結果: 数字、事例の背景、経緯を書いた記事 */}
  <TrailGrid variant="divider" class="mt-14 sm:mt-16" />
  <section id="case" class="scroll-mt-32 mt-14 sm:mt-16">
    <SectionHead size="heading" kicker="Case & Results" title={{ ja: '導入例：マンション管理会社', en: 'Example: a property management company' }} />
    <div class="ui-card mt-5 overflow-hidden sm:mt-6">
      <MetricGrid metrics={metrics} />
      <div class="border-t ui-subpanel p-6 sm:p-7">
        <p class="max-w-3xl type-body leading-7 text-zinc-700 dark:text-poi-text">
          <T text={{
            ja: '高齢のオーナーは引退を見据えて現場を離れたがっていたが、経営の実務が特定の人に頼ったままで、離れられなかった。そこに外部から入り、勤怠と書類作成を自動にした。いまも外部CTOとして関わり、空室の情報を事業者に届けるWebアプリを作っている（作成中）。',
            en: 'The aging owner wanted to step back ahead of retirement, but day-to-day management depended on specific people. I came in from outside and automated attendance and paperwork. I am still there as external CTO, now building a web app that delivers vacancy information to partner businesses (in progress).',
          }} />
        </p>
        <p class="mt-3 max-w-3xl type-body leading-7 text-zinc-700 dark:text-poi-muted">
          <T text={{
            ja: '自動化とは別に、法人化の手続きも支援している。経営の実務を自分でやってきたので、こうした相談も受けられる。',
            en: 'Apart from automation, I am also guiding the company through incorporation. Having run the books myself, I can take on requests like this too.',
          }} />
        </p>
        <div class="mt-4">
          <RepoLink label={{ ja: `Zenn — ${zenn.title.ja}`, en: `Zenn — ${zenn.title.en}` }} href={zenn.href} icon="zenn" />
        </div>
      </div>
    </div>
  </section>

  {/* 3. 提供できること */}
  <section id="offer" class="scroll-mt-32 mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="What I offer" title={{ ja: '提供できること', en: 'What I offer' }} />
    <div class="mt-5 grid gap-6 sm:mt-6 lg:grid-cols-2">
      {s.offerings.map((o, idx) => {
        const d = offeringDetails[idx];
        return (
          <OfferingDetailCard offering={o} detail={d}>
            <p class="border-t border-zinc-200 pt-5 type-caption leading-6 text-zinc-600 dark:border-poi-border/60 dark:text-poi-muted">
              <span class="font-semibold text-zinc-800 dark:text-poi-text"><T text={{ ja: '必要なもの：', en: 'Needs: ' }} /></span>
              <T text={d.needs} />
            </p>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
              {o.repos.map((r) => <RepoLink label={r.name} href={r.href} />)}
            </div>
          </OfferingDetailCard>
        );
      })}
    </div>
  </section>

  {/* 3b. ほかの頼み方との違い: 経営者が SaaS や開発会社と比べて選べるようにする */}
  <section id="compare" class="scroll-mt-32 mt-20 sm:mt-24">
    <SectionHead size="heading" kicker="Comparison" title={{ ja: 'SaaS・開発会社との違い', en: 'Compared with SaaS and dev firms' }} />
    <div data-fold-group class="ui-card mt-5 overflow-hidden sm:mt-6">
      <div class="hidden border-b ui-subpanel md:grid md:grid-cols-[9rem_1fr_1fr_1.3fr]">
        <span></span>
        {options.map((o, i) => (
          <p class:list={['px-5 py-3.5 type-caption font-semibold', i === 2 ? 'text-poi-accent' : 'text-zinc-500 dark:text-poi-muted']}><T text={o} /></p>
        ))}
      </div>
      {/* スマホでは自分の場合だけを出す。SaaS と開発会社は、4行をまとめて開く1つのボタンで出し、開くと左右に並ぶ */}
      <FoldToggle variant="band" class="border-b ui-subpanel px-5 py-3">
        SaaS・開発会社の場合と並べる
      </FoldToggle>
      <div class="divide-y divide-zinc-200 dark:divide-poi-border/60">
        {compare.map((row) => (
          <div class="grid grid-cols-2 md:grid-cols-[9rem_1fr_1fr_1.3fr]">
            <p class="col-span-2 px-5 pt-4 type-small font-semibold text-zinc-900 md:col-span-1 md:py-4 dark:text-poi-focus"><T text={row.point} /></p>
            {row.cells.map((c, i) => (
              <p class:list={[
                'type-small leading-6',
                i === 0 && 'fold-body py-2 pl-5 pr-2 text-zinc-500 md:px-5 md:py-4 dark:text-poi-muted',
                i === 1 && 'fold-body py-2 pl-2 pr-5 text-zinc-500 md:px-5 md:py-4 dark:text-poi-muted',
                i === 2 && 'col-span-2 mx-5 mb-4 mt-1.5 rounded-lg bg-poi-accent/5 px-3.5 py-2.5 text-zinc-900 md:col-span-1 md:m-0 md:rounded-none md:px-5 md:py-4 dark:text-poi-focus',
              ]}>
                <span class:list={['mb-0.5 block type-label md:hidden', i === 2 ? 'text-poi-accent' : '']}><T text={options[i]} /></span>
                <T text={c} />
              </p>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p class="mt-3 type-caption text-zinc-500 dark:text-poi-muted">
      <T text={{ ja: 'SaaSと開発会社の列は、一般的な場合を書いている。', en: 'The SaaS and dev firm columns describe the typical case.' }} />
    </p>
  </section>

  {/* 4. 進め方: 考え方はトップに任せ、ここでは導入例で実際にどうしたかだけを書く */}
  <section id="process" class="scroll-mt-32 mt-20 sm:mt-24">
    <SectionHead
      size="heading"
      kicker="Process"
      title={{ ja: '進め方', en: 'How I work' }}
      lead={{ ja: 'マンション管理会社では、この順に進めた。', en: 'At the property management company, it went in this order.' }}
    />
    <ProcessSteps steps={steps} />
  </section>

  {/* 5. 合う現場・合わない現場 */}
  <FitList fits={fits} misfits={misfits} />

  {/* 6. ほかのサービス */}
  <OtherServices others={others} />
</MainLayout>

