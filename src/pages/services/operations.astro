---
import MainLayout from '../../layouts/MainLayout.astro';
import T from '../../components/T.astro';
import LucideIcon from '../../components/LucideIcon.astro';
import RepoLink from '../../components/RepoLink.astro';
import { services } from '../../data/services';
import type { MultilingualText } from '../../lib/i18n';

// サービス名・説明・提供できることの名前はトップのカードと同じ値を使い、文言をずらさない
const s = services.find((x) => x.slug === 'operations')!;
const others = services.filter((x) => x.slug !== 'operations');

type Metric = { value: MultilingualText; unit: MultilingualText; label: MultilingualText };
type Decision = { title: MultilingualText; body: MultilingualText };
type OfferingDetail = {
  line: MultilingualText;
  before: MultilingualText[];
  after: MultilingualText[];
  decisions: Decision[];
  needs: MultilingualText;
};
type Step = { no: string; title: MultilingualText; why: MultilingualText; done: MultilingualText };
type Fit = { text: MultilingualText; reason?: MultilingualText };

const metrics: Metric[] = [
  {
    value: { ja: '−5', en: '−5' },
    unit: { ja: '時間/月', en: 'h/mo' },
    label: { ja: '管理者が勤怠の集計にかけていた時間', en: 'Admin time spent tallying attendance' },
  },
  {
    value: { ja: '−3〜4', en: '−30–40k' },
    unit: { ja: '万円/月', en: 'JPY/mo' },
    label: { ja: '打刻の偽装と記入漏れで出ていた給与の差異', en: 'Payroll gap from faked or missed clock-ins' },
  },
  {
    value: { ja: '初日', en: 'Day one' },
    unit: { ja: 'から', en: '' },
    label: { ja: '説明なしでスタッフ全員が使い始めた', en: 'All staff started using it with no instructions' },
  },
];

// services.ts の offerings と同じ順に並べる（勤怠システム、Excel帳票の書類管理）
const offeringDetails: OfferingDetail[] = [
  {
    line: {
      ja: 'ICカードをかざすだけで打刻が済み、集計と給与計算用のデータまで自動で作る。',
      en: 'A tap of an IC card clocks staff in and out, and the tally and payroll data are built automatically.',
    },
    before: [
      { ja: '出退勤の時刻を紙に自己申告する', en: 'Staff self-report their hours on paper' },
      { ja: '月末に管理者が手で集計し、給与を手書きで計算する', en: 'At month end a manager tallies by hand and writes up payroll' },
    ],
    after: [
      { ja: '入るときと帰るときに、カードをかざすだけ', en: 'Tap a card when arriving and leaving, nothing else' },
      { ja: '集計と給与計算用のデータは、スプレッドシートに自動で並ぶ', en: 'The tally and payroll data land in a spreadsheet automatically' },
    ],
    decisions: [
      {
        title: { ja: 'スマホもボタンも使わない', en: 'No phone, no buttons' },
        body: { ja: '操作が1つ増えるたびに、打刻されない日が出る。', en: 'Every extra step means days with no clock-in.' },
      },
      {
        title: { ja: '管理画面を作らない', en: 'No new admin screen' },
        body: { ja: '集計は、管理者が見慣れたスプレッドシートに並べる。', en: 'Results go into the spreadsheet the manager already reads.' },
      },
      {
        title: { ja: '異常を推測で埋めない', en: 'No guessing over gaps' },
        body: { ja: '打刻忘れは印を付けて残し、管理者が直す。給与に推測した値を混ぜない。', en: 'Missed clock-ins are flagged for the manager to fix. Guesses never reach payroll.' },
      },
    ],
    needs: {
      ja: 'Raspberry Pi、市販のカードリーダー、1枚100円ほどのカード',
      en: 'A Raspberry Pi, an off-the-shelf card reader, and cards at about 100 yen each',
    },
  },
  {
    line: {
      ja: '契約書などの書類を、いまのExcelの様式のまま自動で作ってPDFにし、1つの一覧から探せるようにする。',
      en: 'Contracts and other documents are generated from the existing Excel templates as PDFs, and all of them can be found from one list.',
    },
    before: [
      { ja: '前の契約書をコピーし、名前や部屋番号を書き換える', en: 'Copy the last contract and rewrite names and room numbers' },
      { ja: '春の入退去の時期に、同じ作業が集中する', en: 'The same work piles up in the spring move-in season' },
      { ja: '過去の書類はフォルダを開いて探す', en: 'Finding an old document means digging through folders' },
    ],
    after: [
      { ja: 'Webのフォームに入力するか、共有フォルダのExcelを保存する', en: 'Fill in a web form, or save the Excel file in the shared folder' },
      { ja: '保存した時点でPDFができる', en: 'The PDF is ready the moment it is saved' },
      { ja: '作った書類は全文検索で探せる', en: 'Every document can be found with full-text search' },
    ],
    decisions: [
      {
        title: { ja: '共有フォルダの手順を残す', en: 'Keep the shared folder' },
        body: { ja: 'Excelを開いて保存するこれまでのやり方でも、PDFになる。', en: 'Opening and saving the Excel file, as before, still produces the PDF.' },
      },
      {
        title: { ja: '様式を作り直さない', en: 'Keep the templates' },
        body: { ja: 'いま使っている契約書のExcelに、そのまま項目を流し込む。', en: 'Fields go straight into the contract templates already in use.' },
      },
      {
        title: { ja: '業種ごとの違いを対応表に分ける', en: 'Industry details stay separate' },
        body: { ja: '様式と項目の対応表を替えれば、ほかの業種の書類にも使える。', en: 'Swap the templates and the field mapping to use it in another industry.' },
      },
    ],
    needs: {
      ja: '共有フォルダを置くサーバー（社内に置くか、借りる）',
      en: 'A server for the shared folder, on-site or rented',
    },
  },
];

// 経営者が頼み方を選ぶときに比べる観点。SaaS・開発会社の列は一般にそうなりやすい形を書く
const options: MultilingualText[] = [
  { ja: 'SaaSを導入する', en: 'Adopt a SaaS' },
  { ja: '開発会社に頼む', en: 'Hire a dev firm' },
  { ja: '私ならできること', en: 'What I can do' },
];
const compare: { point: MultilingualText; cells: MultilingualText[] }[] = [
  {
    point: { ja: '現場の操作', en: 'For your staff' },
    cells: [
      { ja: '製品の画面に合わせて、やり方を覚え直す', en: 'Relearn the work to fit the product' },
      { ja: '新しく作った画面を覚える', en: 'Learn the newly built screens' },
      { ja: '今のExcelと紙のまま。勤怠はカードをかざすだけ', en: 'Same Excel and paper; attendance is a card tap' },
    ],
  },
  {
    point: { ja: '何を作るか', en: 'What gets built' },
    cells: [
      { ja: '製品にある機能から選ぶ', en: 'Choose from the product\'s features' },
      { ja: '頼んだとおりに作る', en: 'Whatever you specify' },
      { ja: '会計の数字を一緒に見て、経費が減るところから決める', en: 'Decided together from the accounts, starting where costs drop' },
    ],
  },
  {
    point: { ja: '毎月の費用', en: 'Monthly cost' },
    cells: [
      { ja: '人数や件数に応じた利用料がかかり続ける', en: 'Fees per user or volume, every month' },
      { ja: '作り方による', en: 'Depends on how it is built' },
      { ja: '新しい月額サービスは契約しない。手元の機材と今のスプレッドシートで動く', en: 'No new subscriptions; runs on cheap hardware and your current spreadsheet' },
    ],
  },
  {
    point: { ja: '入れたあと', en: 'After launch' },
    cells: [
      { ja: '製品の変更に合わせる', en: 'You follow the product\'s changes' },
      { ja: '納品で区切りになることが多い', en: 'Often ends at delivery' },
      { ja: '使われ方を見て直し、現場で回り出すまで付き合う', en: 'I adjust it until it runs on its own' },
    ],
  },
  {
    point: { ja: '中身', en: 'What is inside' },
    cells: [
      { ja: '見えない', en: 'Hidden' },
      { ja: '契約による', en: 'Depends on the contract' },
      { ja: '仕組みを公開しているので、頼む前に確かめられる', en: 'Public, so you can check before asking' },
    ],
  },
];

const steps: Step[] = [
  {
    no: '01',
    title: { ja: '数字から、直すものを決める', en: 'Decide what to fix from the numbers' },
    why: {
      ja: '学習塾を12年、合同会社を設立から清算まで経営し、税理士を立てずに決算までやってきた。事業のお金がどこを通っているかは自分で読める。だから依頼を待たず、会計を見るところから入る。',
      en: 'I ran a tutoring school for twelve years and an LLC from founding to liquidation, closing the books without an accountant. I can read where the money in a business goes, so I start from the accounts instead of waiting for a request.',
    },
    done: {
      ja: '費用の6割が人件費だった。中身を追うと勤務時間の申告に水増しが見つかったが、自己申告と手書きの給与計算では突き合わせる手段が無い。正確な記録が先に要るので、勤怠を最初に直した。',
      en: 'Labor was 60% of costs. Tracing it turned up padded hours, but with self-reported time and handwritten payroll there was nothing to check against. Accurate records had to come first, so attendance was fixed first.',
    },
  },
  {
    no: '02',
    title: { ja: '現場のやり方を変えずに作る', en: 'Build without changing how people work' },
    why: {
      ja: '導入したときは歓迎された機能が、半年後には誰にも使われなくなる。経営の現場で、その経緯を当事者として見てきた。使われ続けるかどうかは、覚え直しを強いたかどうかで決まる。',
      en: 'I have watched, as the one in charge, features welcomed at launch go unused six months later. Whether something keeps being used comes down to whether people had to relearn their work.',
    },
    done: {
      ja: 'スタッフはPCに不慣れだったので、打刻はスマホも使わず、カードをかざすだけにした。契約書は、共有フォルダのExcelを開いて保存するこれまでの手順を残した。',
      en: 'The staff were not used to PCs, so clocking in needs no phone, only a card tap. For contracts, the routine of opening and saving the Excel file in the shared folder stayed.',
    },
  },
  {
    no: '03',
    title: { ja: '回り出すまで付き合う', en: 'Stay until it runs' },
    why: {
      ja: '新しいやり方は押し付けても使われない。納めて終わりにせず、使われ方を見て合わないところを直す。',
      en: 'A new way of working is not used just because it is handed down. Delivery is not the end: I watch how it is used and fix what does not fit.',
    },
    done: {
      ja: '最初に納めた勤怠の道具が定着して、相談が増えた。いまは外部CTOとして、契約書の作成に加えて、空室情報の配信の設計まで引き受けている。',
      en: 'Once the first attendance tool took hold, more requests followed. As external CTO I now handle contract generation and the design of a vacancy listing service.',
    },
  },
];

const fits: Fit[] = [
  { text: { ja: '数名から数十名の事業所', en: 'Offices of a few to a few dozen people' } },
  { text: { ja: 'Excelや紙の運用が回っていて、やり方は変えたくない', en: 'Excel and paper already work, and the routine should stay' } },
  { text: { ja: 'SaaSを入れたが、使われずに元のやり方に戻った', en: 'A SaaS was tried, and everyone went back to the old way' } },
  { text: { ja: '管理者が転記と集計に毎月何時間も使っている', en: 'Managers spend hours every month copying and tallying' } },
];

const misfits: Fit[] = [
  {
    text: { ja: '数十名を超える規模', en: 'More than a few dozen people' },
    reason: { ja: '集計の仕組みを別に用意する必要がある', en: 'the tally needs a different backend' },
  },
  {
    text: { ja: '厳密な本人確認が要る打刻', en: 'Clock-ins that need strict identity checks' },
    reason: { ja: 'カードの貸し借りは仕組みでは防げない', en: 'lending a card cannot be prevented' },
  },
  {
    text: { ja: '業務のやり方ごと作り替えたい', en: 'Redesigning how the work itself is done' },
    reason: { ja: '今のやり方を残すことを前提に作る', en: 'it is built to keep the current routine' },
  },
];

const zenn = {
  title: 'Raspberry Pi 2 と GAS で事務所の勤怠を NFC カード1枚に集約する',
  href: 'https://zenn.dev/yktsnet/articles/202604-nfc-attendance-raspberry-pi-2',
};

const h2 = 'text-xl font-semibold leading-relaxed tracking-tight text-zinc-900 sm:text-2xl dark:text-poi-focus';
const card = 'rounded-xl border border-zinc-200 bg-white dark:border-poi-border/70 dark:bg-poi-panel/15';
const label = 'font-mono text-[10px] tracking-widest uppercase text-poi-muted';
---

<MainLayout title={s.title.en} description={`${s.title.ja}。${s.summary.ja}`} wide>
  {/* 1. サービス名と説明（トップのカードと同じ文） */}
  <section>
    <a href="/#services" class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 transition-colors hover:text-poi-accent dark:text-poi-muted">
      <span aria-hidden="true">←</span> Services
    </a>
    <p class="mt-10 flex items-center gap-2 font-mono text-xs tracking-widest text-poi-accent">
      <LucideIcon name={s.icon} />{s.no}
    </p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-zinc-900 sm:text-[32px] dark:text-poi-focus">
      <T text={s.title} />
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-8 text-zinc-700 dark:text-poi-text"><T text={s.summary} /></p>
  </section>

  {/* 2. 導入の結果: 数字、事例の背景、経緯を書いた記事 */}
  <section class="mt-16">
    <h2 class={h2}><T text={{ ja: '導入例：マンション管理会社', en: 'Example: a property management company' }} /></h2>
    <div class:list={[card, 'mt-6']}>
      <dl class="grid divide-y divide-zinc-200 md:grid-cols-3 md:divide-x md:divide-y-0 dark:divide-poi-border/60">
        {metrics.map((m) => (
          <div class="p-7 sm:p-8">
            <dt class="whitespace-nowrap font-mono text-4xl font-medium text-poi-accent">
              <T text={m.value} /><span class="ml-1.5 text-sm"><T text={m.unit} /></span>
            </dt>
            <dd class="mt-3 text-[13px] leading-6 text-zinc-600 dark:text-poi-muted"><T text={m.label} /></dd>
          </div>
        ))}
      </dl>
      <div class="border-t border-zinc-200 bg-zinc-100/60 p-7 sm:px-8 dark:border-poi-border/60 dark:bg-poi-panel/35">
        <p class="max-w-3xl text-sm leading-7 text-zinc-700 dark:text-poi-text">
          <T text={{
            ja: '高齢のオーナーは引退を見据えて現場を離れたがっていたが、経営の実務が特定の人に頼ったままで、離れられなかった。そこに外部から入り、勤怠と書類作成を自動にした。いまも外部CTOとして関わっている。',
            en: 'The aging owner wanted to step back ahead of retirement, but day-to-day management depended on specific people. I came in from outside and automated attendance and paperwork, and I am still involved as external CTO.',
          }} />
        </p>
        <p class="mt-3 max-w-3xl text-[13px] leading-7 text-zinc-600 dark:text-poi-muted">
          <T text={{
            ja: '自動化とは別に、法人化の手続きも支援している。経営の実務を自分でやってきたので、こうした相談も受けられる。',
            en: 'Apart from automation, I am also guiding the company through incorporation. Having run the books myself, I can take on requests like this too.',
          }} />
        </p>
        <div class="mt-4">
          <RepoLink label={`Zenn — ${zenn.title}`} href={zenn.href} icon="file-text" />
        </div>
      </div>
    </div>
  </section>

  {/* 3. 提供できること */}
  <section class="mt-20">
    <h2 class={h2}><T text={{ ja: '提供できること', en: 'What I offer' }} /></h2>
    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      {s.offerings.map((o, idx) => {
        const d = offeringDetails[idx];
        return (
          <article class:list={[card, 'flex flex-col p-7 sm:p-8']}>
            <h3 class="flex items-center gap-2.5 text-lg font-semibold text-zinc-900 dark:text-poi-focus">
              <LucideIcon name={o.icon} class="h-5 w-5 text-poi-accent" />
              <T text={o.title} />
            </h3>
            <p class="mt-3 text-sm leading-7 text-zinc-600 dark:text-poi-muted"><T text={d.line} /></p>

            <div class="mt-6 grid gap-5 border-t border-zinc-200 pt-6 sm:grid-cols-2 dark:border-poi-border/60">
              <div>
                <p class="text-xs font-semibold text-zinc-500 dark:text-poi-muted"><T text={{ ja: 'これまで', en: 'Before' }} /></p>
                <ul class="mt-2 space-y-1.5">
                  {d.before.map((b) => (
                    <li class="flex gap-2 text-[13px] leading-6 text-zinc-500 dark:text-poi-muted"><span aria-hidden="true">·</span><T text={b} /></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-poi-accent"><T text={{ ja: '導入後', en: 'After' }} /></p>
                <ul class="mt-2 space-y-1.5">
                  {d.after.map((a) => (
                    <li class="flex gap-2 text-[13px] leading-6 text-zinc-900 dark:text-poi-focus"><span class="text-poi-accent" aria-hidden="true">·</span><T text={a} /></li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6 border-t border-zinc-200 pt-6 dark:border-poi-border/60">
              <p class={label}><T text={{ ja: '作り方の工夫', en: 'How it is built' }} /></p>
              <ul class="mt-3 space-y-3">
                {d.decisions.map((dc) => (
                  <li class="text-[13px] leading-6">
                    <span class="font-semibold text-zinc-900 dark:text-poi-focus"><T text={dc.title} /></span>
                    <span class="block text-zinc-600 dark:text-poi-muted"><T text={dc.body} /></span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-auto pt-6">
              <p class="border-t border-zinc-200 pt-5 text-xs leading-6 text-zinc-600 dark:border-poi-border/60 dark:text-poi-muted">
                <span class="font-semibold text-zinc-800 dark:text-poi-text"><T text={{ ja: '必要なもの：', en: 'Needs: ' }} /></span>
                <T text={d.needs} />
              </p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                {o.repos.map((r) => <RepoLink label={r.name} href={r.href} />)}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  {/* 3b. ほかの頼み方との違い: 経営者が SaaS や開発会社と比べて選べるようにする */}
  <section class="mt-20">
    <h2 class={h2}><T text={{ ja: 'SaaS・開発会社との違い', en: 'Compared with SaaS and dev firms' }} /></h2>
    <div class:list={[card, 'mt-6 overflow-hidden']}>
      <div class="hidden border-b border-zinc-200 bg-zinc-100/60 md:grid md:grid-cols-[9rem_1fr_1fr_1.3fr] dark:border-poi-border/60 dark:bg-poi-panel/35">
        <span></span>
        {options.map((o, i) => (
          <p class:list={['px-5 py-3.5 text-xs font-semibold', i === 2 ? 'text-poi-accent' : 'text-zinc-500 dark:text-poi-muted']}><T text={o} /></p>
        ))}
      </div>
      <div class="divide-y divide-zinc-200 dark:divide-poi-border/60">
        {compare.map((row) => (
          <div class="grid md:grid-cols-[9rem_1fr_1fr_1.3fr]">
            <p class="px-5 pt-4 text-[13px] font-semibold text-zinc-900 md:py-4 dark:text-poi-focus"><T text={row.point} /></p>
            {row.cells.map((c, i) => (
              <p class:list={[
                'px-5 py-1.5 text-[13px] leading-6 md:py-4',
                i === 2 ? 'pb-4 text-zinc-900 md:bg-poi-accent/5 dark:text-poi-focus' : 'text-zinc-500 dark:text-poi-muted',
              ]}>
                <span class:list={['mr-2 text-[11px] md:hidden', i === 2 ? 'text-poi-accent' : '']}><T text={options[i]} /></span>
                <T text={c} />
              </p>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. 進め方: なぜそうするかと、導入事例で実際にどうしたか */}
  <section class="mt-20">
    <h2 class={h2}><T text={{ ja: '進め方', en: 'How I work' }} /></h2>
    <ol class="mt-6 divide-y divide-zinc-200 border-y border-zinc-200 dark:divide-poi-border/60 dark:border-poi-border/60">
      {steps.map((st) => (
        <li class="grid gap-4 py-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-10">
          <div>
            <p class="font-mono text-2xl font-medium text-poi-accent">{st.no}</p>
            <h3 class="mt-2 text-base font-semibold leading-relaxed text-zinc-900 dark:text-poi-focus"><T text={st.title} /></h3>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <p class={label}><T text={{ ja: 'なぜ', en: 'Why' }} /></p>
              <p class="mt-2 text-[13px] leading-7 text-zinc-800 dark:text-poi-text"><T text={st.why} /></p>
            </div>
            <div>
              <p class={label}><T text={{ ja: 'マンション管理会社では', en: 'At the property management company' }} /></p>
              <p class="mt-2 text-[13px] leading-7 text-zinc-600 dark:text-poi-muted"><T text={st.done} /></p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  {/* 5. 合う現場・合わない現場 */}
  <section class="mt-20">
    <h2 class={h2}><T text={{ ja: '合う現場・合わない現場', en: 'Where it fits' }} /></h2>
    <div class:list={[card, 'mt-6 grid gap-8 p-7 sm:p-8 md:grid-cols-2']}>
      <div>
        <p class="text-sm font-semibold text-poi-accent"><T text={{ ja: '合う現場', en: 'Fits' }} /></p>
        <ul class="mt-3 space-y-2">
          {fits.map((f) => (
            <li class="flex gap-2.5 text-[13px] leading-6 text-zinc-700 dark:text-poi-text">
              <LucideIcon name="check" class="mt-1 h-3.5 w-3.5 shrink-0 text-poi-accent" /><T text={f.text} />
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-zinc-500 dark:text-poi-muted"><T text={{ ja: '合わない現場', en: 'Does not fit' }} /></p>
        <ul class="mt-3 space-y-2">
          {misfits.map((m) => (
            <li class="flex gap-2.5 text-[13px] leading-6 text-zinc-600 dark:text-poi-muted">
              <LucideIcon name="x" class="mt-1 h-3.5 w-3.5 shrink-0 text-zinc-400 dark:text-poi-muted" />
              <span>
                <T text={m.text} />
                {m.reason && <span class="text-zinc-500 dark:text-poi-muted">（<T text={m.reason} />）</span>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 6. ほかのサービス */}
  <section class="mt-20 border-t border-zinc-200 pt-8 dark:border-poi-border/60">
    <h2 class="text-sm font-semibold text-zinc-500 dark:text-poi-muted"><T text={{ ja: 'ほかのサービス', en: 'Other services' }} /></h2>
    <ul class="mt-4 flex flex-col gap-3 sm:flex-row sm:gap-10">
      {others.map((o) => (
        <li>
          <a href={`/services/${o.slug}/`} class="group inline-flex items-center gap-2 text-[15px] font-semibold text-zinc-900 transition-colors hover:text-poi-accent dark:text-poi-focus">
            <span class="font-mono text-xs text-poi-accent">{o.no}</span>
            <T text={o.title} />
            <LucideIcon name="arrow-right" class="h-4 w-4 text-poi-accent transition-transform group-hover:translate-x-0.5" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</MainLayout>
